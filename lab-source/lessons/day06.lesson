    t.expect(!(list.length === 0 && /reading/.test(e.message)), `\`${label}\` crashed: ${e.message.replace(/\.$/, "")}. An empty list has no shows. At the start of the function, add \`if (list.length === 0) { return ""; }\`.`);
    t.fail(`\`${label}\` crashed: ${e.message.replace(/\.$/, "")}.`);
  }
};
const shows = JSON.parse(JSON.stringify(t.get("shows")));
let r = call("lowestRated(shows)", shows);
t.expect(r !== undefined, "`lowestRated(shows)` gives back `undefined`. After the loop's closing `}`, add `return best.name;`.");
t.expect(!(r && typeof r === "object"), "`lowestRated(shows)` gives back a whole show. Return only its name: `best.name`.");
t.expect(typeof r === "string", `\`lowestRated(shows)\` gives ${JSON.stringify(r)}. Return the name of the show.`);
