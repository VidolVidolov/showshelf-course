=== step p-watchlist
title: A watchlist from ids (harder)
minutes: 12
slot: gym
template: gym
refs: data.js
practice: yes
--- explain
Apps often save only the **ids** of your favourite shows, like `[7, 1]`, and look up the rest when they need it. This time, loop through the **ids**, not the shows, and use `find` for each one:

```js
const basket = [];
for (const wanted of wantedNames) {
  const snack = snackList.find((item) => item.name === wanted);
  if (snack !== undefined) {
    basket.push(snack.price);
  }
}
```

Looping through the ids keeps them in **their** order: `[7, 1]` gives Chernobyl first, then Friends. An id that no show has is skipped, thanks to the `if`.
--- task
Make `watchlist(list, ids)` return the **names** of the shows whose ids are in `ids`, in the order of `ids`. Skip ids that no show has.
--- hint
`const names = [];`, then `for (const id of ids)`. Inside: `find` the show with `show.id === id`; if it isn't `undefined`, push its name. Return `names` after the loop.
--- hint
```js
function watchlist(list, ids) {
  const names = [];
  for (const id of ids) {
    const found = list.find((show) => show.id === id);
    if (found !== undefined) {
      names.push(found.name);
    }
  }
  return names;
}
```
--- starter
// P28. A watchlist from ids
// watchlist(list, ids) gives back the NAMES of the shows with those ids,
// in the order of ids. Ids that no show has are skipped.

function watchlist(list, ids) {
  // your code here
}

tryIt(watchlist, [shows, [7, 1]], ["Chernobyl", "Friends"]);
tryIt(watchlist, [shows, [2, 99, 4]], ["Breaking Bad", "Game of Thrones"]);
tryIt(watchlist, [shows, []], []);
--- solution
// P28. A watchlist from ids
// watchlist(list, ids) gives back the NAMES of the shows with those ids,
// in the order of ids. Ids that no show has are skipped.

function watchlist(list, ids) {
  const names = [];
  for (const id of ids) {
    const found = list.find((show) => show.id === id);
    if (found !== undefined) {
      names.push(found.name);
    }
  }
  return names;
}

tryIt(watchlist, [shows, [7, 1]], ["Chernobyl", "Friends"]);
tryIt(watchlist, [shows, [2, 99, 4]], ["Breaking Bad", "Game of Thrones"]);
tryIt(watchlist, [shows, []], []);
--- learned
A loop through one list, a `find` in another, an `if` and a `push`: that's how My List will turn saved ids into shows.
--- summary
Practice: loop through ids, `find` each show, push it if found.
--- mistakes
- Looping through `list` instead of `ids`: the names come in the wrong order.
- No `if`: id 99 crashes with "Cannot read properties of undefined".
- `show.id === ids` (the whole list) instead of `show.id === id`.
--- check
t.expect(!t.errors.length, `There's an error in the Console: "${t.errors[0]}". Read the help under it, fix that line, then check again.`);
const f = t.get("watchlist");
t.expect(f !== undefined, "I can't find a function called `watchlist`. Press **Start again** to get the starting code back.");
t.expect(typeof f === "function" && f.length === 2, "`watchlist` needs two parameters: `function watchlist(list, ids) {`.");
const call = (label, ...args) => {
  try { return f(...args); } catch (e) {
    t.expect(!/reading 'name'/.test(e.message), `\`${label}\` crashed: no show has one of the ids, so \`find\` gave \`undefined\`. Push only when \`found !== undefined\`.`);
    t.fail(`\`${label}\` crashed: ${e.message.replace(/\.$/, "")}.`);
  }
};
const fmt = (r) => (Array.isArray(r) ? `[${r.map((s) => (s && typeof s === "object" ? s.name : s)).join(", ")}]` : JSON.stringify(r));
const shows = JSON.parse(JSON.stringify(t.get("shows")));
let r = call("watchlist(shows, [7, 1])", shows, [7, 1]);
t.expect(r !== undefined, "`watchlist(shows, [7, 1])` gives back `undefined`. After the loop's closing `}`, add `return names;`.");
t.expect(Array.isArray(r), `\`watchlist(shows, [7, 1])\` gives back ${JSON.stringify(r)}, not a list.`);
t.expect(!r.some((s) => s && typeof s === "object"), "`watchlist` gives back whole shows. Push only the name: `names.push(found.name);`.");
t.expect(r.length, "`watchlist(shows, [7, 1])` gives an empty list. For each `id` in `ids`, find the show with `show.id === id`, and push its name.");
t.expect(fmt(r) !== "[Friends, Chernobyl]", "`watchlist(shows, [7, 1])` gives [Friends, Chernobyl]: the order of data.js. Keep the order of `ids`: loop through `ids` (`for (const id of ids)`), and `find` each show.");
t.expect(fmt(r) === "[Chernobyl, Friends]", `\`watchlist(shows, [7, 1])\` gives ${fmt(r)}. It should give [Chernobyl, Friends]: id 7, then id 1.`);
r = call("watchlist(shows, [2, 99, 4])", shows, [2, 99, 4]);
t.expect(fmt(r) === "[Breaking Bad, Game of Thrones]", `\`watchlist(shows, [2, 99, 4])\` gives ${fmt(r)}. It should give [Breaking Bad, Game of Thrones]: no show has id 99, so skip it.`);
r = call("watchlist(shows, [])", shows, []);
t.expect(Array.isArray(r) && r.length === 0, `\`watchlist(shows, [])\` gives ${fmt(r)}. No ids means an empty list \`[]\`.`);
r = call("watchlist(another list, [20, 10])", [{ id: 10, name: "Show A" }, { id: 20, name: "Show B" }], [20, 10]);
t.expect(fmt(r) === "[Show B, Show A]", `With another list, \`watchlist\` gives ${fmt(r)}. It should give [Show B, Show A]. Search the parameter \`list\`, not \`shows\`.`);
r = call("watchlist([], [1])", [], [1]);
t.expect(Array.isArray(r) && r.length === 0, `\`watchlist([], [1])\` gives ${fmt(r)}. An empty list has no shows, so it should give \`[]\`.`);


=== step p-all-genres
title: Every genre once (harder)
minutes: 12
slot: gym
template: gym
refs: data.js
practice: yes
--- explain
P13 collected each network once. Genres are harder: every show has a **list** of genres. So you need a loop **inside** a loop: one through the shows, and inside it, one through that show's `genres`.

```js
const allTags = [];
for (const snack of snackList) {
  for (const tag of snack.tags) {
    if (allTags.includes(tag) === false) {
      allTags.push(tag);
    }
  }
}
```

The inner loop runs completely for every round of the outer loop. Indent each level by two more spaces so you can see where each block ends.
--- task
Make `allGenres(list)` return every genre of the shows in `list`, each only once, in the order they first appear.
--- hint
`const genres = [];`. Loop through the shows; inside, `for (const genre of show.genres)`. If `genres.includes(genre) === false`, push it. Return `genres` after both loops.
--- hint
```js
function allGenres(list) {
  const genres = [];
  for (const show of list) {
    for (const genre of show.genres) {
      if (genres.includes(genre) === false) {
        genres.push(genre);
      }
    }
  }
  return genres;
}
```
--- starter
// P29. Every genre once
// allGenres(list) gives back every genre of the shows, without duplicates,
// in the order they first appear.

function allGenres(list) {
  // your code here
}

const mini = [
  { name: "Friends", genres: ["Comedy", "Romance"] },
  { name: "Fleabag", genres: ["Comedy", "Drama"] },
];
const none = [];

tryIt(allGenres, [mini], ["Comedy", "Romance", "Drama"]);
tryIt(allGenres, [none], []);
--- solution
// P29. Every genre once
// allGenres(list) gives back every genre of the shows, without duplicates,
// in the order they first appear.

function allGenres(list) {
  const genres = [];
  for (const show of list) {
    for (const genre of show.genres) {
      if (genres.includes(genre) === false) {
        genres.push(genre);
      }
    }
  }
  return genres;
}

const mini = [
  { name: "Friends", genres: ["Comedy", "Romance"] },
  { name: "Fleabag", genres: ["Comedy", "Drama"] },
];
const none = [];

tryIt(allGenres, [mini], ["Comedy", "Romance", "Drama"]);
tryIt(allGenres, [none], []);
--- learned
A loop inside a loop reaches every genre of every show. The twelve shows cover twelve different genres.
--- summary
Practice: a loop inside a loop: `for (const genre of show.genres)` inside `for (const show of list)`.
--- mistakes
- Pushing `show.genres` (a whole array) instead of each `genre`.
- The `includes` test missing, so Comedy and Drama appear many times.
- `return` between the two closing `}` (after the first show only).
--- check
t.expect(!t.errors.length, `There's an error in the Console: "${t.errors[0]}". Read the help under it, fix that line, then check again.`);
const f = t.get("allGenres");
t.expect(f !== undefined, "I can't find a function called `allGenres`. Press **Start again** to get the starting code back.");
t.expect(typeof f === "function", "`allGenres` should be a function.");
const call = (label, list) => {
  try { return f(list); } catch (e) {
    t.expect(!/is not defined/.test(e.message), `\`${label}\` crashed: ${e.message.replace(/\.$/, "")}. Create the new list before the loops, so it still exists after them.`);
    t.fail(`\`${label}\` crashed: ${e.message.replace(/\.$/, "")}.`);
  }
};
const sorted = (r) => (Array.isArray(r) ? [...r].map(String).sort().join("|") : "");
const shows = JSON.parse(JSON.stringify(t.get("shows")));
const want = [];
for (const s of shows) for (const g of s.genres) if (!want.includes(g)) want.push(g);
let r = call("allGenres(shows)", shows);
t.expect(r !== undefined, "`allGenres(shows)` gives back `undefined`. After both loops, add `return genres;`.");
t.expect(Array.isArray(r), `\`allGenres(shows)\` gives back ${JSON.stringify(r)}, not a list.`);
t.expect(!r.some((g) => Array.isArray(g)), "`allGenres` gives back a list of lists. Push each genre on its own: a second loop, `for (const genre of show.genres)`, inside the first.");
t.expect(r.every((g) => typeof g === "string"), "Each item should be one genre (text), not a whole show.");
t.expect(r.length <= want.length, `\`allGenres(shows)\` gives ${r.length} genres, with duplicates. Before you push, check your new list: \`if (genres.includes(genre) === false)\`.`);
t.expect(r.length > 2, `\`allGenres(shows)\` gives only ${JSON.stringify(r)}. Loop through every show, and put \`return\` after both loops' closing \`}\`.`);
t.expect(sorted(r) === sorted(want), `\`allGenres(shows)\` gives ${JSON.stringify(r)}. It should give the ${want.length} genres once each: ${want.join(", ")}.`);
r = call("allGenres(another list)", [{ name: "Show A", genres: ["Drama", "War"] }, { name: "Show B", genres: ["War"] }]);
t.expect(sorted(r) === "Drama|War", `With another list, \`allGenres\` gives ${JSON.stringify(r)}. It should give ["Drama", "War"]. Loop through the parameter \`list\`, not \`shows\`.`);
r = call("allGenres([])", []);
t.expect(Array.isArray(r) && r.length === 0, `\`allGenres([])\` gives ${JSON.stringify(r)}. It should give an empty list \`[]\`.`);


=== step p-best-in-genre
title: The best in a genre (harder)
minutes: 12
slot: gym
template: gym
refs: data.js
practice: yes
--- explain
Two tools you know, one after the other:

1. `filter` keeps only the shows of the genre (like step 10).
2. "Best so far" finds the highest rating among **those** shows (like P14).

```js
const salty = snackList.filter((snack) => snack.tags.includes("salty"));
let best = salty[0];
// ... then the usual loop, through salty
```

If no show has the genre, the filtered list is empty. Check for that before you start, and return `""`.
--- task
Make `bestInGenre(list, genre)` return the **name** of the highest-rated show in `list` with that genre. If no show has it, return `""`.
--- hint
`const inGenre = list.filter((show) => show.genres.includes(genre));`. If `inGenre.length === 0`, return `""`. Then best so far through `inGenre` with `show.rating > best.rating`, and `return best.name;`.
--- hint
```js
function bestInGenre(list, genre) {
  const inGenre = list.filter((show) => show.genres.includes(genre));
  if (inGenre.length === 0) {
    return "";
  }
  let best = inGenre[0];
  for (const show of inGenre) {
    if (show.rating > best.rating) {
      best = show;
    }
  }
  return best.name;
}
```
--- starter
// P30. The best show in a genre
// bestInGenre(list, genre) gives back the NAME of the highest-rated show
// with that genre, or "" if no show has it.

function bestInGenre(list, genre) {
  // your code here
}

const mini = [
  { name: "Dark", rating: 8.7, genres: ["Drama", "Mystery"] },
  { name: "Fleabag", rating: 8.4, genres: ["Comedy", "Drama"] },
  { name: "Friends", rating: 8.8, genres: ["Comedy", "Romance"] },
];

tryIt(bestInGenre, [mini, "Comedy"], "Friends");
tryIt(bestInGenre, [mini, "Drama"], "Dark");
tryIt(bestInGenre, [mini, "Western"], "");
tryIt(bestInGenre, [shows, "Fantasy"], "Avatar: The Last Airbender");
--- solution
// P30. The best show in a genre
// bestInGenre(list, genre) gives back the NAME of the highest-rated show
// with that genre, or "" if no show has it.

function bestInGenre(list, genre) {
  const inGenre = list.filter((show) => show.genres.includes(genre));
  if (inGenre.length === 0) {
    return "";
  }
  let best = inGenre[0];
  for (const show of inGenre) {
    if (show.rating > best.rating) {
      best = show;
    }
  }
  return best.name;
}

const mini = [
  { name: "Dark", rating: 8.7, genres: ["Drama", "Mystery"] },
  { name: "Fleabag", rating: 8.4, genres: ["Comedy", "Drama"] },
  { name: "Friends", rating: 8.8, genres: ["Comedy", "Romance"] },
];

tryIt(bestInGenre, [mini, "Comedy"], "Friends");
tryIt(bestInGenre, [mini, "Drama"], "Dark");
tryIt(bestInGenre, [mini, "Western"], "");
tryIt(bestInGenre, [shows, "Fantasy"], "Avatar: The Last Airbender");
--- learned
Filter first, then find the best among what's left: two small steps make a real feature, "the best comedy".
--- summary
Practice: `filter` to narrow the list, then "best so far" on the result.
--- mistakes
- Looping through `list` instead of the filtered list: the best show of any genre.
- No check for an empty result: a crash for Western.
- `show.genres === genre` instead of `show.genres.includes(genre)`.
--- check
t.expect(!t.errors.length, `There's an error in the Console: "${t.errors[0]}". Read the help under it, fix that line, then check again.`);
const f = t.get("bestInGenre");
t.expect(f !== undefined, "I can't find a function called `bestInGenre`. Press **Start again** to get the starting code back.");
t.expect(typeof f === "function" && f.length === 2, "`bestInGenre` needs two parameters: `function bestInGenre(list, genre) {`.");
const call = (label, ...args) => {
  try { return f(...args); } catch (e) {
    t.expect(!/constant/.test(e.message), `\`${label}\` crashed: ${e.message.replace(/\.$/, "")}. \`best\` changes, so create it with \`let\`, not \`const\`.`);
    t.expect(!/reading '(name|rating)'/.test(e.message), `\`${label}\` crashed: ${e.message.replace(/\.$/, "")}. When no show has the genre, the filtered list is empty. Check for that first: \`if (inGenre.length === 0) { return ""; }\`.`);
    t.fail(`\`${label}\` crashed: ${e.message.replace(/\.$/, "")}.`);
  }
};
const shows = JSON.parse(JSON.stringify(t.get("shows")));
let r = call('bestInGenre(shows, "Comedy")', shows, "Comedy");
t.expect(r !== undefined, "`bestInGenre(shows, \"Comedy\")` gives back `undefined`. After the loop, add `return best.name;`.");
t.expect(!(r && typeof r === "object"), "`bestInGenre` gives back a whole show. Return only its name: `best.name`.");
t.expect(typeof r === "string", `\`bestInGenre(shows, "Comedy")\` gives ${JSON.stringify(r)}. Return the name of the show.`);
t.expect(r !== "Breaking Bad", "`bestInGenre(shows, \"Comedy\")` gives Breaking Bad, which isn't a comedy. Loop through the filtered list (`inGenre`), not through `list`.");
t.expect(r === "Friends", `\`bestInGenre(shows, "Comedy")\` gives "${r}". It should give "Friends", the highest-rated comedy (8.8).`);
for (const [g, want] of [["Fantasy", "Avatar: The Last Airbender"], ["History", "Chernobyl"], ["Crime", "Breaking Bad"]]) {
  r = call(`bestInGenre(shows, "${g}")`, shows, g);
  t.expect(r === want, `\`bestInGenre(shows, "${g}")\` gives ${JSON.stringify(r)}. It should give "${want}". Use the parameter \`genre\` in the filter, and compare \`show.rating > best.rating\`.`);
}
r = call('bestInGenre(shows, "Western")', shows, "Western");
t.expect(r === "", `\`bestInGenre(shows, "Western")\` gives ${JSON.stringify(r)}. No show is a Western, so it should give an empty string \`""\`.`);
r = call('bestInGenre(another list, "Drama")', [{ name: "Show A", rating: 7, genres: ["Drama"] }, { name: "Show B", rating: 9, genres: ["Comedy"] }, { name: "Show C", rating: 8, genres: ["Drama"] }], "Drama");
t.expect(r === "Show C", `With another list, \`bestInGenre(..., "Drama")\` gives ${JSON.stringify(r)}. It should give "Show C". Filter the parameter \`list\`, not \`shows\`.`);
r = call('bestInGenre([], "Drama")', [], "Drama");
t.expect(r === "", `\`bestInGenre([], "Drama")\` gives ${JSON.stringify(r)}. An empty list should give \`""\`.`);


=== step p-rating-bands
title: Rating bands (harder)
minutes: 12
slot: gym
template: gym
refs: data.js
practice: yes
--- explain
An object can hold several counters at once. When you know the keys in advance, create them all at 0 before the loop. Then an `if / else if / else` (Day 5) decides which counter goes up:

```js
const sizes = { small: 0, large: 0 };
for (const snack of snackList) {
  if (snack.grams < 100) {
    sizes.small = sizes.small + 1;
  } else {
    sizes.large = sizes.large + 1;
  }
}
```

Remember from Day 5: the strictest test goes first, because 9.2 is also `>= 8`.
--- task
Make `ratingBands(list)` return an object `{ mustWatch: ..., good: ..., ok: ... }` that counts the shows rated **9 or more** (`mustWatch`), **8 or more** but under 9 (`good`), and **under 8** (`ok`). An empty list gives all three at 0.
--- hint
`const bands = { mustWatch: 0, good: 0, ok: 0 };`. In the loop: `if (show.rating >= 9)` add 1 to `bands.mustWatch`, `else if (show.rating >= 8)` to `bands.good`, `else` to `bands.ok`. Return `bands`.
--- hint
```js
function ratingBands(list) {
  const bands = { mustWatch: 0, good: 0, ok: 0 };
  for (const show of list) {
    if (show.rating >= 9) {
      bands.mustWatch = bands.mustWatch + 1;
    } else if (show.rating >= 8) {
      bands.good = bands.good + 1;
    } else {
      bands.ok = bands.ok + 1;
    }
  }
  return bands;
}
```
--- starter
// P31. Rating bands
// ratingBands(list) counts the shows in three bands and gives back
// { mustWatch: ..., good: ..., ok: ... }:
// mustWatch = rated 9 or more, good = 8 or more, ok = under 8.

function ratingBands(list) {
  // your code here
}

const mini = [
  { name: "Chernobyl", rating: 9.1 },
  { name: "Dark", rating: 8.7 },
  { name: "Fleabag", rating: 8.4 },
];
const none = [];

tryIt(ratingBands, [mini], { mustWatch: 1, good: 2, ok: 0 });
tryIt(ratingBands, [none], { mustWatch: 0, good: 0, ok: 0 });
tryIt(ratingBands, [shows], { mustWatch: 5, good: 7, ok: 0 });
--- solution
// P31. Rating bands
// ratingBands(list) counts the shows in three bands and gives back
// { mustWatch: ..., good: ..., ok: ... }:
// mustWatch = rated 9 or more, good = 8 or more, ok = under 8.

function ratingBands(list) {
  const bands = { mustWatch: 0, good: 0, ok: 0 };
  for (const show of list) {
    if (show.rating >= 9) {
      bands.mustWatch = bands.mustWatch + 1;
    } else if (show.rating >= 8) {
      bands.good = bands.good + 1;
    } else {
      bands.ok = bands.ok + 1;
    }
  }
  return bands;
}

const mini = [
  { name: "Chernobyl", rating: 9.1 },
  { name: "Dark", rating: 8.7 },
  { name: "Fleabag", rating: 8.4 },
];
const none = [];

tryIt(ratingBands, [mini], { mustWatch: 1, good: 2, ok: 0 });
tryIt(ratingBands, [none], { mustWatch: 0, good: 0, ok: 0 });
tryIt(ratingBands, [shows], { mustWatch: 5, good: 7, ok: 0 });
--- learned
An object of counters, a loop and Day 5's `if / else if / else`: three ideas in one small function. Five shows are a must-watch.
--- summary
Practice: counters in one object: `{ a: 0, b: 0 }`, then `obj.a = obj.a + 1` in the right branch.
--- mistakes
- `>= 8` tested before `>= 9`: every show lands in `good`.
- `>` instead of `>=`: shows rated exactly 9.0 count as good.
- Creating the object inside the loop.
--- check
t.expect(!t.errors.length, `There's an error in the Console: "${t.errors[0]}". Read the help under it, fix that line, then check again.`);
const f = t.get("ratingBands");
t.expect(f !== undefined, "I can't find a function called `ratingBands`. Press **Start again** to get the starting code back.");
t.expect(typeof f === "function", "`ratingBands` should be a function.");
const call = (label, list) => {
  try { return f(list); } catch (e) {
    t.expect(!/is not defined/.test(e.message), `\`${label}\` crashed: ${e.message.replace(/\.$/, "")}. Create the \`bands\` object before the loop, so it still exists after the loop.`);
    t.fail(`\`${label}\` crashed: ${e.message.replace(/\.$/, "")}.`);
  }
};
const show = (o) => JSON.stringify(o, (k, v) => (typeof v === "number" && Number.isNaN(v) ? "NaN" : v));
const same = (got, a, b, c) => got && typeof got === "object" && !Array.isArray(got) && Object.keys(got).length === 3 && got.mustWatch === a && got.good === b && got.ok === c;
const shows = JSON.parse(JSON.stringify(t.get("shows")));
const r = call("ratingBands(shows)", shows);
t.expect(r !== undefined, "`ratingBands(shows)` gives back `undefined`. After the loop's closing `}`, add `return bands;`.");
t.expect(r && typeof r === "object" && !Array.isArray(r), `\`ratingBands(shows)\` gives ${show(r)}. Return an object: \`{ mustWatch: ..., good: ..., ok: ... }\`.`);
t.expect(!Object.values(r).some((v) => Number.isNaN(v)), "Some of your counts are `NaN` (*not a number*): `undefined + 1`. Create every counter at 0 before the loop: `{ mustWatch: 0, good: 0, ok: 0 }`.");
t.expect(["mustWatch", "good", "ok"].every((k) => k in r), `\`ratingBands(shows)\` gives ${show(r)}. The object needs exactly these keys, spelled like this: \`mustWatch\`, \`good\` and \`ok\`. Create them all at 0 before the loop.`);
t.expect(!(r.mustWatch === 0 && r.good === 12), "`ratingBands(shows)` puts all 12 shows in `good`. Test `>= 9` first: a show rated 9.2 is also `>= 8`, and the first true test wins.");
t.expect(!(r.mustWatch === 3 && r.good === 9), "`ratingBands(shows)` counts only 3 must-watch shows. The Wire and Avatar are rated exactly 9.0: use `>=`, not `>`.");
t.expect(r.mustWatch + r.good + r.ok === 12, `\`ratingBands(shows)\` gives ${show(r)}: the counts don't add up to 12. Add 1 to exactly one counter for every show, and create the object before the loop.`);
t.expect(same(r, 5, 7, 0), `\`ratingBands(shows)\` gives ${show(r)}. It should give {"mustWatch":5,"good":7,"ok":0}.`);
const r2 = call("ratingBands([9.5, 7, 8, 6])", [{ name: "Show A", rating: 9.5 }, { name: "Show B", rating: 7 }, { name: "Show C", rating: 8 }, { name: "Show D", rating: 6 }]);
t.expect(same(r2, 1, 1, 2), `With ratings 9.5, 7, 8 and 6, \`ratingBands\` gives ${show(r2)}. It should give {"mustWatch":1,"good":1,"ok":2}. Loop through the parameter \`list\`, and add to \`ok\` in the final \`else\`.`);
const r3 = call("ratingBands([])", []);
t.expect(same(r3, 0, 0, 0), `\`ratingBands([])\` gives ${show(r3)}. An empty list should give {"mustWatch":0,"good":0,"ok":0}.`);


=== step p-by-network
title: Names per network (harder)
minutes: 15
slot: gym
template: gym
refs: data.js
practice: yes
--- explain
In P16 each network's value was a number. A value can also be an **array**, so one object can group names:

```js
{ HBO: ["Chernobyl", "The Wire"], Netflix: ["Dark"] }
```

The pattern is the same as counting, with an array instead of a number:

```js
const byColour = {};
for (const snack of snackList) {
  if (byColour[snack.colour] === undefined) {
    byColour[snack.colour] = [];          // first time: an empty list
  }
  byColour[snack.colour].push(snack.name); // every time: add the name
}
```

The `if` has no `else` this time: the first time it creates the empty list, and then the `push` always runs.
--- task
Make `namesByNetwork(list)` return an object with one key per network, whose value is the list of the names of the shows on that network, in the order of `list`. An empty list gives `{}`.
--- hint
`const groups = {};`. In the loop: if `groups[show.network] === undefined`, set it to `[]`. Then `groups[show.network].push(show.name);`. Return `groups`.
--- hint
```js
function namesByNetwork(list) {
  const groups = {};
  for (const show of list) {
    if (groups[show.network] === undefined) {
      groups[show.network] = [];
    }
    groups[show.network].push(show.name);
  }
  return groups;
}
```
--- starter
// P32. Names per network
// namesByNetwork(list) gives back an object like
// { HBO: ["Chernobyl", "The Wire"], Netflix: ["Dark"] }

function namesByNetwork(list) {
  // your code here
}

const mini = [
  { name: "Chernobyl", network: "HBO" },
  { name: "Dark", network: "Netflix" },
  { name: "The Wire", network: "HBO" },
];
const none = [];

tryIt(namesByNetwork, [mini], { HBO: ["Chernobyl", "The Wire"], Netflix: ["Dark"] });
tryIt(namesByNetwork, [none], {});
--- solution
// P32. Names per network
// namesByNetwork(list) gives back an object like
// { HBO: ["Chernobyl", "The Wire"], Netflix: ["Dark"] }

function namesByNetwork(list) {
  const groups = {};
  for (const show of list) {
    if (groups[show.network] === undefined) {
      groups[show.network] = [];
    }
    groups[show.network].push(show.name);
  }
  return groups;
}

const mini = [
  { name: "Chernobyl", network: "HBO" },
  { name: "Dark", network: "Netflix" },
  { name: "The Wire", network: "HBO" },
];
const none = [];

tryIt(namesByNetwork, [mini], { HBO: ["Chernobyl", "The Wire"], Netflix: ["Dark"] });
tryIt(namesByNetwork, [none], {});
--- learned
An object whose values are arrays groups a list by any key. Arrays, objects, loops and `if` all in one function: that's the whole of Day 6.
--- summary
Practice: group into an object of arrays: create `[]` the first time, then `push`.
--- mistakes
- `groups[show.network] = [show.name]` every time: only the last name per network is left.
- `push` before the empty list exists: "Cannot read properties of undefined (reading 'push')".
- `groups.network` instead of `groups[show.network]`.
--- check
t.expect(!t.errors.length, `There's an error in the Console: "${t.errors[0]}". Read the help under it, fix that line, then check again.`);
const f = t.get("namesByNetwork");
t.expect(f !== undefined, "I can't find a function called `namesByNetwork`. Press **Start again** to get the starting code back.");
t.expect(typeof f === "function", "`namesByNetwork` should be a function.");
const call = (label, list) => {
  try { return f(list); } catch (e) {
    t.expect(!/reading 'push'/.test(e.message), `\`${label}\` crashed: ${e.message.replace(/\.$/, "")}. The first time you meet a network, its list doesn't exist yet. Before the \`push\`, add \`if (groups[show.network] === undefined) { groups[show.network] = []; }\`.`);
    t.expect(!/is not defined/.test(e.message), `\`${label}\` crashed: ${e.message.replace(/\.$/, "")}. Create \`const groups = {};\` before the loop, so it still exists after the loop.`);
    t.fail(`\`${label}\` crashed: ${e.message.replace(/\.$/, "")}.`);
  }
};
const show = (o) => { const s = JSON.stringify(o); return s && s.length > 220 ? s.slice(0, 217) + "..." : s; };
const sameGroups = (got, want) => got && typeof got === "object" && !Array.isArray(got) && Object.keys(got).length === Object.keys(want).length && Object.keys(want).every((k) => Array.isArray(got[k]) && got[k].join("|") === want[k].join("|"));
const shows = JSON.parse(JSON.stringify(t.get("shows")));
const want = {};
for (const s of shows) { if (!want[s.network]) want[s.network] = []; want[s.network].push(s.name); }
const r = call("namesByNetwork(shows)", shows);
t.expect(r !== undefined, "`namesByNetwork(shows)` gives back `undefined`. After the loop's closing `}`, add `return groups;`.");
t.expect(!Array.isArray(r), "`namesByNetwork` gives back a list. Group in an object instead: `const groups = {};`.");
t.expect(r && typeof r === "object", `\`namesByNetwork(shows)\` gives ${show(r)}. Return the \`groups\` object.`);
t.expect(!("network" in r), `\`namesByNetwork(shows)\` gives ${show(r)}. With a dot, the key is the word "network". Use square brackets: \`groups[show.network]\`.`);
t.expect(Object.values(r).every((v) => Array.isArray(v)), `\`namesByNetwork(shows)\` gives ${show(r)}. Each value should be a list of names: create \`[]\` the first time, then \`push(show.name)\`.`);
t.expect(Object.values(r).every((v) => v.every((x) => typeof x === "string")), "The lists should hold names, not whole shows: `push(show.name)`.");
t.expect(!(Array.isArray(r.HBO) && r.HBO.length === 1), `\`namesByNetwork(shows)\` gives HBO only ${JSON.stringify(r.HBO)}, but four shows are on HBO. Create the empty list only the first time (inside the \`if\`), and \`push\` every time, outside the \`if\`.`);
t.expect(sameGroups(r, want), `\`namesByNetwork(shows)\` gives ${show(r)}. HBO, for example, should be ${JSON.stringify(want.HBO)}.`);
const r2 = call("namesByNetwork(another list)", [{ name: "Show A", network: "CBS" }, { name: "Show B", network: "Test TV" }, { name: "Show C", network: "CBS" }]);
t.expect(sameGroups(r2, { CBS: ["Show A", "Show C"], "Test TV": ["Show B"] }), `With another list, \`namesByNetwork\` gives ${show(r2)}. It should give {"CBS":["Show A","Show C"],"Test TV":["Show B"]}. Loop through the parameter \`list\`, not \`shows\`.`);
const r3 = call("namesByNetwork([])", []);
t.expect(sameGroups(r3, {}), `\`namesByNetwork([])\` gives ${show(r3)}. An empty list should give an empty object \`{}\`.`);


=== step sort
title: Best first
minutes: 20
slot: js
bonus: yes
--- explain
`sort` puts a list in order. To sort by a number, give it a function that compares two items, `a` and `b`:

```js
const byPrice = [...snackList].sort((a, b) => a.price - b.price);
```

- If the answer is negative, `a` comes first; if it's positive, `b` comes first. `a.price - b.price` gives cheapest first; `b.price - a.price` gives the most expensive first.
- Careful: unlike `filter` and `map`, `sort` **changes the list you call it on**. `[...snackList]` makes a copy first, so the original stays as it is. The three dots are called **spread**: "take all the items and put them in a new array".
--- task
Write `sortByRating(list)` that returns a **copy** of the list, highest rating first. A new section, **Best first**, appears on the page.
--- hint
Copy with `[...list]`, then `.sort((a, b) => ...)`. For the highest first, subtract `a.rating` from `b.rating`.
--- hint
```js
function sortByRating(list) {
  return [...list].sort((a, b) => b.rating - a.rating);
}
```
--- solution-append
function sortByRating(list) {
  return [...list].sort((a, b) => b.rating - a.rating);
}
--- check
t.expect(!t.errors.length, `There's an error in the Console: "${t.errors[0]}". Read the help under it and fix that line.`);
const f = t.get("sortByRating");
t.expect(typeof f === "function", "I can't find a function called `sortByRating`. Start with `function sortByRating(list) {`.");
const input = [{ name: "A", rating: 7 }, { name: "B", rating: 9 }, { name: "C", rating: 8 }];
let r;
try { r = f(input); } catch (e) { t.fail("Your function crashed: " + e.message); }
t.expect(Array.isArray(r), "`sortByRating` should give back a list. Add `return`.");
const order = r.map((s) => s.name).join("");
t.expect(order !== "ACB", "That's lowest first. For the highest first, use `b.rating - a.rating`.");
t.expect(order === "BCA", `Sorting ratings 7, 9, 8 gave ${r.map((s) => s.rating).join(", ")}. It should give 9, 8, 7.`);
t.expect(input.map((s) => s.name).join("") === "ABC", "Your function changed the original list. Sort a copy: `[...list].sort(...)`.");
t.expect(t.get("shows")[0].name === "Friends", "The `shows` list itself got sorted. Sort a copy: `[...list].sort(...)`.");
t.expect(t.$$("#best-first li").length === 12, "The Best first section should list all 12 shows. Press **Run again** above the preview.");
--- learned
`sort` with a compare function orders a list by any number. Copying first with `[...list]` keeps the original safe.
--- summary
`[...list].sort((a, b) => b.x - a.x)` sorts a copy, biggest first.


=== step count
title: Count the genres
minutes: 20
slot: js
bonus: yes
--- explain
An object can also work as a set of counters. When the key is in a variable, use square brackets instead of a dot:

```js
const counts = {};
const word = "tea";
counts[word] = 1;           // same as counts.tea = 1
counts[word] = counts[word] + 1;
console.log(counts);        // {"tea":2}
```

A key that doesn't exist yet is `undefined`, and `undefined + 1` is `NaN` (*not a number*). So the first time you see a key, set it to 1; after that, add 1.

Each show has several genres, so you need a loop **inside** a loop: one through the shows, and one through each show's `genres`.
--- task
Write `countByGenre(list)` that returns an object like `{ Comedy: 4, Drama: 8, ... }`. Use loops and an object, not a new array method.

When it works, the genre buttons on the page show their counts.
--- hint
Start with `const counts = {};`. Loop through the shows; inside, loop through `show.genres`. For each genre: `if (counts[genre])` add 1, `else` set it to 1. Return `counts` after the loops.
--- hint
```js
function countByGenre(list) {
  const counts = {};
  for (const show of list) {
    for (const genre of show.genres) {
      if (counts[genre]) {
        counts[genre] = counts[genre] + 1;
      } else {
        counts[genre] = 1;
      }
    }
  }
  return counts;
}
```
--- solution-append
function countByGenre(list) {
  const counts = {};
  for (const show of list) {
    for (const genre of show.genres) {
      if (counts[genre]) {
        counts[genre] = counts[genre] + 1;
      } else {
        counts[genre] = 1;
      }
    }
  }
  return counts;
}
--- check
t.expect(!t.errors.length, `There's an error in the Console: "${t.errors[0]}". Check that every \`{\` has its \`}\`.`);
const f = t.get("countByGenre");
t.expect(typeof f === "function", "I can't find a function called `countByGenre`. Start with `function countByGenre(list) {`.");
let c;
try { c = f(t.get("shows")); } catch (e) { t.fail("Your function crashed: " + e.message); }
t.expect(c && typeof c === "object" && !Array.isArray(c), `\`countByGenre(shows)\` gives back ${JSON.stringify(c)}. Return the \`counts\` object after the loops.`);
t.expect(!Object.values(c).some((v) => Number.isNaN(v)), "Some counts are `NaN`. The first time you see a genre, set its count to 1 instead of adding 1 to `undefined`.");
t.expect(c.Comedy === 4 && c.Drama === 8, `\`countByGenre(shows)\` gives Comedy: ${c.Comedy}, Drama: ${c.Drama}. It should give Comedy: 4, Drama: 8. Loop through every genre of every show.`);
t.expect(c.Fantasy === 2 && Object.keys(c).length === 12, "Count every genre: there are 12 different ones in data.js.");
let e;
try { e = f([]); } catch (err) { t.fail("Your function crashed with an empty list: " + err.message); }
t.expect(e && Object.keys(e).length === 0, "`countByGenre([])` should give an empty object `{}`. Use the parameter `list`, not `shows`.");
t.expect(/Drama 8/.test(t.text("#genre-buttons")), "The genre buttons should show their counts, like Drama 8. Press **Run again** above the preview.");
--- learned
An object with keys you add as you go is a flexible counter. `counts[genre]` uses the value of `genre` as the key.
--- summary
`obj[key]` reads or sets a property whose name is in a variable.


=== step total
title: Watch everything
minutes: 15
slot: js
bonus: yes
--- explain
A loop can also add things up. Start a total at 0 with `let`, and add to it on every round:

```js
let total = 0;
for (const snack of snackList) {
  total = total + snack.price;
}
console.log(total);   // 7.5
```

It has to be `let`, because the total changes on every round. And it must be created **before** the loop: inside, it would start again at 0 each time.
--- task
Write `totalWatchTime(list)` that returns the total minutes needed to watch every episode of every show in the list (each show: episodes times runtime).

A new section, **Watch everything**, appears on the page.
--- hint
`let total = 0;`, then a loop that adds `show.episodes * show.runtime` to `total`. Return `total` after the loop.
--- hint
```js
function totalWatchTime(list) {
  let total = 0;
  for (const show of list) {
    total = total + show.episodes * show.runtime;
  }
  return total;
}
```
--- solution-append
function totalWatchTime(list) {
  let total = 0;
  for (const show of list) {
    total = total + show.episodes * show.runtime;
  }
  return total;
}
--- check
t.expect(!t.errors.length, `There's an error in the Console: "${t.errors[0]}". Read the help under it and fix that line.`);
const f = t.get("totalWatchTime");
t.expect(typeof f === "function", "I can't find a function called `totalWatchTime`. Start with `function totalWatchTime(list) {`.");
const shows = t.get("shows");
const want = shows.reduce((sum, s) => sum + s.episodes * s.runtime, 0);
let r;
try { r = f(shows); } catch (e) {
  t.expect(!/total is not defined/.test(e.message), "Your function crashed: `total` doesn't exist after the loop. Create it with `let total = 0;` before the loop, not inside it.");
  t.fail("Your function crashed: " + e.message);
}
t.expect(r !== undefined, "`totalWatchTime(shows)` gives back `undefined`. Return `total` after the loop.");
t.expect(r !== shows[shows.length - 1].episodes * shows[shows.length - 1].runtime, "You get only the last show's minutes. Create `total` with `let` before the loop, and add to it inside.");
t.expect(r === want, `\`totalWatchTime(shows)\` gives ${r}. It should give ${want} minutes: for each show, add episodes times runtime.`);
t.expect(f([]) === 0, "`totalWatchTime([])` should give 0. Start the total at 0.");
t.expect(f([{ episodes: 2, runtime: 30 }]) === 60, "Use the parameter `list` in your loop, not `shows`.");
t.expect(/655 hours/.test(t.text("#watch-all")), "The Watch everything section should appear. Press **Run again** above the preview.");
--- learned
A running total with `let` and a loop can add up anything. All twelve shows take 655 hours: more than 27 days without sleep.
--- summary
Add up a list: `let total = 0;` before the loop, `total = total + ...` inside.
