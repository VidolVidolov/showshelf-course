tryIt(lowestRated, [shows], "The Crown");
--- solution
// P27. The lowest rating
// lowestRated(list) gives back the NAME of the show with the lowest rating.
// On a tie the first one wins. An empty list gives "".

function lowestRated(list) {
  if (list.length === 0) {
    return "";
  }
  let best = list[0];
  for (const show of list) {
    if (show.rating < best.rating) {
      best = show;
    }
  }
  return best.name;
}

const mini = [
  { name: "Dark", rating: 8.7 },
  { name: "Fleabag", rating: 8.4 },
  { name: "Chernobyl", rating: 9.1 },
];
const none = [];

tryIt(lowestRated, [mini], "Fleabag");
tryIt(lowestRated, [none], "");
tryIt(lowestRated, [shows], "The Crown");
--- learned
`<` finds the lowest and keeps the first on a tie. "Lowest" here is still 8.0: every show in data.js is worth watching.
