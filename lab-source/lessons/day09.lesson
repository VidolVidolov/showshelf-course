await t.rerun();   // start from a fresh run of the page
const getShowById = t.get("getShowById");
t.expect(typeof getShowById === "function", "I can't find `getShowById`. Press **Start again** to get the new code back.");
let data;
try { data = await getShowById(169); } catch (e) { t.fail("`getShowById(169)` crashed: " + e.message + (/reading '(cast|seasons)'/.test(e.message) ? ". Check the spelling: `data._embedded`, with an underscore at the start." : "")); }
t.expect(data && typeof data === "object", "`getShowById` should give back an object. Fill in the TODO: `return { show: ..., cast: ..., seasons: ... };`.");
t.expect(data.show && data.show.name === "Breaking Bad", "`getShowById(169).show` should be Breaking Bad: `show: toShow(data)`.");
t.expect(typeof data.show.rating === "number", "`show` should be in our shape, with `rating` as a plain number. Use `toShow(data)`.");
t.expect(Array.isArray(data.cast) && data.cast.length === 4, "`cast` should be the array `data._embedded.cast`.");
t.expect(Array.isArray(data.seasons) && data.seasons.length === 5, "`seasons` should be the array `data._embedded.seasons`.");
t.expect(await t.waitFor(() => t.$$("#grid .card").length === 12, 3000), "The home view should load 12 shows. Look in the Console for an error.");
await t.click(t.$$("#grid .card h3")[0]);
t.expect(await t.waitFor(() => t.logs.some((l) => l.text.trim() === "Friends"), 3000), "Clicking Friends should log its name. Make `openShow` `async`, and at its end add `const data = await getShowById(id);` and `console.log(data.show.name);`.");
--- learned
One request, three kinds of data, thanks to `embed`. And `getShowById` hands them back together in one object, with the show already in our shape.
--- summary
`/shows/ID?embed[]=cast&embed[]=seasons` gets a show with its cast and seasons; a function can return an object.
--- mistakes
- `data.embedded.cast`: the property starts with an underscore, `_embedded`.
- Forgetting `async` on `openShow`, so `await` gives an error.
- `toShow(data._embedded)` instead of `toShow(data)`.


=== step show-info
title: Fill in the show
minutes: 20
slot: js
--- explain
Now put the show on the page. The show view already has empty elements for each part, and their constants are at the top of your code: `showName`, `showMeta`, `showSummary` and so on.

For text, always use `textContent`. There's also a property called `innerHTML`, which treats the text as HTML. That's dangerous with text from the internet: if a summary contained `<img src=x onerror="stealPasswords()">`, `innerHTML` would run that code on your page. `textContent` shows it as harmless text.

> The rule: text that comes from anywhere else goes in with `textContent`, never `innerHTML`.

For the genres, you make one badge per genre, like the chips on the home page:

```js
for (const tag of photo.tags) {
  const label = document.createElement("span");
  label.textContent = tag;
  tagsBox.append(label);
}
```

We've added `renderShow(show)` below your code. The poster and the rating are done; four TODOs are for you.
--- task
1. Fill in the four TODOs in `renderShow`.
2. In `openShow`, replace `console.log(data.show.name);` with `renderShow(data.show);`.

Click a few cards: each opens with its own name, years, summary and genres. Press **Run again** to go back (the back button comes later).
--- starter-append
// Fill the show view with one show (in our shape)
function renderShow(show) {
  showPoster.src = show.image ?? "poster.svg";
  showPoster.alt = "Poster for " + show.name;
  // TODO 1: the name, in showName

  // TODO 2: the years, in showMeta (yearsLabel with show.premiered and show.ended)
  if (show.network !== "") {
    showMeta.textContent += " · " + show.network;   // += adds to the end of the text
  }

  if (show.rating === null) {
    showRating.textContent = "No rating yet";
  } else {
    showRating.textContent = "★ " + show.rating + " · " + ratingLabel(show.rating);
  }

  // TODO 3: the summary, in showSummary. Use textContent, never innerHTML!
  if (show.summary === "") {
    showSummary.textContent = "No summary yet.";
  }

  // One badge per genre
  showGenres.replaceChildren();
  for (const genre of show.genres) {
    // TODO 4: create a <span> with the class "badge" and the genre as its text,
    //         then add it to showGenres
    showGenres.append(" ");   // a space between the badges
  }
}
--- hint
TODOs 1 to 3 are one line each, like `showName.textContent = show.name;`. TODO 4 is three lines (create, class, text) plus an `append`, like building the chips on Day 7.
--- hint
```js
  showName.textContent = show.name;
```
```js
  showMeta.textContent = yearsLabel(show.premiered, show.ended);
```
```js
  showSummary.textContent = show.summary;
```
