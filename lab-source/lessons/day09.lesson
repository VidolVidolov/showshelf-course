    const badge = document.createElement("span");
    badge.className = "badge";
    badge.textContent = genre;
    showGenres.append(badge);
```
--- solution-replace
  const data = await getShowById(id);
  console.log(data.show.name);
=>
  const data = await getShowById(id);
  renderShow(data.show);
--- solution-append
// Fill the show view with one show (in our shape)
function renderShow(show) {
  showPoster.src = show.image ?? "poster.svg";
  showPoster.alt = "Poster for " + show.name;
  showName.textContent = show.name;

  showMeta.textContent = yearsLabel(show.premiered, show.ended);
  if (show.network !== "") {
    showMeta.textContent += " · " + show.network;   // += adds to the end of the text
  }

  if (show.rating === null) {
    showRating.textContent = "No rating yet";
  } else {
    showRating.textContent = "★ " + show.rating + " · " + ratingLabel(show.rating);
  }

  // textContent, never innerHTML: the summary is text from the internet
  showSummary.textContent = show.summary;
  if (show.summary === "") {
    showSummary.textContent = "No summary yet.";
  }

  // One badge per genre
  showGenres.replaceChildren();
  for (const genre of show.genres) {
    const badge = document.createElement("span");
    badge.className = "badge";
    badge.textContent = genre;
    showGenres.append(badge);
    showGenres.append(" ");   // a space between the badges
  }
}
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const openShow = t.get("openShow");
t.expect(typeof openShow === "function", "I can't find `openShow`. Look in the Console for an error.");
t.expect(!/showSummary\.innerHTML/.test(t.clean), "Use `textContent` for the summary, not `innerHTML`. Text from the internet must never be treated as HTML.");
openShow(431);
t.expect(await t.waitFor(() => t.text("#show-name") === "Friends", 3000), "After opening Friends, the show view should show its name. In `openShow`, replace the `console.log` with `renderShow(data.show);`, and fill in TODO 1: `showName.textContent = show.name;`.");
const meta = t.text("#show-meta");
t.expect(/1994/.test(meta), `The line under the name says "${meta}". TODO 2: \`showMeta.textContent = yearsLabel(show.premiered, show.ended);\`, above the network lines.`);
const sum = t.text("#show-summary");
t.expect(/six friends/i.test(sum), `The summary says "${sum}". TODO 3: \`showSummary.textContent = show.summary;\`, above the "No summary yet" lines.`);
const badges = () => t.$$("#show-genres .badge").map((b) => t.text(b));
t.expect(badges().length === 2 && badges()[0] === "Comedy" && badges()[1] === "Romance", `TODO 4: the genres show ${badges().length} badges (${badges().join(", ")}). There should be one \`<span class="badge">\` per genre: Comedy and Romance.`);
openShow(169);
t.expect(await t.waitFor(() => t.text("#show-name") === "Breaking Bad", 3000), "Opening a second show should replace the name.");
const meta2 = t.text("#show-meta");
t.expect(/2008/.test(meta2) && (meta2.match(/AMC/g) || []).length === 1 && !/NBC/.test(meta2), `After opening Breaking Bad the line under the name says "${meta2}". TODO 2 must set the text with \`=\`, above the network lines, so each show starts fresh.`);
t.expect(badges().length === 3 && badges()[0] === "Drama", "After opening Breaking Bad there should be its 3 genre badges, not the old ones as well.");
--- learned
The show view is filled from one object, with `textContent` everywhere. Remember the rule: text from anywhere else goes in with `textContent`, never `innerHTML`.
--- summary
Fill a view from an object with `textContent`; never use `innerHTML` for text from outside.
--- mistakes
- `showSummary.innerHTML = show.summary`: works, but opens the door to code hidden in the text.
- Writing TODO 2 below the network lines, so `=` wipes the network out again.
- Appending the badges without `replaceChildren()` first (it's given), so they pile up from show to show.


=== step cast
title: The cast
minutes: 15
slot: js
--- explain
The cast is an array of objects, and each one has two objects inside: the **person** (the actor) and the **character** they play.

```js
{
  person: { name: "Bryan Cranston", image: ... },
  character: { name: "Walter White" }
}
```

To reach a name, go one level at a time: `member.person.name`, `member.character.name`.

A list is built like the grid: empty it, then one new element per item.

```js
stopsList.replaceChildren();
for (const stop of route.stops) {
  const item = document.createElement("li");
  item.textContent = stop.name + " at " + stop.time;
  stopsList.append(item);
}
```
