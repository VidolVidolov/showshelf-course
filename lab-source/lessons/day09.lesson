await t.rerun();   // start from a fresh run of the page
t.get("openShow")(431);
t.expect(await t.waitFor(() => t.text("#show-name") === "Friends", 3000), "Opening a show should still fill the show view. Keep `renderShow` and `renderCast` in `openShow`.");
const rows = () => t.$$("#show-seasons tr");
t.expect(await t.waitFor(() => rows().length > 0, 1000), "The seasons table is empty. In `openShow`, call `renderSeasons(data.seasons);`.");
t.expect(rows().length === 10, `The seasons table has ${rows().length} rows. Friends has 10 seasons: one row each.`);
const cells = [...rows()[0].querySelectorAll("td")].map((c) => t.text(c));
t.expect(cells.length === 3, `The first row has ${cells.length} cells. Add three to each row: \`row.append(createCell(...), createCell(...), createCell(...));\``);
t.expect(cells[0] === "1" && cells[1] === "24", `The first row says ${cells.join(" | ")}. It should start with season 1 and 24 episodes: \`season.number\` and \`season.episodeOrder\`.`);
t.expect(cells[2] === "1994", `The year cell says "${cells[2]}". Show only the year: \`yearOf(season.premiereDate)\`.`);
--- learned
When the same three lines keep coming back, a small function like `createCell` makes the code shorter and easier to read. The show view is now complete.
--- summary
A small helper function (`createCell`) removes repetition.
--- mistakes
- `createCell(season.premiereDate)`: the whole date instead of the year.
- Appending the row to `castList` or to the `table` instead of `seasonsBody`.


