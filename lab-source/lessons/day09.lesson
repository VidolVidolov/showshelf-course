    const data = await getShowById(id);
    renderShow(data.show);
    renderCast(data.cast);
    renderSeasons(data.seasons);
    showStatus.hidden = true;
    showDetails.hidden = false;
  } catch (error) {
    // No internet, or TVmaze answered with an error
    showStatus.textContent = "Sorry, this show could not be loaded (" + error.message + "). Check your internet connection and try again.";
    showStatus.classList.add("error");
  }
}
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const status = t.$("#show-status"), details = t.$("#show-details");
t.get("openShow")(431);
await t.sleep(60);
t.expect(!status.hidden && /loading/i.test(t.text(status)), "While the show is loading, show a message. In `openShow`, after `window.scrollTo(0, 0);`, set `showStatus.textContent = \"Loading show…\";` and `showStatus.hidden = false;`.");
t.expect(details.hidden, "While loading, hide the old show: `showDetails.hidden = true;`.");
t.expect(await t.waitFor(() => t.text("#show-name") === "Friends" && !details.hidden, 3000), "When the show has loaded, show the details again: `showDetails.hidden = false;` at the end of `try`.");
t.expect(status.hidden, "When the show has loaded, hide the loading message: `showStatus.hidden = true;`.");
const realFetch = t.win.fetch;
try {
  t.win.fetch = () => new t.win.Promise((resolve, reject) => t.win.setTimeout(() => reject(new t.win.TypeError("Failed to fetch")), 200));
  t.get("openShow")(169);
  t.expect(await t.waitFor(() => status.classList.contains("error") && !/loading/i.test(t.text(status)), 2000), "With no internet connection, the show view should say so in red. Put the `await` line in `try { }`, and in `catch (error) { }` set a message and `showStatus.classList.add(\"error\");`.");
  t.expect(details.hidden, "After an error, keep the details hidden.");
} finally {
  t.win.fetch = realFetch;
}
t.get("openShow")(431);
await t.sleep(60);
t.expect(!status.classList.contains("error"), "After an error, the next \"Loading show…\" is still red. Remove the class at the start: `showStatus.classList.remove(\"error\");`.");
t.expect(await t.waitFor(() => !details.hidden && status.hidden, 3000), "When the connection works again, opening a show should work normally.");
--- learned
Every view that loads data needs its loading and error states. You wrote the pattern once in `loadShows`; now you can use it anywhere.
--- summary
Loading and error states for the show view: a message before `await`, `try / catch` around it.
--- mistakes
- Showing the details before the `await`, so the old show flashes.
- Leaving `renderShow` outside `try`, so an error still breaks the page.


=== step not-found
title: Show not found
minutes: 10
slot: js
--- explain
What if the id doesn't exist? TVmaze answers with status **404**, "not found". Right now `getShowById` throws, and the page says "could not be loaded, check your internet connection". That's wrong: the connection is fine, the show doesn't exist.

A 404 is a normal answer, not a broken connection, so let's treat it as one: `getShowById` gives back `null`, which means "no such show", and `openShow` shows its own message.

`return` can end a function early:

```js
if (basket.length === 0) {
  message.textContent = "Your basket is empty.";
  return;   // nothing more to do
}
```
--- task
1. In `getShowById`, before the `response.ok` check: if `response.status` is `404`, `return null;`.
2. In `openShow`, straight after the `await` line: if `data` is `null`, set `showStatus` to "Show not found." and `return`.
--- hint
Both are small `if` blocks. The one in `getShowById` must come **before** `if (!response.ok)`, because a 404 is also "not ok".
--- hint
```js
  if (response.status === 404) {
    return null;
  }
```
```js
    const data = await getShowById(id);
    if (data === null) {
      showStatus.textContent = "Show not found. Go back and pick another one.";
      return;
    }
```
--- solution-replace
  const response = await fetch(`${API}/shows/${id}?embed[]=cast&embed[]=seasons`);
  if (!response.ok) {
=>
  const response = await fetch(`${API}/shows/${id}?embed[]=cast&embed[]=seasons`);
  if (response.status === 404) {
    return null;   // TVmaze has no show with this id
  }
  if (!response.ok) {
--- solution-replace
// getShowById(431) -> { show: {...our shape...}, cast: [...], seasons: [...] }
=>
// getShowById(431) -> { show: {...our shape...}, cast: [...], seasons: [...] }, or null if there's no such show
--- solution-replace
    const data = await getShowById(id);
    renderShow(data.show);
=>
    const data = await getShowById(id);
    if (data === null) {
      showStatus.textContent = "Show not found. Go back and pick another one.";
      return;
    }
    renderShow(data.show);
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
let r;
try { r = await t.get("getShowById")(999999); } catch (e) { r = "threw"; }
t.expect(r === null, "When TVmaze answers 404, `getShowById` should give back `null` instead of throwing. Before the `response.ok` check, add `if (response.status === 404) { return null; }`.");
const status = t.$("#show-status");
t.get("openShow")(999999);
t.expect(await t.waitFor(() => /not found/i.test(t.text(status)), 3000), `Opening a show that doesn't exist shows "${t.text(status)}". In \`openShow\`, after the \`await\` line, if \`data === null\`, set the message "Show not found." and \`return;\`.`);
t.expect(t.$("#show-details").hidden, "For a show that doesn't exist, keep the details hidden.");
t.get("openShow")(169);
t.expect(await t.waitFor(() => t.text("#show-name") === "Breaking Bad" && !t.$("#show-details").hidden, 3000), "Shows that do exist should still open normally.");
--- learned
Not every failure is an error. A 404 is a clear answer, "no such thing", and deserves its own honest message. `return` inside an `if` ends the function early.
--- summary
Treat 404 as "not found" (`return null`), and use an early `return` for special cases.
--- mistakes
- Putting the 404 check after `if (!response.ok)`: the function throws first and never gets there.
- Forgetting `return;` after the message, so `renderShow(null.show)` crashes.


=== step mylist-objects
title: My List remembers more
minutes: 20
slot: js
--- explain
Soon My List gets its own view. But My List holds only ids, like `[431, 169]`, and a card needs a name, a poster, a rating. We could ask TVmaze for every show in the list, but that's many requests, and it wouldn't work offline.

Instead, My List will keep a small **object** for each show, with only what a card needs:

```js
{ id: 431, name: "Friends", image: null, genres: ["Comedy", "Romance"], rating: 8.8 }
```

The saved text gets a bit longer, but the My List view can draw straight from it. It goes back to the key `"myList"`. We've added `loadMyList()` below: it also throws away the plain ids that Day 7 saved under that key.

Checking for an id in a list of objects needs a new array method: `some` gives `true` if **at least one** item passes the test.

```js
[{ day: "Mon" }, { day: "Fri" }].some((item) => item.day === "Fri");   // true
```
--- task
1. In `state`, load the list with the new function: `myList: loadMyList(),`
2. In `saveMyList`, use the key `"myList"` again.
3. In `isInMyList`: `return state.myList.some((item) => item.id === id);`
4. In `toggleMyList`, remove with `state.myList.filter((item) => item.id !== show.id)`, and push an object with the five properties `id`, `name`, `image`, `genres` and `rating`, taken from `show`.
--- starter-append
// ---------- My List, saved as small objects ----------
// Each show in My List is saved with what a card needs, so the My List view
// can draw it without asking TVmaze:
//   { id: 431, name: "Friends", image: null, genres: ["Comedy", "Romance"], rating: 8.8 }

// Read My List from localStorage (the key is "myList")
function loadMyList() {
  const saved = JSON.parse(localStorage.getItem("myList")) ?? [];
  // On Day 7 this key held plain ids, like [2, 5]. Keep only the objects.
  return saved.filter((item) => typeof item === "object");
}
--- hint
In `toggleMyList`, the `push` gets an object literal: `state.myList.push({ id: show.id, name: show.name, ... });`.
--- hint
```js
function isInMyList(id) {
  return state.myList.some((item) => item.id === id);
}

function toggleMyList(show) {
  if (isInMyList(show.id)) {
    state.myList = state.myList.filter((item) => item.id !== show.id);
  } else {
    state.myList.push({
      id: show.id,
      name: show.name,
      image: show.image,
      genres: show.genres,
      rating: show.rating,
    });
  }
  saveMyList();
  render();
}
```
--- solution-replace
  myList: JSON.parse(localStorage.getItem("myListIds")) ?? [],   // saved TVmaze ids, or an empty list
=>
  myList: loadMyList(),   // small objects for the shows in My List (see loadMyList below)
--- solution-replace
// Is this show in My List? Gives true or false.
function isInMyList(id) {
  return state.myList.includes(id);
}
=>
// Is this show in My List? Gives true or false.
function isInMyList(id) {
  return state.myList.some((item) => item.id === id);
}
--- solution-replace
  if (isInMyList(show.id)) {
    state.myList = state.myList.filter((id) => id !== show.id);
  } else {
    state.myList.push(show.id);
  }
=>
  if (isInMyList(show.id)) {
    state.myList = state.myList.filter((item) => item.id !== show.id);
  } else {
    // Save what a card needs, so My List can be drawn without asking TVmaze
    state.myList.push({
      id: show.id,
      name: show.name,
      image: show.image,
      genres: show.genres,
      rating: show.rating,
    });
  }
--- solution-replace
  localStorage.setItem("myListIds", JSON.stringify(state.myList));
=>
  localStorage.setItem("myList", JSON.stringify(state.myList));
--- solution-append
// ---------- My List, saved as small objects ----------
// Each show in My List is saved with what a card needs, so the My List view
// can draw it without asking TVmaze:
//   { id: 431, name: "Friends", image: null, genres: ["Comedy", "Romance"], rating: 8.8 }

// Read My List from localStorage (the key is "myList")
function loadMyList() {
  const saved = JSON.parse(localStorage.getItem("myList")) ?? [];
  // On Day 7 this key held plain ids, like [2, 5]. Keep only the objects.
  return saved.filter((item) => typeof item === "object");
}
--- check
await t.sleep(450);
t.win.localStorage.removeItem("myList");
t.win.localStorage.removeItem("myListIds");
await t.rerun();
const buttons = () => t.$$("#grid .card .list-btn");
t.expect(await t.waitFor(() => buttons().length === 12, 3000), "The home view should load 12 shows with their + buttons. Look in the Console for an error.");
await t.click(buttons()[0]);
const raw = t.win.localStorage.getItem("myList");
t.expect(raw !== null, "Nothing was saved under the key `\"myList\"`. In `saveMyList`, change the key from `\"myListIds\"` to `\"myList\"`.");
const saved = JSON.parse(raw);
t.expect(Array.isArray(saved) && saved.length === 1, `After adding Friends, "myList" holds ${raw}. It should hold one item.`);
const item = saved[0];
t.expect(item && typeof item === "object", `My List saved ${JSON.stringify(item)} for Friends. It should save a small object: in \`toggleMyList\`, push \`{ id: show.id, name: show.name, image: show.image, genres: show.genres, rating: show.rating }\`.`);
t.expect(item.id === 431 && item.name === "Friends" && Array.isArray(item.genres) && item.rating === 8.8 && "image" in item, `The saved object is ${JSON.stringify(item)}. It needs five properties: id, name, image, genres and rating.`);
t.expect(t.text("#list-count") === "1", "After adding one show, the counter should say 1.");
t.expect(buttons()[0].getAttribute("aria-pressed") === "true", "Friends is in My List, but its button doesn't show a tick. Update `isInMyList`: `return state.myList.some((item) => item.id === id);`.");
await t.click(buttons()[0]);
t.expect(JSON.parse(t.win.localStorage.getItem("myList")).length === 0, "Clicking the tick again should take Friends out of My List. In `toggleMyList`, remove with `state.myList.filter((item) => item.id !== show.id)`.");
await t.click(buttons()[1]);
await t.rerun();
t.expect(await t.waitFor(() => buttons().length === 12, 3000), "After a reload the home view should load its shows again.");
t.expect(t.text("#list-count") === "1", "After a reload My List should still hold 1 show. In `state`, use `myList: loadMyList(),`.");
t.win.localStorage.setItem("myList", "[2,5]");
await t.rerun();
t.expect(t.text("#list-count") === "0", "Old Day 7 ids in \"myList\" should be ignored. In `state`, use `myList: loadMyList(),`, which keeps only the objects.");
t.win.localStorage.removeItem("myList");
--- learned
My List now stores exactly what a card needs. Saving a little extra data is a common trade: more text in localStorage, no extra requests later.
--- summary
Store small objects in localStorage; `some` checks whether any item matches.
--- mistakes
- Changing `push` but not `filter` (or `isInMyList`), so taking a show out stops working.
- `includes(id)` on a list of objects: always `false`, because it compares whole objects with a number.
- Forgetting a comma between the properties of the object.


=== step mylist-view
title: The My List view
minutes: 20
slot: js
--- explain
Now My List gets its view. It's drawn with the same `createCard` as the home page, so its cards have posters, ticks, and open the show on click. That's the payoff of writing one good function.

The header links need care: they're real links to `index.html`. On your finished website, following them would reload the page. `event.preventDefault()` stops that, like the form's submit on Day 7, and we switch views ourselves.

We've added `renderMyList()` and the listener for the logo, as an example. Read the logo's listener, then write the two others the same way.
--- task
1. **TODO 1** in `renderMyList`: a `for...of` loop over `state.myList` that appends `createCard(show)` to `myListGrid`.
2. At the end of `render()`, call `renderMyList();`, so My List is drawn every time the state changes.
3. **TODO 2**: click listeners for `homeLink` (to the `"home"` view) and `myListLink` (to the `"mylist"` view), like the logo's.

Add a few shows, open **My List** in the header, and take one out again.
--- starter-append
// ---------- The My List view ----------

// Draw the saved shows, with the same createCard as the home page
function renderMyList() {
  myListGrid.replaceChildren();
  // TODO 1: one card for each show in state.myList (a for...of loop, like renderGrid)

  myListEmpty.hidden = state.myList.length > 0;
}

// The logo goes home
logoLink.addEventListener("click", (event) => {
  event.preventDefault();   // don't follow the link: we switch views ourselves
  state.view = "home";
  render();
});

// TODO 2: the same for homeLink (to "home") and for myListLink (to "mylist")
--- hint
TODO 1 is a loop like the one in `renderGrid`, with `state.myList` and `myListGrid`. For TODO 2, copy the logo's listener twice and change the names.
--- hint
```js
  for (const show of state.myList) {
    myListGrid.append(createCard(show));
  }
```
```js
homeLink.addEventListener("click", (event) => {
  event.preventDefault();
  state.view = "home";
  render();
});

myListLink.addEventListener("click", (event) => {
  event.preventDefault();
  state.view = "mylist";
  render();
});
```
And in `render()`: `renderMyList();`
--- solution-replace
  renderGenres();
  listCount.textContent = state.myList.length;
}
=>
  renderGenres();
  listCount.textContent = state.myList.length;
  renderMyList();
}
--- solution-append
// ---------- The My List view ----------

// Draw the saved shows, with the same createCard as the home page
function renderMyList() {
  myListGrid.replaceChildren();
  for (const show of state.myList) {
    myListGrid.append(createCard(show));
  }
  myListEmpty.hidden = state.myList.length > 0;
}

// The logo goes home
logoLink.addEventListener("click", (event) => {
  event.preventDefault();   // don't follow the link: we switch views ourselves
  state.view = "home";
  render();
});

// The Home link goes home too
homeLink.addEventListener("click", (event) => {
  event.preventDefault();
  state.view = "home";
  render();
});

// The My List link opens the My List view
myListLink.addEventListener("click", (event) => {
  event.preventDefault();
  state.view = "mylist";
  render();
});
--- check
await t.sleep(450);
t.win.localStorage.removeItem("myList");
await t.rerun();
const buttons = () => t.$$("#grid .card .list-btn");
t.expect(await t.waitFor(() => buttons().length === 12, 3000), "The home view should load 12 shows. Look in the Console for an error.");
await t.click(buttons()[0]);
await t.click(buttons()[1]);
const nav = t.$(".nav");
let prevented = null;
const spy = (e) => { prevented = e.defaultPrevented; };
nav.addEventListener("click", spy);
await t.click("#nav-mylist");
nav.removeEventListener("click", spy);
t.expect(!t.$("#mylist-view").hidden && t.$("#home-view").hidden, "Clicking **My List** in the header should switch to the My List view. TODO 2: add a click listener to `myListLink` that sets `state.view = \"mylist\";` and calls `render();`.");
t.expect(prevented, "The My List link switched views, but also tried to open index.html. Start its listener with `event.preventDefault();`, like the logo's.");
const names = () => t.$$("#mylist-grid .card h3").map((h) => t.text(h));
t.expect(names().length === 2, `The My List view shows ${names().length} cards. TODO 1: in \`renderMyList\`, loop over \`state.myList\` and append \`createCard(show)\` to \`myListGrid\`. And call \`renderMyList();\` at the end of \`render()\`.`);
t.expect(names().includes("Friends") && names().includes("Breaking Bad"), `The My List view shows ${names().join(", ")}. It should show the shows you added: Friends and Breaking Bad.`);
t.expect(t.$("#mylist-empty").hidden, "With shows in My List, the \"Your list is empty\" message should be hidden. Call `renderMyList();` in `render()`.");
await t.click(t.$$("#mylist-grid .card .list-btn")[0]);
t.expect(names().length === 1, "Taking a show out in the My List view should remove its card straight away. Call `renderMyList();` at the end of `render()`.");
await t.click(t.$$("#mylist-grid .card .list-btn")[0]);
t.expect(!t.$("#mylist-empty").hidden, "With My List empty, the \"Your list is empty\" message should show.");
await t.click("#nav-home");
t.expect(!t.$("#home-view").hidden && t.$("#mylist-view").hidden, "Clicking **Home** in the header should bring the home view back. TODO 2: a click listener on `homeLink`, like the logo's.");
t.win.localStorage.removeItem("myList");
--- learned
A whole new view from one loop and `createCard`. Because My List saves what a card needs, it appears instantly, even offline.
--- summary
Reuse `createCard` for a second view; `preventDefault()` on links you handle yourself.
--- mistakes
- Forgetting `renderMyList()` in `render()`: the view only updates on a reload.
- Leaving out `event.preventDefault()`: in the Lab a notice appears; on the real website the page would reload.
- Looping over `state.shows` instead of `state.myList`.


=== step show-list-button
title: My List from the show view
minutes: 15
slot: js
--- explain
The show view has a button, **+ Add to My List**, that does nothing yet. It needs to know **which** show is open. That's state too: `state.currentShow`, the open show, or `null` when none is.

Once the button changes My List through `toggleMyList`, `render()` runs, and `render()` can draw the button's text from the state, like every other part of the page. We've added `renderShowListButton()` for that.

The pattern, one last time today:

1. The event changes the state (`toggleMyList(state.currentShow)`).
2. `render()` draws everything from the state, the button included.
--- task
1. In `state`, add `currentShow: null,`.
2. In `openShow`, right before `renderShow(data.show);`, remember the show: `state.currentShow = data.show;`. Right after `renderSeasons(...)`, call `renderShowListButton();`.
3. At the end of `render()`, call `renderShowListButton();`.
4. At the bottom, add a click listener to `showListButton` that calls `toggleMyList(state.currentShow);`.

Open a show, add it, then look at its card on the home page and in My List: all three agree.
--- starter-append
// The My List button in the show view. Its text follows the state.
function renderShowListButton() {
  if (!state.currentShow) {
    return;   // no show is open yet
  }
  if (isInMyList(state.currentShow.id)) {
    showListButton.textContent = "✓ In My List";
  } else {
    showListButton.textContent = "+ Add to My List";
  }
  showListButton.setAttribute("aria-pressed", isInMyList(state.currentShow.id));
}
--- hint
The listener has one line inside it. You don't need to call `render()` yourself: `toggleMyList` already does.
--- hint
```js
showListButton.addEventListener("click", () => {
  toggleMyList(state.currentShow);
});
```
In `openShow`:
```js
    state.currentShow = data.show;
    renderShow(data.show);
    renderCast(data.cast);
    renderSeasons(data.seasons);
    renderShowListButton();
```
--- solution-replace
  myList: loadMyList(),   // small objects for the shows in My List (see loadMyList below)
=>
  myList: loadMyList(),   // small objects for the shows in My List (see loadMyList below)
  currentShow: null,      // the show open in the show view (null when none is)
--- solution-replace
    renderShow(data.show);
    renderCast(data.cast);
    renderSeasons(data.seasons);
=>
    state.currentShow = data.show;
    renderShow(data.show);
    renderCast(data.cast);
    renderSeasons(data.seasons);
    renderShowListButton();
--- solution-replace
  renderMyList();
}
=>
  renderMyList();
  renderShowListButton();
}
--- solution-append
// The My List button in the show view. Its text follows the state.
function renderShowListButton() {
  if (!state.currentShow) {
    return;   // no show is open yet
  }
  if (isInMyList(state.currentShow.id)) {
    showListButton.textContent = "✓ In My List";
  } else {
    showListButton.textContent = "+ Add to My List";
  }
  showListButton.setAttribute("aria-pressed", isInMyList(state.currentShow.id));
}

// Add the open show to My List, or take it out
showListButton.addEventListener("click", () => {
  toggleMyList(state.currentShow);
});
--- check
await t.sleep(450);
t.win.localStorage.removeItem("myList");
await t.rerun();
t.expect(await t.waitFor(() => t.$$("#grid .card").length === 12, 3000), "The home view should load 12 shows. Look in the Console for an error.");
t.get("openShow")(169);
t.expect(await t.waitFor(() => t.text("#show-name") === "Breaking Bad" && !t.$("#show-details").hidden, 3000), "Opening Breaking Bad should fill the show view. Look in the Console for an error.");
t.expect(t.get("state").currentShow && t.get("state").currentShow.id === 169, "`state.currentShow` should be the open show. In `openShow`, add `state.currentShow = data.show;` before `renderShow(data.show);`.");
const btn = t.$("#show-list-button");
await t.click(btn);
const saved = () => JSON.parse(t.win.localStorage.getItem("myList") || "[]");
t.expect(saved().some((i) => i.id === 169), "Clicking **+ Add to My List** should add Breaking Bad. Add a click listener to `showListButton` that calls `toggleMyList(state.currentShow);`.");
t.expect(t.text("#list-count") === "1", "After adding from the show view, the counter at the top should say 1.");
t.expect(/in my list/i.test(t.text(btn)), `After adding, the button says "${t.text(btn)}". It should say "✓ In My List": call \`renderShowListButton();\` at the end of \`render()\`.`);
await t.click(btn);
t.expect(!saved().some((i) => i.id === 169) && /add/i.test(t.text(btn)), "Clicking again should take Breaking Bad out, and the button should say \"+ Add to My List\" again.");
await t.click(t.$$("#grid .card .list-btn")[0]);
t.get("openShow")(431);
t.expect(await t.waitFor(() => t.text("#show-name") === "Friends" && !t.$("#show-details").hidden, 3000), "Opening Friends should fill the show view.");
t.expect(/in my list/i.test(t.text(btn)), "Friends was added from its card, so its show view should say \"✓ In My List\" straight away. In `openShow`, call `renderShowListButton();` after the show is drawn.");
t.win.localStorage.removeItem("myList");
--- learned
Your ShowShelf is complete: search, genres, a page for every show, and a My List that remembers. Every part is drawn from one `state`, so the card, the show view and My List always agree. On Day 11 this becomes your website.
--- summary
`state.currentShow` remembers the open show; one `render()` keeps every view in agreement.
--- mistakes
- Setting the button's text inside the click listener instead of in `render()`: it goes wrong when the show is added from its card.
- Adding the listener inside `openShow`: every opened show adds one more listener, and one click toggles several times.
--- teacher
This is the last core step of the app students take home on Day 11. If time allows, ask them to try it online (the preview asks the real TVmaze when there's internet): real posters, and some shows with "No rating yet".


=== step address
title: A link for every show
minutes: 20
slot: js
bonus: yes
--- explain
Open a show and look at the address: it doesn't change. So you can't share a link to a show, and the browser's back button doesn't go back to the home view.

The part of an address after `#` is called the **hash**. Changing it doesn't reload the page, and the browser fires a `"hashchange"` event every time it changes, including when someone presses the back button.

```js
location.hash = "step/3";   // the address now ends with #step/3
location.hash;              // "#step/3"
"#step/3".slice(6);         // "3": the text from position 6 on
```

So the plan: a card click only changes the hash to `#show/431`, and one listener opens whatever show the hash names. We've added that listener's function, `showFromAddress()`.

> `startsWith` checks the beginning of a text: `"#show/431".startsWith("#show/")` is `true`.
--- task
1. **TODO**: call `showFromAddress` on every `"hashchange"` of `window`.
2. In `createCard`'s click listener, replace `openShow(show.id);` with `location.hash = "show/" + show.id;`.
3. In the back button's listener, replace its two lines with `location.hash = "";`.
4. In the logo, Home and My List listeners, add `location.hash = "";` after `event.preventDefault();`, so the address forgets the show.
--- starter-append
// ---------- Extra: an address for every show, like index.html#show/431 ----------

// Show the view that the address asks for
function showFromAddress() {
  if (location.hash.startsWith("#show/")) {
    const id = Number(location.hash.slice(6));   // "#show/431" -> 431
    openShow(id);
  } else if (state.view === "show") {
    state.view = "home";                          // the address has no show any more
    render();
  }
}

// TODO: call showFromAddress every time the address changes ("hashchange" on window)

// Someone opened a link to a show, like index.html#show/431: open it straight away
if (location.hash.startsWith("#show/")) {
  showFromAddress();
}
--- hint
`window.addEventListener("hashchange", showFromAddress);`: give the function's name, without brackets, so the browser calls it later.
--- hint
```js
window.addEventListener("hashchange", showFromAddress);
```
In `createCard`:
```js
  card.addEventListener("click", () => {
    location.hash = "show/" + show.id;
  });
```
The back button:
```js
backButton.addEventListener("click", () => {
  location.hash = "";
});
```
--- solution-replace
  card.addEventListener("click", () => {
    openShow(show.id);
  });
=>
  card.addEventListener("click", () => {
    location.hash = "show/" + show.id;   // the hashchange listener opens the show
  });
--- solution-replace
backButton.addEventListener("click", () => {
  state.view = "home";
  render();
});
=>
backButton.addEventListener("click", () => {
  location.hash = "";   // the hashchange listener goes home
});
--- solution-replace
logoLink.addEventListener("click", (event) => {
  event.preventDefault();   // don't follow the link: we switch views ourselves
=>
logoLink.addEventListener("click", (event) => {
  event.preventDefault();   // don't follow the link: we switch views ourselves
  location.hash = "";
--- solution-replace
homeLink.addEventListener("click", (event) => {
  event.preventDefault();
=>
homeLink.addEventListener("click", (event) => {
  event.preventDefault();
  location.hash = "";
--- solution-replace
myListLink.addEventListener("click", (event) => {
  event.preventDefault();
=>
myListLink.addEventListener("click", (event) => {
  event.preventDefault();
  location.hash = "";
--- solution-append
// ---------- Extra: an address for every show, like index.html#show/431 ----------

// Show the view that the address asks for
function showFromAddress() {
  if (location.hash.startsWith("#show/")) {
    const id = Number(location.hash.slice(6));   // "#show/431" -> 431
    openShow(id);
  } else if (state.view === "show") {
    state.view = "home";                          // the address has no show any more
    render();
  }
}

window.addEventListener("hashchange", showFromAddress);

// Someone opened a link to a show, like index.html#show/431: open it straight away
if (location.hash.startsWith("#show/")) {
  showFromAddress();
}
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
t.expect(await t.waitFor(() => t.$$("#grid .card").length === 12, 3000), "The home view should load 12 shows. Look in the Console for an error.");
await t.click(t.$$("#grid .card h3")[1]);
t.expect(await t.waitFor(() => t.win.location.hash === "#show/169", 1000), "Clicking a card should put the show in the address. In `createCard`'s click listener: `location.hash = \"show/\" + show.id;`.");
t.expect(await t.waitFor(() => t.text("#show-name") === "Breaking Bad" && !t.$("#show-view").hidden, 3000), "The address changed to #show/169, but the show didn't open. TODO: `window.addEventListener(\"hashchange\", showFromAddress);`.");
await t.click("#back-button");
t.expect(await t.waitFor(() => t.win.location.hash === "", 1000), "The back button should clear the address: `location.hash = \"\";`.");
t.expect(await t.waitFor(() => !t.$("#home-view").hidden, 1000), "When the address has no show any more, the home view should come back.");
t.win.location.hash = "#show/431";
t.expect(await t.waitFor(() => t.text("#show-name") === "Friends" && !t.$("#show-view").hidden, 3000), "Changing the address to #show/431 should open Friends.");
await t.click("#nav-mylist");
t.expect(!t.$("#mylist-view").hidden, "The My List link should still open the My List view.");
t.expect(await t.waitFor(() => t.win.location.hash === "", 1000), "The My List link should clear the address too (`location.hash = \"\";`), or clicking the same show again won't change the address.");
t.win.location.hash = "";
--- learned
The hash makes views linkable, and `"hashchange"` makes the back button work. Big apps use the same idea, often with a library called a router.
--- summary
`location.hash` and the `"hashchange"` event give each view its own address.
--- teacher
Inside the Lab, the preview's own address changes (you can't see it). On the real website from Day 11, the address bar shows `#show/431` and the browser's back button works.


=== step cast-photos
title: Cast photos
minutes: 15
slot: js
bonus: yes
--- explain
On TVmaze, most cast members have a photo: `member.person.image` is an object with a `medium` address, or `null` when there's no photo. (The Lab's offline sample data has no photos, so the check tests your code with made-up data.)

An `<li>` can hold more than text. Build it in parts with `append`: a picture first, then the text.

```js
const item = document.createElement("li");
item.append(icon);                     // an element
item.append("Milk, 2 bottles");        // then plain text
```

Careful: setting `textContent` after appending the picture would wipe the picture out, because `textContent` replaces everything inside.
--- task
In `renderCast`'s loop, when `member.person.image` is not `null`, create an `<img>` with `src` set to `member.person.image.medium`, an empty `alt`, and `width` 60, and append it to the `li` **before** the text. Then append the text with `append` instead of `textContent`.
--- hint
Inside the loop: create the `li`, then an `if` block for the photo, then `item.append(member.person.name + " as " + member.character.name);`.
--- hint
```js
  for (const member of cast) {
    const item = document.createElement("li");
    if (member.person.image !== null) {
      const photo = document.createElement("img");
      photo.src = member.person.image.medium;
      photo.alt = "";
      photo.width = 60;
      item.append(photo);
    }
    item.append(member.person.name + " as " + member.character.name);
    castList.append(item);
  }
```
--- solution-replace
    const item = document.createElement("li");
    item.textContent = member.person.name + " as " + member.character.name;
    castList.append(item);
=>
    const item = document.createElement("li");
    if (member.person.image !== null) {
      const photo = document.createElement("img");
      photo.src = member.person.image.medium;
      photo.alt = "";
      photo.width = 60;
      item.append(photo);
    }
    item.append(member.person.name + " as " + member.character.name);
    castList.append(item);
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const renderCast = t.get("renderCast");
t.expect(typeof renderCast === "function", "I can't find `renderCast`. Look in the Console for an error.");
const fake = [
  { person: { name: "Ann Example", image: { medium: "https://static.tvmaze.com/example.jpg" } }, character: { name: "Herself" } },
  { person: { name: "Bob Example", image: null }, character: { name: "Himself" } },
];
try { renderCast(fake); } catch (e) { t.fail("Your `renderCast` crashed: " + e.message + ". Check for `null` before using `member.person.image.medium`."); }
const lis = t.$$("#show-cast li");
t.expect(lis.length === 2, `With two cast members, the list has ${lis.length} items. Keep one \`li\` per member.`);
t.expect(lis[0].querySelector("img"), "The first member has a photo, but the list item has no `<img>`. Create one when `member.person.image !== null`, and `append` it to the `li`.");
t.expect(/Ann Example as Herself/.test(t.text(lis[0])), `The first item says "${t.text(lis[0])}". Add the text after the photo with \`item.append(...)\`, not \`textContent\`, which would remove the photo.`);
t.expect(!lis[1].querySelector("img"), "The second member has no photo (`null`), so their item shouldn't have an `<img>`.");
t.expect(/Bob Example as Himself/.test(t.text(lis[1])), "Members without a photo should still have their text.");
--- learned
`append` builds an element from parts, and an `if` on `null` keeps missing photos from breaking the list. Online, the cast now has faces.
--- summary
`append` mixes elements and text; check for `null` before using an optional object.


=== step average
title: The average rating of My List
minutes: 15
slot: js
bonus: yes
template: extras
--- explain
The My List view now has an empty line under its heading, `<p id="mylist-average">`. Fill it with the average rating of the shows in My List, like "Average rating: 8.9".

An average is the total divided by how many there are. Some shows have no rating (`null`), so leave them out: filter first, then add up with a loop.

```js
let total = 0;
for (const price of prices) {
  total = total + price;
}
const average = total / prices.length;
```

`toFixed(1)` shows a number with one decimal: `(26.7 / 3).toFixed(1)` is `"8.9"`.
--- task
1. At the top: `const myListAverage = document.querySelector("#mylist-average");`
2. At the end of `renderMyList`: keep the shows whose rating isn't `null`. If there are none, empty the line. Otherwise add up their ratings and show "Average rating: " with the average, to one decimal.
--- hint
`const rated = state.myList.filter((show) => show.rating !== null);` gives the shows to count. Divide by `rated.length`, not `state.myList.length`.
--- hint
```js
  const rated = state.myList.filter((show) => show.rating !== null);
  if (rated.length === 0) {
    myListAverage.textContent = "";
  } else {
    let total = 0;
    for (const show of rated) {
      total = total + show.rating;
    }
    myListAverage.textContent = "Average rating: " + (total / rated.length).toFixed(1);
  }
```
--- solution-replace
const myListEmpty = document.querySelector("#mylist-empty");
=>
const myListEmpty = document.querySelector("#mylist-empty");
const myListAverage = document.querySelector("#mylist-average");
--- solution-replace
  myListEmpty.hidden = state.myList.length > 0;
}
=>
  myListEmpty.hidden = state.myList.length > 0;

  // The average rating of the shows that have one
  const rated = state.myList.filter((show) => show.rating !== null);
  if (rated.length === 0) {
    myListAverage.textContent = "";
  } else {
    let total = 0;
    for (const show of rated) {
      total = total + show.rating;
    }
    myListAverage.textContent = "Average rating: " + (total / rated.length).toFixed(1);
  }
}
--- check
await t.sleep(450);
t.win.localStorage.setItem("myList", JSON.stringify([
  { id: 1001, name: "Sample A", image: null, genres: ["Drama"], rating: 8 },
  { id: 1002, name: "Sample B", image: null, genres: ["Comedy"], rating: 9 },
  { id: 1003, name: "Sample C", image: null, genres: [], rating: null },
]));
await t.rerun();
await t.click("#nav-mylist");
const text = t.text("#mylist-average");
t.win.localStorage.removeItem("myList");
t.expect(!t.$("#mylist-view").hidden, "The My List link should open the My List view. Look in the Console for an error.");
t.expect(text !== "", "The average line is empty. At the end of `renderMyList`, set `myListAverage.textContent`.");
t.expect(!/NaN/.test(text), `The average line says "${text}". Leave out the shows whose rating is \`null\` before adding up.`);
t.expect(/8\.5/.test(text), `With ratings 8, 9 and one without a rating, the line says "${text}". It should show 8.5: divide by the number of rated shows, and use \`toFixed(1)\`.`);
--- learned
Filter, loop, divide: a small calculation drawn in `render()`, so it's always up to date.
--- summary
Average: filter out `null`, add up in a loop, divide, `toFixed(1)`.
