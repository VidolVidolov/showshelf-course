// ---------- The show view ----------

// Open the show view for one show (a click on a card calls this)
function openShow(id) {
  state.view = "show";
  render();
  window.scrollTo(0, 0);   // start at the top of the page
}
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const home = t.$("#home-view"), showV = t.$("#show-view"), mine = t.$("#mylist-view");
const st = () => t.get("state");
t.expect(st().view === "home", "Add `view: \"home\",` to the `state` object: the page starts on the home view.");
t.expect(await t.waitFor(() => t.$$("#grid .card").length === 12, 3000), "The home view should load 12 shows. Look in the Console for an error.");
t.expect(!home.hidden && showV.hidden && mine.hidden, "At the start only the home view should show. At the top of `render()`, set `homeView.hidden`, `showView.hidden` and `myListView.hidden` from `state.view`.");
await t.click(t.$$("#grid .card h3")[1]);
t.expect(st().view === "show", "Clicking a card didn't change `state.view`. In `createCard`, add a click listener to `card` that calls `openShow(show.id)`, and in `openShow` set `state.view = \"show\";` (the TODO).");
t.expect(!showV.hidden && home.hidden, "`state.view` is \"show\", but the page didn't switch views. Call `render();` in `openShow`, and check the three `hidden` lines at the top of `render()`.");
st().view = "mylist";
t.get("render")();
t.expect(!mine.hidden && home.hidden && showV.hidden, "When `state.view` is \"mylist\", only the My List view should show. Check the line `myListView.hidden = state.view !== \"mylist\";`.");
st().view = "home";
t.get("render")();
t.expect(!home.hidden && showV.hidden && mine.hidden, "When `state.view` is \"home\", the home view should come back and the others should hide.");
await t.click(t.$$("#grid .card .list-btn")[0]);
const viewAfterPlus = st().view;
await t.click(t.$$("#grid .card .list-btn")[0]);
st().view = "home";
t.get("render")();
t.expect(viewAfterPlus === "home", "Clicking the + button also opened the show. In `createListButton`, give the listener an `event` parameter and call `event.stopPropagation();` first.");
--- learned
Views are state too. `render()` shows one `<section>` and hides the others, and `stopPropagation()` keeps a click on the + button from also counting as a click on the card.
--- summary
Views in one page: `state.view` plus `hidden` in `render()`. `event.stopPropagation()` stops bubbling.
--- mistakes
- `homeView.hidden = state.view === "home";`: the wrong way round, so the home view hides exactly when it should show.
- `card.addEventListener("click", openShow(show.id))`: this calls `openShow` straight away for every card.
- Forgetting `event` in `(event) => { ... }`, so `event.stopPropagation()` fails.


=== step get-show
title: One show, with cast and seasons
minutes: 15
slot: js
--- explain
To fill the show view, we need one show by its id. TVmaze has an address for that: `/shows/431` gives Friends.

We also want the cast and the seasons. We could ask three times, but TVmaze can **embed** them in the same answer when you ask for it in the query string:

`https://api.tvmaze.com/shows/431?embed[]=cast&embed[]=seasons`

[Open it in a new tab](https://api.tvmaze.com/shows/431?embed[]=cast&embed[]=seasons) and scroll to the end: the extras are in a property called `_embedded`.

```json
{
  "id": 431,
  "name": "Friends",
  ...
  "_embedded": {
    "cast": [ { "person": { "name": "Jennifer Aniston" }, "character": { "name": "Rachel Green" } }, ... ],
    "seasons": [ { "number": 1, "episodeOrder": 24, "premiereDate": "…" }, ... ]
  }
}
```

A function can give back several things at once by returning an **object**: `return { show: ..., cast: ..., seasons: ... };`
--- task
1. Fill in the TODO in `getShowById`: return an object with three properties, `show`, `cast` and `seasons`.
2. Make `openShow` an `async function`, and at its end add `const data = await getShowById(id);` and `console.log(data.show.name);`.

Click a card and look at the Console.
--- starter-append
// Ask TVmaze for one show, with its cast and seasons in the same answer
// getShowById(431) -> { show: {...our shape...}, cast: [...], seasons: [...] }
async function getShowById(id) {
  const response = await fetch(`${API}/shows/${id}?embed[]=cast&embed[]=seasons`);
  if (!response.ok) {
    throw new Error("TVmaze answered " + response.status);
  }
  const data = await response.json();
  // TODO: give back an object with three properties:
  //   show:    the show in our shape, toShow(data)
  //   cast:    data._embedded.cast
  //   seasons: data._embedded.seasons
}
--- hint
The `return` is an object literal with three `name: value` pairs, separated by commas.
--- hint
```js
  return {
    show: toShow(data),
    cast: data._embedded.cast,
    seasons: data._embedded.seasons,
  };
```
```js
async function openShow(id) {
  state.view = "show";
  render();
  window.scrollTo(0, 0);
  const data = await getShowById(id);
  console.log(data.show.name);
}
```
--- solution-replace
function openShow(id) {
  state.view = "show";
  render();
  window.scrollTo(0, 0);   // start at the top of the page
}
=>
async function openShow(id) {
  state.view = "show";
  render();
  window.scrollTo(0, 0);   // start at the top of the page
  const data = await getShowById(id);
  console.log(data.show.name);
}
--- solution-append
// Ask TVmaze for one show, with its cast and seasons in the same answer
// getShowById(431) -> { show: {...our shape...}, cast: [...], seasons: [...] }
async function getShowById(id) {
  const response = await fetch(`${API}/shows/${id}?embed[]=cast&embed[]=seasons`);
  if (!response.ok) {
    throw new Error("TVmaze answered " + response.status);
  }
  const data = await response.json();
  return {
    show: toShow(data),
    cast: data._embedded.cast,
    seasons: data._embedded.seasons,
  };
}
--- check
