--- file helpers.js
// helpers.js: small helper functions (read only)

// ratingLabel(9.2) -> "Must watch", ratingLabel(7.5) -> "Worth a try", ratingLabel(5) -> "Skip it"
function ratingLabel(rating) {
  if (rating >= 8.5) {
    return "Must watch";
  } else if (rating >= 7) {
    return "Worth a try";
  } else {
    return "Skip it";
  }
}

// yearsLabel(1994, 2004) -> "1994–2004", yearsLabel(2019, 2019) -> "2019",
// yearsLabel(2019, null) -> "2019–now" (still running), yearsLabel(null, null) -> ""
function yearsLabel(premiered, ended) {
  if (!premiered) {
    return "";
  }
  if (!ended) {
    return premiered + "–now";
  }
  if (premiered === ended) {
    return String(premiered);
  }
  return premiered + "–" + ended;
}

// getByGenre(shows, "Comedy") -> only the shows that have this genre
function getByGenre(list, genre) {
  return list.filter((show) => show.genres.includes(genre));
}

// allGenres(shows) -> ["Action", "Adventure", "Comedy", ...]: every genre once, from A to Z
function allGenres(list) {
  const result = [];
  for (const show of list) {
    for (const genre of show.genres) {
      if (!result.includes(genre)) {
        result.push(genre);
      }
    }
  }
  return result.sort();
}

// ---------- Helpers for TVmaze's data ----------

// stripTags("<p><b>Dark</b> is a mystery.</p>") -> "Dark is a mystery."
// TVmaze writes its summaries in HTML. We keep only the text.
function stripTags(html) {
  if (!html) {
    return "";
  }
  return html.replace(/<[^>]*>/g, "").replace(/&amp;/g, "&").trim();
}

// yearOf("2019-06-21") -> 2019, yearOf(null) -> null
function yearOf(date) {
  if (!date) {
    return null;
  }
  return Number(date.slice(0, 4));
}

// toShow(apiShow): one show in TVmaze's shape -> one show in OUR shape.
// Some of TVmaze's fields can be null, so each one gets a safe value.
function toShow(apiShow) {
  let network = "";
  if (apiShow.network) {
    network = apiShow.network.name;
  } else if (apiShow.webChannel) {
    network = apiShow.webChannel.name;   // streaming shows have a web channel instead
  }

  let image = null;
  if (apiShow.image) {
    image = apiShow.image.medium;        // the medium-sized poster
  }

  let rating = null;
  if (apiShow.rating) {
    rating = apiShow.rating.average ?? null;
  }

  return {
    id: apiShow.id,
    name: apiShow.name,
    genres: apiShow.genres ?? [],
    rating: rating,
    premiered: yearOf(apiShow.premiered),
    ended: yearOf(apiShow.ended),
    runtime: apiShow.averageRuntime ?? apiShow.runtime ?? null,
    network: network,
    image: image,
    summary: stripTags(apiShow.summary),
  };
}

--- default js
// app.js: ShowShelf (Day 9)
// This is the finished app from Day 8, tidied into sections.
// Today's page has three views: home, show and My List. Open the whole-page tab to see them.
// New lines for today say "Day 9" in their comments.
// Loaded before this file (open the read-only tab to see it):
//   helpers.js -> ratingLabel, yearsLabel, getByGenre, allGenres, yearOf, toShow, stripTags

// ---------- Elements: the parts of the page we change ----------
const grid = document.querySelector("#grid");
const searchInput = document.querySelector("#search");
const searchForm = document.querySelector("#search-form");
const emptyMessage = document.querySelector("#empty-message");
const genresBox = document.querySelector("#genres");
const listCount = document.querySelector("#list-count");
const statusMessage = document.querySelector("#status");

// Day 9: the three views, and the header links that switch between them
const homeView = document.querySelector("#home-view");
const showView = document.querySelector("#show-view");
const myListView = document.querySelector("#mylist-view");
const logoLink = document.querySelector("#logo");
const homeLink = document.querySelector("#nav-home");
const myListLink = document.querySelector("#nav-mylist");

// Day 9: the parts of the show view
const backButton = document.querySelector("#back-button");
const showStatus = document.querySelector("#show-status");
const showDetails = document.querySelector("#show-details");
const showPoster = document.querySelector("#show-poster");
const showName = document.querySelector("#show-name");
const showMeta = document.querySelector("#show-meta");
const showRating = document.querySelector("#show-rating");
const showGenres = document.querySelector("#show-genres");
const showSummary = document.querySelector("#show-summary");
const showListButton = document.querySelector("#show-list-button");
const castList = document.querySelector("#show-cast");
const seasonsBody = document.querySelector("#show-seasons");

// Day 9: the parts of the My List view
const myListGrid = document.querySelector("#mylist-grid");
const myListEmpty = document.querySelector("#mylist-empty");

// ---------- State: everything on the page that can change ----------
const state = {
  shows: [],      // the shows on the home page, from TVmaze (in our shape)
  genre: "",      // the chosen genre ("" means all genres)
  myList: JSON.parse(localStorage.getItem("myListIds")) ?? [],   // saved TVmaze ids, or an empty list
};

// ---------- TVmaze: asking for data ----------

// The address of the TVmaze API. Every request starts with it.
const API = "https://api.tvmaze.com";

// The search address: searchUrl("the office") -> ".../search/shows?q=the%20office"
function searchUrl(term) {
  return `${API}/search/shows?q=${encodeURIComponent(term)}`;
}

// Search TVmaze. Gives back a list of shows in OUR shape, ready for createCard.
async function searchShows(term) {
  const response = await fetch(searchUrl(term));
  if (!response.ok) {
    throw new Error("TVmaze answered " + response.status);   // stop here: we have no shows
  }
  const results = await response.json();
  return results.map((result) => toShow(result.show));
}

// Page 0 of TVmaze's list of shows: the first 250
async function getShowsPage() {
  const response = await fetch(`${API}/shows?page=0`);
  if (!response.ok) {
    throw new Error("TVmaze answered " + response.status);
  }
  const apiShows = await response.json();
  return apiShows.map(toShow);
}

// Load the shows for the home page (page 0 when the search is empty),
// with a loading message, an error message, and a message when nothing is found
async function loadShows(term) {
  statusMessage.textContent = "Loading shows…";
  statusMessage.classList.remove("error");
  statusMessage.hidden = false;
  emptyMessage.hidden = true;   // an old "nothing found" doesn't belong to the new search
  try {
    if (term === "") {
      state.shows = await getShowsPage();   // empty search box: the first page of shows
    } else {
      state.shows = await searchShows(term);
    }
    statusMessage.hidden = true;
    state.genre = "";   // the new shows may not have the chosen genre
    emptyMessage.textContent = `No shows found for "${term}". Try another word.`;
    render();
  } catch (error) {
    // No internet, or TVmaze answered with an error: tell the person, in red
    statusMessage.textContent = "Sorry, the shows could not be loaded (" + error.message + "). Check your internet connection and try again.";
    statusMessage.classList.add("error");
  }
}

// ---------- One card for one show ----------
// createCard(show) builds a card and gives it back. It doesn't put it on the page.
function createCard(show) {
  const card = document.createElement("article");
  card.className = "card";

  const poster = document.createElement("img");
  poster.className = "poster";
  poster.src = show.image ?? "poster.svg";   // no picture (null)? use poster.svg
  poster.alt = "";                           // the name is under the poster, so no alt text
  poster.loading = "lazy";                   // load the picture only when it scrolls into view

  const body = document.createElement("div");
  body.className = "card-body";

  // Real shows can have no genres at all, so only add a badge when there is one
  if (show.genres.length > 0) {
    const badge = document.createElement("span");
    badge.className = "badge";
    badge.textContent = show.genres[0];
    body.append(badge);
  }

  const title = document.createElement("h3");
  title.textContent = show.name;

  // Real shows can have no rating yet (null)
  const rating = document.createElement("p");
  rating.className = "rating";
  if (show.rating === null) {
    rating.textContent = "No rating yet";
  } else {
    rating.textContent = "★ " + show.rating + " · " + ratingLabel(show.rating);
  }

  const meta = document.createElement("p");
  meta.className = "meta";
  meta.textContent = yearsLabel(show.premiered, show.ended);

  body.append(title, rating, meta);
  card.append(poster, body);
  card.append(createListButton(show));
  return card;
}

// The round button on a card: "+" adds the show, "✓" means it's in My List
function createListButton(show) {
  const button = document.createElement("button");
  button.className = "list-btn";
  if (isInMyList(show.id)) {
    button.textContent = "✓";
  } else {
    button.textContent = "+";
  }
  button.setAttribute("aria-pressed", isInMyList(show.id));   // "pressed" look, and for screen readers
  button.setAttribute("aria-label", "My List: " + show.name);
  button.addEventListener("click", () => {
    toggleMyList(show);
  });
  return button;
}

// ---------- Draw the page from the state ----------

// Draw a list of shows in the grid
function renderGrid(list) {
  grid.replaceChildren();   // remove the old cards first
  for (const show of list) {
    grid.append(createCard(show));
  }
  emptyMessage.hidden = list.length > 0;   // show the message only when there are no shows
}

function render() {
  let list = state.shows;
  if (state.genre !== "") {
    list = getByGenre(list, state.genre);
  }

  renderGrid(list);
  renderGenres();
  listCount.textContent = state.myList.length;
}

// One button (a "chip") per genre. The chosen one gets the class "active".
function renderGenres() {
  genresBox.replaceChildren();
  for (const genre of allGenres(state.shows)) {
    const chip = document.createElement("button");
    chip.className = "chip";
    chip.textContent = genre;
    if (genre === state.genre) {
      chip.classList.add("active");
    }
    chip.addEventListener("click", () => {
      if (state.genre === genre) {
        state.genre = "";      // clicked the chosen genre again: all genres
      } else {
        state.genre = genre;
      }
      render();
    });
    genresBox.append(chip);
  }
}

// ---------- My List ----------

// Is this show in My List? Gives true or false.
function isInMyList(id) {
  return state.myList.includes(id);
}

// Add the show to My List, or take it out if it's already there
function toggleMyList(show) {
  if (isInMyList(show.id)) {
    state.myList = state.myList.filter((id) => id !== show.id);
  } else {
    state.myList.push(show.id);
  }
  saveMyList();
  render();
}

// Save My List in the browser (localStorage keeps text only, so we turn it into JSON text)
function saveMyList() {
  localStorage.setItem("myListIds", JSON.stringify(state.myList));
}

// ---------- Events: what happens when someone uses the page ----------

// Pressing Enter or Search asks TVmaze
searchForm.addEventListener("submit", (event) => {
  event.preventDefault();   // don't reload the page
  loadShows(searchInput.value.trim());
});

// ---------- Credit: TVmaze's data is free to use if we say where it comes from ----------
const credit = document.createElement("a");
credit.href = "https://www.tvmaze.com";
credit.textContent = "Data from TVmaze";
document.querySelector(".site-footer p").append(" · ", credit);

// ---------- Start: load the first shows from TVmaze ----------
loadShows("");

// ========== The show view and My List (new on Day 9) ==========


=== step open-show
title: Three views, one page
minutes: 20
slot: js
--- explain
A **view** is one screen of an app. ShowShelf now has three, and they're all in the same page: three `<section>` elements, of which only one is visible at a time.

Which view is showing is part of the state: `state.view` is `"home"`, `"show"` or `"mylist"`. And like everything else, `render()` draws it. One line per view:

```js
cartPanel.hidden = state.panel !== "cart";   // hidden unless the panel is "cart"
```

To open a show, a click on a card changes `state.view` and calls `render()`.

One trap: the round + button is **inside** the card. A click on it also counts as a click on the card, because events **bubble** up from an element to everything around it. So the + button would open the show too. `event.stopPropagation()` stops the click from going any further up:

```js
likeButton.addEventListener("click", (event) => {
  event.stopPropagation();   // don't also count as a click on the post around it
  like(post);
});
```
--- task
1. In `state`, add `view: "home",`.
2. At the top of `render()`, add three lines that hide every view except the one in `state.view` (`homeView`, `showView` and `myListView`).
3. Fill in the TODO in `openShow`.
4. In `createCard`, before `return card;`, add a click listener to the card that calls `openShow(show.id)`.
5. In `createListButton`, give the listener an `event` parameter and call `event.stopPropagation();` first.

Click a card: the home view disappears. (The show view is empty for now.) Press **Run again** to go back.
