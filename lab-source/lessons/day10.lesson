--- template server
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My List manager · ShowShelf</title>
  <link rel="stylesheet" href="style.css">
  <style>
    .server-says { font-size: 0.9rem; color: var(--color-muted); }
    .server-says.ok { color: #1e7d4f; font-weight: 600; }
    .server-says.bad { color: #c0392b; }
    .hero { padding: 28px 0 20px; }
    .notice { max-width: 640px; margin: 0 auto 12px; padding: 10px 14px; border-radius: 8px; background-color: var(--color-surface); border: 1px solid var(--color-border); border-left-width: 4px; }
    .notice:empty { display: none; }
    .notice.good { border-left-color: #1e7d4f; }
    .notice.bad { border-left-color: #c0392b; color: #c0392b; }
    .status:empty { display: none; }
    .status { padding: 16px 0; }
    .mylist { list-style: none; padding: 0; margin: 0 auto 32px; max-width: 640px; display: grid; gap: 8px; }
    .mylist li { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; padding: 10px 14px; background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); }
    .mylist .name { font-weight: 600; flex: 1; min-width: 120px; }
    .mylist .id { font-size: 0.8rem; color: var(--color-muted); }
    .mylist select { font: inherit; font-size: 0.9rem; padding: 6px 8px; border-radius: 8px; border: 1px solid var(--color-border); background-color: var(--color-surface); color: var(--color-text); }
    .mylist button { padding: 6px 12px; font-size: 0.9rem; }
    .try { max-width: 640px; margin: 0 auto 48px; padding: 16px; background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); }
    .try h2 { margin: 0 0 4px; font-size: 1.1rem; }
    .try p { margin: 0 0 12px; color: var(--color-muted); font-size: 0.9rem; }
    .try-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .try select, .try input, .try textarea { font: inherit; padding: 8px 10px; border: 1px solid var(--color-border); border-radius: 8px; background-color: var(--color-bg); color: var(--color-text); }
    .try input, .try textarea { font-family: ui-monospace, Consolas, monospace; font-size: 0.9rem; }
    .try input { flex: 1; min-width: 140px; }
    .try textarea { display: block; width: 100%; margin-top: 8px; }
    .try pre { margin: 12px 0 0; padding: 10px 12px; min-height: 2.6em; background-color: #1c1b29; color: #f1f0f7; border-radius: 8px; white-space: pre-wrap; font-size: 0.85rem; }
  </style>
  <!-- The pretend Express server. A real one runs in Node.js, not in the page. -->
  <script>{{asset:expressLite}}</script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <span class="logo">ShowShelf</span>
      <span class="server-says" id="hello">Asking the server...</span>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>My List manager</h1>
      <p>This page is fixed. Everything in the list comes from your server.js.</p>
      <form class="search" id="addForm">
        <input id="name" type="text" placeholder="A show name, like Fleabag" aria-label="Show name" autocomplete="off">
        <button type="submit">Add</button>
      </form>
    </section>

    <p class="notice" id="notice" aria-live="polite"></p>
    <p class="status" id="status">Loading My List...</p>
    <ul class="mylist" id="list"></ul>

    <section class="try">
      <h2>Try a request</h2>
      <p>Send any request to your server and see its answer.</p>
      <form id="tryForm">
        <div class="try-row">
          <select id="tryMethod" aria-label="Method">
            <option>GET</option>
            <option>POST</option>
            <option>PATCH</option>
            <option>DELETE</option>
          </select>
          <input id="tryPath" value="/api/hello" aria-label="Address">
          <button type="submit">Send</button>
        </div>
        <textarea id="tryBody" rows="2" aria-label="Body (JSON)">{ "name": "Fleabag" }</textarea>
      </form>
      <pre id="tryOut">The answer appears here.</pre>
    </section>
  </main>

  <!-- Your server.js. In a real project it runs on the server, not in the page. -->
  <script>
{{slot:server}}
  </script>

  <!-- The page's own JavaScript. It only talks to the server with fetch. -->
  <script>
  (function () {
    const NAMES = { 200: "OK", 201: "Created", 204: "No Content", 400: "Bad Request", 404: "Not Found", 500: "Internal Server Error", 504: "No answer" };
    const OFFLINE = "The page couldn't reach the server. Look for a red error in the Console: server.js has to run without errors.";
    const $ = (id) => document.getElementById(id);

    // Send one request to the server and read its answer
    async function ask(method, path, body) {
      const options = { method: method };
      if (body !== undefined) {
        options.headers = { "Content-Type": "application/json" };
        options.body = JSON.stringify(body);
      }
      const response = await fetch(path, options);
      const text = await response.text();
      let data = text;
      try { data = text ? JSON.parse(text) : null; } catch (e) { /* not JSON: keep the text */ }
      return { status: response.status, data: data };
    }

    const codeText = (status) => status + " " + (NAMES[status] || "");
    const errorOf = (data) => (data && typeof data === "object" && data.error ? String(data.error) : "");

    // Explain an answer that wasn't a success
    function problem(method, path, r) {
      const error = errorOf(r.data);
      let text = method + " " + path + " answered " + codeText(r.status) + (error ? ": " + error : "");
      if (r.status === 404 && /^Cannot |not for /.test(error)) text += ". Your server has no route for this yet.";
      if (r.status === 500) text += ". Your route crashed: read the red error in the Console.";
      if (r.status === 504) text += ". Your route never answered: end it with res.json(...).";
      return text;
    }

    function notice(text, good) {
      $("notice").textContent = text;
      $("notice").className = "notice " + (good ? "good" : "bad");
    }

    async function hello() {
      const el = $("hello");
      try {
        const r = await ask("GET", "/api/hello");
        if (r.status === 200 && r.data && r.data.message) {
          el.textContent = "Server says: " + r.data.message;
          el.className = "server-says ok";
        } else if (r.status === 200) {
          el.textContent = "GET /api/hello answered, but without a message";
          el.className = "server-says bad";
        } else {
          el.textContent = "GET /api/hello: " + codeText(r.status);
          el.className = "server-says bad";
        }
      } catch (e) {
        el.textContent = "No server running";
        el.className = "server-says bad";
      }
    }

    async function loadList() {
      const status = $("status");
      try {
        const r = await ask("GET", "/api/mylist");
        if (r.status !== 200) {
          $("list").innerHTML = "";
          status.textContent = problem("GET", "/api/mylist", r);
          status.className = "status error";
        } else if (!Array.isArray(r.data)) {
          $("list").innerHTML = "";
          status.textContent = "GET /api/mylist should answer with an array [ ... ] of shows. It sent: " + JSON.stringify(r.data);
          status.className = "status error";
        } else {
          render(r.data);
        }
      } catch (e) {
        $("list").innerHTML = "";
        status.textContent = OFFLINE;
        status.className = "status error";
      }
    }

    function render(items) {
      const list = $("list");
      list.innerHTML = "";
      $("status").className = "status";
      $("status").textContent = items.length ? "" : "My List is empty. Add a show above.";
      items.forEach((item) => {
        item = item || {};
        const li = document.createElement("li");
        const name = document.createElement("span");
        name.className = "name";
        name.textContent = item.name != null && item.name !== "" ? item.name : "(no name)";
        const id = document.createElement("span");
        id.className = "id";
        id.textContent = "id " + item.id;
        li.append(name, id);
        // A menu for the status, only when the server sends one (extra challenge)
        if (item.status !== undefined) {
          const select = document.createElement("select");
          select.setAttribute("aria-label", "Status of " + name.textContent);
          ["want", "watching", "watched"].forEach((value) => select.append(new Option(value, value)));
          select.value = item.status;
          select.addEventListener("change", () => changeStatus(item, select.value));
          li.append(select);
        }
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "remove";
        remove.textContent = "Remove";
        remove.setAttribute("aria-label", "Remove " + name.textContent);
        remove.addEventListener("click", () => removeItem(item));
        li.append(remove);
        list.append(li);
      });
    }

    async function add(event) {
      event.preventDefault();
      const input = $("name");
      const name = input.value.trim();
      try {
        const r = await ask("POST", "/api/mylist", { name: name });
        if (r.status === 201 || r.status === 200) {
          notice("Added " + (r.data && r.data.name ? r.data.name : name) + " (" + codeText(r.status) + ")", true);
          input.value = "";
        } else {
          notice(problem("POST", "/api/mylist", r), false);
        }
        loadList();
      } catch (e) {
        notice(OFFLINE, false);
      }
    }

    async function removeItem(item) {
      const path = "/api/mylist/" + item.id;
      try {
        const r = await ask("DELETE", path);
        if (r.status === 204 || r.status === 200) notice("Removed " + item.name + " (" + codeText(r.status) + ")", true);
        else notice(problem("DELETE", path, r), false);
        loadList();
      } catch (e) {
        notice(OFFLINE, false);
      }
    }

    async function changeStatus(item, value) {
      const path = "/api/mylist/" + item.id;
      try {
        const r = await ask("PATCH", path, { status: value });
        if (r.status === 200) notice(item.name + " is now \"" + (r.data && r.data.status) + "\" (" + codeText(r.status) + ")", true);
        else notice(problem("PATCH", path, r), false);
        loadList();
      } catch (e) {
        notice(OFFLINE, false);
      }
    }

    // The "Try a request" box
    function methodChanged() {
      const m = $("tryMethod").value;
      $("tryBody").hidden = !(m === "POST" || m === "PATCH");
    }

    async function tryIt(event) {
      event.preventDefault();
      const method = $("tryMethod").value;
      const path = $("tryPath").value.trim();
      const out = $("tryOut");
      if (path[0] !== "/") { out.textContent = "The address should start with /, like /api/mylist"; return; }
      let body;
      if (method === "POST" || method === "PATCH") {
        try { body = JSON.parse($("tryBody").value || "{}"); }
        catch (e) { out.textContent = "The body isn't valid JSON. Use double quotes, like { \"name\": \"Fleabag\" }"; return; }
      }
      out.textContent = "Waiting for the server...";
      try {
        const r = await ask(method, path, body);
        const shown = r.data === null || r.data === "" ? "(no body)" : typeof r.data === "string" ? r.data : JSON.stringify(r.data, null, 2);
        out.textContent = method + " " + path + "  →  " + codeText(r.status) + "\n\n" + shown;
        if (method !== "GET") loadList();
      } catch (e) {
        out.textContent = OFFLINE;
      }
    }

    $("addForm").addEventListener("submit", add);
    $("tryForm").addEventListener("submit", tryIt);
    $("tryMethod").addEventListener("change", methodChanged);
    methodChanged();
    hello();
    loadList();
  })();
  </script>
</body>
</html>


=== step first-component
title: Your first React component
minutes: 15
slot: app
template: react
--- explain
**React** is a JavaScript library for building pages out of **components**: small, reusable pieces like "a show card" or "a search box". A component is a function that returns what it should look like:

```jsx
function Welcome() {
  return <p>Welcome back!</p>;
}

ReactDOM.createRoot(document.getElementById("root")).render(<Welcome />);
```

- `<p>Welcome back!</p>` inside JavaScript is **JSX**: HTML-looking code that React turns into real elements. It isn't a string, so there are no quotes around it.
- A component's name starts with a **capital letter**. You use it like a tag: `<Welcome />`.
- The last line tells React: "draw `Welcome` inside the element with the id `root`". Open the **index.html (whole page)** tab: the page is an empty `<div id="root"></div>`, and React fills it.

JSX is almost HTML, with one difference you'll meet often: `class` is a special word in JavaScript, so in JSX you write **`className`** instead, like `<p className="meta">`.

> In a real project, React is installed with a tool (this morning you saw Vite) and each component lives in its own file. Here `React` and `ReactDOM` are already loaded, and your code box is the file **App.jsx**.
--- task
1. Write a component called `App` that returns a main heading: `<h1>ShowShelf</h1>`.
2. Under it, add the line that draws `<App />` inside `#root`.
--- hint
A component is a normal function whose name starts with a capital letter. Inside it, `return` the JSX. Then copy the `ReactDOM.createRoot(...)` line from the example and change `Welcome` to `App`.
--- hint
```jsx
function App() {
  return <h1>ShowShelf</h1>;
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
```
--- solution-append
function App() {
  return <h1>ShowShelf</h1>;
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
--- check
const App = t.get("App");
if (typeof App !== "function") {
  t.expect(typeof t.get("app") !== "function", "Your function is called `app`. Component names must start with a capital letter: `App`.");
  t.expect(!t.errors.length, "Your code has an error, so it didn't run. Read the red message in the Console: it names the line.");
  t.fail("I can't find a component called `App` yet. Write `function App() { ... }` with a capital A.");
}
const drawn = await t.waitFor(() => t.$("#root").innerHTML.trim() !== "", 2000);
if (!drawn) {
  t.expect(!t.errors.length, "Your code has an error, so React drew nothing. Read the red message in the Console: it names the line.");
  t.expect(/\.render\s*\(/.test(t.clean), "Your `App` is ready, but nothing draws it yet. Add the last line: `ReactDOM.createRoot(document.getElementById(\"root\")).render(<App />);`");
  t.fail("Nothing appeared inside `#root`. Check that `App` has a `return`, and that the last line draws `<App />` (with the angle brackets).");
}
t.expect(!/<h1/i.test(t.text("#root")), "The tags appear as text on the page. Remove the quotes around the JSX: `return <h1>ShowShelf</h1>;`.");
const h1 = t.$("#root h1");
t.expect(h1, "React drew something, but I can't find an `<h1>`. Make `App` return `<h1>ShowShelf</h1>`.");
t.expect(/showshelf/i.test(t.text(h1)), `Your heading says "${t.text(h1)}". It should say **ShowShelf**.`);
--- learned
You wrote a **component** (a function that returns JSX) and asked React to draw it. From now on you describe *what* the page should look like, and React makes the elements.
--- summary
A React component is a function that returns JSX; `createRoot(...).render(<App />)` draws it.
--- mistakes
- A small letter: `function app()` and `<app />`. React treats lowercase tags as HTML elements.
- Forgetting the render line, so nothing appears.
- Quotes around the JSX: `return "<h1>ShowShelf</h1>";` shows the tags as text.
--- teacher
If the preview stays empty, open the Console first: JSX mistakes come with a line number. The Lab translates the JSX into plain JavaScript before running it, so `import` lines don't work here (and aren't needed).


=== step jsx-values
title: JavaScript values inside JSX
minutes: 10
slot: app
template: react
--- explain
Inside JSX, curly brackets `{ }` mean "this part is JavaScript: work it out and show the result":

```jsx
const city = "Springfield";

function Header() {
  return <p>Welcome to {city}! 2 + 2 is {2 + 2}.</p>;
}
```

This shows *Welcome to Springfield! 2 + 2 is 4.*

Two more JSX rules for bigger pieces:

- A component returns **one** outer element. Everything else goes inside it.
- When the JSX takes several lines, put it in round brackets `( )` after `return`.

```jsx
function Header() {
  return (
    <header className="site-header">
      <h1>{city}</h1>
      <p>{city.length} letters long</p>
    </header>
  );
}
```

> The list of shows is ready in a variable called `shows` (look at the whole page tab). How many are there? `shows.length` knows.
--- task
Make `App` return this structure, with the classes of the ShowShelf stylesheet:

1. an outer `<main className="container">`
2. inside it, a `<section className="hero">` with your `<h1>ShowShelf</h1>`
3. under the heading, a paragraph that says **12 shows to choose from**, where the number comes from `{shows.length}`
--- hint
Replace `return <h1>ShowShelf</h1>;` with `return ( ... );` and put the three elements inside the brackets, one inside the other. The paragraph is `<p>{shows.length} shows to choose from</p>`.
--- hint
```jsx
function App() {
  return (
    <main className="container">
      <section className="hero">
        <h1>ShowShelf</h1>
        <p>{shows.length} shows to choose from</p>
      </section>
    </main>
  );
}
```
--- solution-replace
  return <h1>ShowShelf</h1>;
=>
  return (
    <main className="container">
      <section className="hero">
        <h1>ShowShelf</h1>
        <p>{shows.length} shows to choose from</p>
      </section>
    </main>
  );
--- check
t.expect(await t.waitFor(() => t.$("#root h1"), 2000), "I can't see your `<h1>` any more. Look for a red error in the Console: often a bracket is missing, or App returns two elements side by side.");
t.expect(!t.logs.some((l) => /Invalid DOM property/.test(l.text) && /\bclass\b/.test(l.text)), "In JSX, write `className`, not `class`: `<main className=\"container\">`.");
const hero = t.$("#root .hero");
t.expect(hero, "I can't find the element with `className=\"hero\"`. Put a `<section className=\"hero\">` around the heading.");
t.expect(hero.querySelector("h1"), "Put your `<h1>` inside the hero section.");
t.expect(t.$("#root .container"), "Put everything inside `<main className=\"container\">`: it's the one outer element that App returns.");
t.expect(t.$("#root .container .hero"), "The hero section goes inside the `<main>` element.");
const p = hero.querySelector("p");
t.expect(p, "Add a paragraph `<p>` under the heading, inside the hero section.");
t.expect(/\b12\b/.test(t.text(p)), `Your paragraph says "${t.text(p)}". It should show the number of shows: \`{shows.length} shows to choose from\`.`);
t.expect(/\{\s*shows\.length\s*\}/.test(t.clean), "The number is right, but write it as `{shows.length}` instead of typing 12, so it always matches the real list.");
--- learned
`{ }` puts JavaScript into JSX. The number comes from the data, so if the list changes, the page follows.
--- summary
`{ }` in JSX shows the result of JavaScript; a component returns one outer element.
--- mistakes
- Returning two elements side by side without one element around them.
- Forgetting the `( )` after `return` on a multi-line JSX, so `return` returns nothing.
- `class=` instead of `className=` (React warns in the Console).


=== step show-card
title: A ShowCard component with props
minutes: 20
slot: app
template: react
--- explain
Components get their **input** through **props** (short for *properties*). You pass them like HTML attributes, and the component receives them:

```jsx
function Greeting({ name }) {
  return <p>Hello, {name}!</p>;
}

<Greeting name="Homer" />     // Hello, Homer!
<Greeting name="Marge" />     // Hello, Marge!
```

- `name="Homer"` passes text. To pass any other JavaScript value (a number, an object), use curly brackets: `<Greeting name={someone.name} />`.
- `{ name }` in the round brackets of the function takes the prop called `name`, so you can use `name` inside.

One component, many results: that's the point. Like a function with a parameter, one `ShowCard` can show any show.

We've added the start of `ShowCard` at the bottom of your code. A function can be used before the line where it's written, so its place in the file doesn't matter.
--- task
1. In `ShowCard`, replace the two `TODO` comments with an `<h3>` that shows `show.name`, and a `<p className="rating">` that shows a star and `show.rating`, like **★ 8.8**. (`{/* ... */}` is how you write a comment inside JSX.)
2. In `App`, under the hero section (still inside `<main>`), add `<div className="grid">` with one card inside: `<ShowCard show={shows[0]} />`.
--- starter-append
// One card for one show. Its prop (input) is `show`: one object from the list.
function ShowCard({ show }) {
  return (
    <article className="card">
      <img className="poster" src="poster.svg" alt="" />
      <div className="card-body">
        <span className="badge">{show.genres[0]}</span>
        {/* TODO: an <h3> with the show's name */}
        {/* TODO: a <p className="rating"> with a star and the rating */}
      </div>
    </article>
  );
}
--- hint
Look at the badge line: `{show.genres[0]}` shows the first genre of the show it was given. The name and the rating work the same way: `{show.name}` and `{show.rating}`.
--- hint
In `ShowCard`:
```jsx
        <h3>{show.name}</h3>
        <p className="rating">★ {show.rating}</p>
```
And in `App`, after `</section>`:
```jsx
      <div className="grid">
        <ShowCard show={shows[0]} />
      </div>
```
--- solution-replace
      </section>
    </main>
=>
      </section>

      <div className="grid">
        <ShowCard show={shows[0]} />
      </div>
    </main>
--- solution-append
// One card for one show. Its prop (input) is `show`: one object from the list.
function ShowCard({ show }) {
  return (
    <article className="card">
      <img className="poster" src="poster.svg" alt="" />
      <div className="card-body">
        <span className="badge">{show.genres[0]}</span>
        <h3>{show.name}</h3>
        <p className="rating">★ {show.rating}</p>
      </div>
    </article>
  );
}
--- check
if (!(await t.waitFor(() => t.$("#root h1"), 2000))) {
  t.expect(!/show\s*=\s*["']/.test(t.clean), "`show=\"...\"` in quotes passes text, not a show. Use curly brackets: `<ShowCard show={shows[0]} />`.");
  t.fail("The page is empty. Look for a red error in the Console: it names the line.");
}
const ShowCard = t.get("ShowCard");
t.expect(typeof ShowCard === "function", "I can't find the `ShowCard` component. Press **Start again** to get its skeleton back.");
const card = await t.waitFor(() => t.$("#root .card"), 1500);
t.expect(card, "There's no card on the page yet. In `App`, under the hero section, add `<div className=\"grid\">` with `<ShowCard show={shows[0]} />` inside.");
t.expect(card.closest(".grid"), "Put the card inside `<div className=\"grid\">`, so it gets the grid layout.");
const h3 = card.querySelector("h3");
t.expect(h3, "The card has no `<h3>` yet. Replace the first TODO with `<h3>{show.name}</h3>`.");
const shows = t.get("shows");
const show = shows.find((s) => s.name === t.text(h3));
t.expect(show, `The card's heading says "${t.text(h3)}". It should show the name from the prop: \`{show.name}\`.`);
const rating = card.querySelector(".rating");
t.expect(rating, "Add the rating under the name: `<p className=\"rating\">★ {show.rating}</p>`.");
t.expect(t.text(rating).includes(String(show.rating)), `The rating line says "${t.text(rating)}". It should show \`{show.rating}\` (${show.rating} for ${show.name}).`);
// the same component with another show: does it really use the prop?
const other = shows.find((s) => s.name !== show.name && s.rating !== show.rating);
const box = t.doc.createElement("div");
try {
  t.win.ReactDOM.createRoot(box).render(t.win.React.createElement(ShowCard, { show: other }));
} catch (e) {
  t.fail("Your `ShowCard` crashed when I gave it another show: " + e.message);
}
await t.waitFor(() => box.querySelector("h3"), 1500);
t.expect(t.text(box.querySelector("h3")) === other.name, `I gave your ShowCard the show ${other.name}, but its heading said "${t.text(box.querySelector("h3"))}". Use the prop, \`{show.name}\`, instead of typing a name.`);
t.expect(t.text(box.querySelector(".rating")).includes(String(other.rating)), `I gave your ShowCard the show ${other.name} (rating ${other.rating}), but the rating line said "${t.text(box.querySelector(".rating"))}". Use \`{show.rating}\`.`);
--- learned
Props are a component's inputs. `ShowCard` doesn't know or care which show it gets: it shows whatever `show` you pass in.
--- summary
Props are a component's inputs: `<ShowCard show={...} />`, received as `function ShowCard({ show })`.
--- mistakes
- `show="shows[0]"` in quotes: that passes the text "shows[0]", not the object.
- `<h3>show.name</h3>` without curly brackets: the words appear as they are.
- `{name}` instead of `{show.name}`: the prop is the whole show object.


=== step card-list
title: A card for every show
minutes: 10
slot: app
template: react
--- explain
Arrays have a `map` method: it makes a new array by changing every item. In React, you use it to turn an array of data into an array of JSX:

```jsx
const cities = ["Springfield", "Shelbyville"];

<ul>
  {cities.map((city) => <li key={city}>{city}</li>)}
</ul>
```

React draws every element in the array. The **`key`** is a name tag that must be different for each item. React uses it to tell the items apart when the list changes (for example when you search). A unique id is the best key.

> When it works, remove the `key` for a moment and look at the Console: React complains in red. Then put it back.
--- task
In `App`, replace the single `<ShowCard show={shows[0]} />` with a card for **every** show: use `shows.map(...)`, and give each card `key={show.id}`.
--- hint
Inside the grid, write `{shows.map((show) => ...)}`. For each `show`, the arrow function returns one `<ShowCard ... />` with two props: `key` and `show`.
--- hint
```jsx
      <div className="grid">
        {shows.map((show) => <ShowCard key={show.id} show={show} />)}
      </div>
```
--- solution-replace
        <ShowCard show={shows[0]} />
=>
        {shows.map((show) => <ShowCard key={show.id} show={show} />)}
--- check
t.expect(await t.waitFor(() => t.$("#root h1"), 2000), "The page is empty. Look for a red error in the Console: it names the line.");
await t.waitFor(() => t.$$("#root .card").length >= 12, 1500);
const cards = t.$$("#root .card");
if (cards.length < 2) {
  t.expect(!(cards.length === 0 && /\.map\(\s*\(?\s*\w+\s*\)?\s*=>\s*\{/.test(t.clean)), "Your arrow function inside `map` has curly brackets `{ }` but no `return`, so it gives back nothing. Remove the `{ }`: `shows.map((show) => <ShowCard key={show.id} show={show} />)`.");
  t.fail(cards.length ? "There's still only one card. Replace it with `{shows.map((show) => <ShowCard key={show.id} show={show} />)}` inside the grid." : "There are no cards on the page. Inside the grid, write `{shows.map((show) => <ShowCard key={show.id} show={show} />)}`.");
}
t.expect(cards.length === 12, `I see ${cards.length} cards. There should be one per show: 12.`);
const shows = t.get("shows");
const names = cards.map((c) => t.text(c.querySelector("h3")));
t.expect(shows.every((s) => names.includes(s.name)), "Every card shows the same show. Pass the current item to each card: `show={show}`, not `show={shows[0]}`.");
t.expect(cards.every((c) => c.closest(".grid")), "Keep the cards inside `<div className=\"grid\">`.");
t.expect(!t.logs.some((l) => /unique "key"/.test(l.text)), "React warns in the Console that each card needs a `key`. Add `key={show.id}` to `<ShowCard ... />`.");
--- learned
`map` turns data into components. Add a show to the data and a card appears. The `key` helps React keep track of which card is which.
--- summary
`array.map((item) => <Comp key={item.id} ... />)` draws a list; each item needs a unique `key`.
--- mistakes
- `shows.map((show) => { <ShowCard show={show} /> })`: curly brackets without `return`, so no cards.
- `show={shows[0]}` inside the map: twelve cards of the same show.
- `key={show.name}` works here, but an id is safer: names can repeat.


=== step state
title: Remember something with state
minutes: 20
slot: app
template: react
--- explain
So far the page never changes. To react to clicks, a component needs **state**: a value it remembers, and that React watches.

```jsx
function LikeButton() {
  const [likes, setLikes] = React.useState(0);
  return <button onClick={() => setLikes(likes + 1)}>Likes: {likes}</button>;
}
```

- `React.useState(0)` creates a state value that starts at `0`. It gives back two things: the current value (`likes`) and a function that changes it (`setLikes`).
- `onClick={...}` is the click event, written in the JSX. Note the capital C.
- When you call `setLikes(...)`, React **draws the component again** with the new value. You never touch the page elements yourself.

Every card on the page is its own copy of `ShowCard`, so each card has its own state.

> In a real project you write `import { useState } from "react";` at the top of the file and then `useState(0)`. Here `React` is already loaded, so you write `React.useState`.
--- task
Give every card a My List button that switches between **＋** and **✓**:

1. At the top of `ShowCard` (before `return`), create state: `const [inList, setInList] = React.useState(false);`
2. Under the `<img>`, add a `<button>` with `className="list-btn"` and `aria-pressed={inList}`. When it's clicked, it calls `setInList(!inList)`.
3. The button's text is `{inList ? "✓" : "＋"}`. (A normal `+` is fine too.)

`!inList` means "the opposite of inList": `true` becomes `false`, and `false` becomes `true`. Click a few buttons in the preview.
--- hint
`onClick={() => setInList(!inList)}` goes in the button's opening tag, next to `className` and `aria-pressed`. The `useState` line goes inside `ShowCard`, above `return (`.
--- hint
```jsx
function ShowCard({ show }) {
  const [inList, setInList] = React.useState(false);

  return (
    <article className="card">
      <img className="poster" src="poster.svg" alt="" />
      <button className="list-btn" aria-pressed={inList} onClick={() => setInList(!inList)}>
        {inList ? "✓" : "＋"}
      </button>
      ...
```
--- solution-replace
function ShowCard({ show }) {
  return (
    <article className="card">
      <img className="poster" src="poster.svg" alt="" />
=>
function ShowCard({ show }) {
  const [inList, setInList] = React.useState(false);

  return (
    <article className="card">
      <img className="poster" src="poster.svg" alt="" />
      <button className="list-btn" aria-pressed={inList} onClick={() => setInList(!inList)}>
        {inList ? "✓" : "＋"}
      </button>
--- check
if (!(await t.waitFor(() => t.$$("#root .card").length >= 12, 2000))) {
  t.expect(!t.errors.some((e) => /Too many re-renders/.test(e)), "React draws again and again, because your `onClick` calls `setInList` straight away while drawing. Wrap it in an arrow function: `onClick={() => setInList(!inList)}`.");
  t.fail("The cards have gone. Look for a red error in the Console. Is the `useState` line inside `ShowCard`, before `return`?");
}
const btns = () => t.$$("#root .card .list-btn");
t.expect(btns().length >= 12, btns().length ? "Only some cards have a button. Put the button in `ShowCard`, so every card gets one." : "I can't find the buttons. Add `<button className=\"list-btn\" ...>` inside the card, under the `<img>`.");
const before = t.text(btns()[1]);
await t.click(btns()[1]);
await t.waitFor(() => t.text(btns()[1]) !== before, 1000);
const after = t.text(btns()[1]);
t.expect(after !== before, `I clicked the second card's button, but it still says "${before}". Add \`onClick={() => setInList(!inList)}\` to the button, and show \`{inList ? "✓" : "＋"}\` inside it.`);
t.expect(t.text(btns()[0]) === before, "Clicking one card changed another card too. Put the `useState` line inside `ShowCard`, so every card has its own state.");
t.expect(btns()[1].getAttribute("aria-pressed") === "true", "The text changes. Now add `aria-pressed={inList}` to the button: it tells screen readers (and the stylesheet) that the button is switched on.");
await t.click(btns()[1]);
t.expect(await t.waitFor(() => t.text(btns()[1]) === before, 1000), "A second click should switch it back. Use `setInList(!inList)`, with the `!`.");
--- learned
State is a component's memory. Change it with its setter, and React draws the new version for you. Each card remembers its own.
--- summary
`const [value, setValue] = React.useState(start)` gives a component memory; calling the setter redraws it.
--- mistakes
- `onClick={setInList(!inList)}` without `() =>`: it runs while drawing, again and again ("Too many re-renders" in the Console).
- The `useState` line in `App` instead of `ShowCard`: all cards switch together.
- `onclick` with a small c: React ignores it and warns in the Console.
--- teacher
Compare with the plain JavaScript version: there, the click handler had to find the button and change its text. Here the handler only changes state, and the JSX already says what each state looks like.


=== step search
title: A search box that filters
minutes: 15
slot: app
template: react
--- explain
A text box whose value lives in state is called a **controlled input**:

```jsx
function NameBox() {
  const [name, setName] = React.useState("");
  return (
    <>
      <input value={name} onChange={(e) => setName(e.target.value)} />
      <p>Hello, {name}!</p>
    </>
  );
}
```

- `value={name}`: the box always shows the state.
- `onChange`: on every key press, save what's in the box (`e.target.value`) in the state. In React, `onChange` runs on every key press, like the `input` event you know.
- `<>` and `</>` are an empty wrapper (a **fragment**), for when you need one outer element but no extra box on the page.

With the search text in state, filtering is plain JavaScript: make the list of shows that match, and `map` *that* list. On Day 7 you had to clear the grid and draw the cards again yourself after every key press. In React you change the state, and React redraws for you.
--- task
In `App`:

1. Create state for the search text: `const [search, setSearch] = React.useState("");`
2. In the hero, under the paragraph, add `<div className="search">` with a controlled `<input />`: `value={search}`, an `onChange` that calls `setSearch`, and a `placeholder` like "Search shows".
3. Before `return`, make a list of the shows whose name contains the search text (with `filter`, `toLowerCase` and `includes`), and `map` that list instead of `shows`.

Type `the` in the preview's search box.
--- hint
The list of matching shows, before `return`:
```jsx
const found = shows.filter((show) => show.name.toLowerCase().includes(search.toLowerCase()));
```
Then in the grid, write `found.map(...)` instead of `shows.map(...)`.
--- hint
```jsx
function App() {
  const [search, setSearch] = React.useState("");
  const found = shows.filter((show) => show.name.toLowerCase().includes(search.toLowerCase()));

  return (
    <main className="container">
      <section className="hero">
        <h1>ShowShelf</h1>
        <p>{shows.length} shows to choose from</p>
        <div className="search">
          <input placeholder="Search shows" value={search} onChange={(e) => setSearch(e.target.value)} />
        </div>
      </section>

      <div className="grid">
        {found.map((show) => <ShowCard key={show.id} show={show} />)}
      </div>
    </main>
  );
}
```
--- solution-replace
function App() {
  return (
=>
function App() {
  const [search, setSearch] = React.useState("");
  const found = shows.filter((show) => show.name.toLowerCase().includes(search.toLowerCase()));

  return (
--- solution-replace
        <p>{shows.length} shows to choose from</p>
=>
        <p>{shows.length} shows to choose from</p>
        <div className="search">
          <input
            type="search"
            placeholder="Search shows"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
          />
        </div>
--- solution-replace
        {shows.map((show) => <ShowCard key={show.id} show={show} />)}
=>
