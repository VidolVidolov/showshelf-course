--- solution-replace
app.listen(3000, () => {
=>
const STATUSES = ["want", "watching", "watched"];

app.patch("/api/mylist/:id", (req, res) => {
  if (!STATUSES.includes(req.body.status)) {
    return res.status(400).json({ error: "status must be want, watching or watched" });
  }
  const found = myList.find((show) => show.id === Number(req.params.id));
  if (!found) {
    return res.status(404).json({ error: "That show is not in My List" });
  }
  found.status = req.body.status;
  res.json(found);
});

app.listen(3000, () => {
--- check
const call = async (method, path, body) => {
  const opts = { method, headers: { "Content-Type": "application/json" } };
  if (body !== undefined) opts.body = JSON.stringify(body);
  let r;
  try { r = await t.win.fetch(path, opts); } catch (e) { t.fail("The page can't reach your server. Look for a red error in the Console: server.js must run without errors, and it needs the line `const app = express();`."); }
  const text = await r.text();
  let data = text;
  try { data = text ? JSON.parse(text) : null; } catch (e) { /* plain text */ }
  return { status: r.status, data, error: data && typeof data === "object" && typeof data.error === "string" ? data.error : "" };
};
const list = await call("GET", "/api/mylist");
t.expect(list.status === 200 && Array.isArray(list.data) && list.data.length, "`GET /api/mylist` should still answer with your list, with at least one show.");
t.expect(list.data.every((s) => s && s.status === "want"), "Give every show in `myList` a status: `{ id: 1, name: \"Friends\", status: \"want\" }`.");
const added = await call("POST", "/api/mylist", { name: "Dark" });
t.expect(added.status === 201 && added.data && added.data.status === "want", "A new show should start with `status: \"want\"` too. Add it to the object in your POST route.");
const id = list.data[0].id;
const r = await call("PATCH", "/api/mylist/" + id, { status: "watched" });
t.expect(!(r.status === 404 && /^Cannot |not for /.test(r.error)), "There's no route for `PATCH /api/mylist/:id` yet. Add `app.patch(\"/api/mylist/:id\", (req, res) => { ... });`.");
t.expect(r.status !== 400, `Changing the status to "watched" was refused (400: ${r.error}). "want", "watching" and "watched" must be allowed.`);
t.expect(r.status !== 404, `\`PATCH /api/mylist/${id}\` answered 404, but show ${id} is in the list. Compare with \`Number(req.params.id)\`.`);
t.expect(r.status === 200 && r.data && r.data.status === "watched", `Changing the status answered ${r.status} with ${JSON.stringify(r.data)}. Change the show (\`found.status = req.body.status;\`) and answer with it: \`res.json(found);\`.`);
const again = await call("GET", "/api/mylist");
t.expect(again.data.some((s) => s.id === id && s.status === "watched"), "The answer said \"watched\", but the list didn't change. Change the show that's in `myList` (the one `find` gave you).");
const bad = await call("PATCH", "/api/mylist/" + id, { status: "finished" });
t.expect(bad.status === 400, `The status "finished" isn't allowed, but the server answered ${bad.status}. Answer 400 when the status isn't one of the three.`);
const nf = await call("PATCH", "/api/mylist/424242", { status: "watching" });
t.expect(nf.status === 404, `Changing a show that isn't in the list (id 424242) answered ${nf.status}. It should answer 404.`);
t.expect(await t.waitFor(() => t.$("#list select"), 2000), "The page shows no status menus. Press **Run again** above the preview, then check again.");
await t.type("#list select", "watching");
t.expect(await t.waitFor(() => /watching/.test(t.text("#notice")) && /200/.test(t.text("#notice")), 2000), "The API works, but changing the menu on the page didn't work. Press **Run again** and try it yourself.");
--- learned
`PATCH` changes part of an item, and the server only accepts values it knows. That's how the full ShowShelf API from this morning keeps track of what you're watching.
--- summary
`app.patch` changes part of an item; check allowed values with `includes`.
