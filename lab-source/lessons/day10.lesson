--- solution-append
// TVmaze's shows look different from ours. This turns one of them into our shape.
function toShow(tv) {
  return {
    id: tv.id,
    name: tv.name,
    genres: tv.genres,
    rating: tv.rating.average,
  };
}
--- check
t.expect(/useEffect\s*\(/.test(t.clean), "Load the shows inside `React.useEffect(() => { ... }, []);`, at the top of `App`.");
// Run the page again, and let TVmaze answer with three known shows, to see whether the cards follow the answer
const bridge = window.__labBridge;
const original = bridge.fetch;
const picked = Lab.data.tvmaze.filter((s) => ["Dark", "Chernobyl", "Fleabag"].includes(s.name));
let asked = 0;
bridge.fetch = function (realFetch, url, opts, win) {
  const u = String(url && url.url ? url.url : url);
  if (/api\.tvmaze\.com\/shows\?page=0/.test(u)) {
    asked++;
    return new Promise((resolve) => setTimeout(() => resolve(new win.Response(JSON.stringify(picked), { status: 200, headers: { "Content-Type": "application/json" } })), 100));
  }
  return original.apply(this, arguments);
};
let three = false;
try {
  await t.rerun();
  await t.waitFor(() => asked > 0, 2000);
  three = await t.waitFor(() => t.$$("#root .card").length === 3, 2000);
  await t.sleep(300);
} finally {
  bridge.fetch = original;
}
const cards = t.$$("#root .card").length;
const errs = t.errors.slice();
const calls = asked;
await t.rerun();
t.expect(calls > 0, "The page didn't ask TVmaze for shows. In the `useEffect`, fetch `https://api.tvmaze.com/shows?page=0`, and call `load()` after writing the function.");
t.expect(calls < 4, "Your page asks TVmaze again and again. Add `, []` after the function in `useEffect`, so it runs only once.");
t.expect(!errs.some((e) => /Objects are not valid as a React child/.test(e)), "React can't show a TVmaze show as it is. Turn each one into our shape first: `setTvShows(data.map(toShow));`.");
t.expect(!errs.length, "Your code has an error while loading the shows: \"" + (errs[0] || "") + "\". Read the red message in the Console.");
t.expect(cards !== 12, "Your page asks TVmaze, but the cards still come from the fixed `shows` list. Filter and map `tvShows` instead: `const found = tvShows.filter(...)`.");
t.expect(three, `When TVmaze answered with 3 shows, the page showed ${cards} cards. Store the answer with \`setTvShows(data.map(toShow))\`, and filter \`tvShows\` in \`App\`.`);
--- learned
`useEffect` runs code after React draws, and with `[]` only once: the place to load data. State, an effect and `fetch` are how React apps get data from an API.
--- summary
`React.useEffect(() => { ... }, [])` runs once after the first draw: a good place for `fetch`.
--- mistakes
- No `[]` at the end of `useEffect`: the page fetches again after every draw.
- `setTvShows(data)` without `toShow`: React can't show `rating` because it's an object.
--- teacher
Online, TVmaze answers with about 240 shows, so the grid gets long. That's expected. The check replaces TVmaze's answer with three known shows for a moment, to see that the cards really follow the data.


=== step server-get-one
title: Ask for one show
minutes: 10
slot: server
template: server
pagename: mylist.html
bonus: yes
--- explain
Route parameters work for every method. A `GET` with an id in the address asks for **one** item:

```js
app.get("/api/playlist/:id", (req, res) => {
  const id = Number(req.params.id);
  const song = playlist.find((s) => s.id === id);
  if (!song) {
    return res.status(404).json({ error: "No such song" });
  }
  res.json(song);
});
```

`GET /api/playlist` and `GET /api/playlist/2` are two different routes: one gives the whole list, the other one item. Many APIs work like this, including TVmaze (`/shows` and `/shows/431`).
--- task
Add a route for `GET /api/mylist/:id` that answers with the show that has that id, or `404` with an `error` if there's none.

Test it with **Try a request**: `GET /api/mylist/1`, then `GET /api/mylist/99`.
--- hint
It's like your DELETE route, but with `app.get`, and instead of removing the show, answer with it: `res.json(found)`.
--- hint
```js
app.get("/api/mylist/:id", (req, res) => {
  const id = Number(req.params.id);
  const found = myList.find((show) => show.id === id);
  if (!found) {
    return res.status(404).json({ error: "That show is not in My List" });
  }
  res.json(found);
});
```
--- solution-replace
app.listen(3000, () => {
=>
app.get("/api/mylist/:id", (req, res) => {
  const id = Number(req.params.id);
  const found = myList.find((show) => show.id === id);
  if (!found) {
    return res.status(404).json({ error: "That show is not in My List" });
  }
  res.json(found);
});

app.listen(3000, () => {
--- check
const call = async (method, path, body) => {
  const opts = { method, headers: { "Content-Type": "application/json" } };
  if (body !== undefined) opts.body = JSON.stringify(body);
  let r;
  try { r = await t.win.fetch(path, opts); } catch (e) { t.fail("The page can't reach your server. Look for a red error in the Console: server.js must run without errors, and it needs the line `const app = express();`."); }
  const text = await r.text();
  let data = text;
  try { data = text ? JSON.parse(text) : null; } catch (e) { /* plain text */ }
  return { status: r.status, data, error: data && typeof data === "object" && typeof data.error === "string" ? data.error : "" };
};
let list = await call("GET", "/api/mylist");
t.expect(list.status === 200 && Array.isArray(list.data), "`GET /api/mylist` should still answer with your list. Keep the routes from the earlier steps.");
if (!list.data.length) {
  await call("POST", "/api/mylist", { name: "Dark" });
  list = await call("GET", "/api/mylist");
}
const first = list.data[0];
const r = await call("GET", "/api/mylist/" + first.id);
t.expect(!(r.status === 404 && /^Cannot |not for /.test(r.error)), "There's no route for `GET /api/mylist/:id` yet. Add `app.get(\"/api/mylist/:id\", (req, res) => { ... });`.");
t.expect(r.status !== 404, `\`GET /api/mylist/${first.id}\` answered 404, but show ${first.id} is in the list. Compare with \`Number(req.params.id)\`.`);
t.expect(r.status !== 500 && r.status !== 504, `\`GET /api/mylist/${first.id}\` answered ${r.status}. Read the Console, and end the route with \`res.json(found);\`.`);
t.expect(r.status === 200 && r.data && !Array.isArray(r.data) && r.data.id === first.id, `\`GET /api/mylist/${first.id}\` should answer with that one show, but it sent ${JSON.stringify(r.data)}.`);
const nf = await call("GET", "/api/mylist/424242");
t.expect(nf.status === 404, `Asking for id 424242, which isn't in the list, answered ${nf.status}. It should answer 404.`);
t.expect(nf.error.trim(), "Send a message with the 404: `res.status(404).json({ error: \"...\" })`.");
--- learned
One address for the whole list, one for a single item: the same pattern as TVmaze's `/shows` and `/shows/431`.
--- summary
`GET /api/mylist/:id` answers with one item, or 404.


=== step server-patch
title: Change a status with PATCH
minutes: 20
slot: server
template: server
pagename: mylist.html
bonus: yes
--- explain
`PATCH` means "change part of something". It sends only the parts that change, like `{ "status": "watched" }`, to the address of one item.

A server decides which values it accepts. A list of allowed values and `includes` make that easy:

```js
const MOODS = ["happy", "sad", "calm"];

app.patch("/api/playlist/:id", (req, res) => {
  if (!MOODS.includes(req.body.mood)) {
    return res.status(400).json({ error: "Unknown mood" });
  }
  const song = playlist.find((s) => s.id === Number(req.params.id));
  if (!song) {
    return res.status(404).json({ error: "No such song" });
  }
  song.mood = req.body.mood;
  res.json(song);
});
```

Changing `song.mood` changes the object inside the array too, because it's the same object.
--- task
1. Give every show a `status`: add `status: "want"` to the shows in `myList` and to the new show in your POST route. The page then shows a menu next to each show.
2. Add a route for `PATCH /api/mylist/:id` that answers `400` if `req.body.status` isn't `"want"`, `"watching"` or `"watched"`, `404` if the id isn't in the list, and otherwise changes the show's status and answers with the show.

Then change a status with the menu in the preview.
--- hint
The shows become `{ id: 1, name: "Friends", status: "want" }`, and the POST route makes `{ id: Date.now(), name: req.body.name, status: "want" }`. The PATCH route follows the example.
--- hint
```js
const STATUSES = ["want", "watching", "watched"];

app.patch("/api/mylist/:id", (req, res) => {
  if (!STATUSES.includes(req.body.status)) {
    return res.status(400).json({ error: "status must be want, watching or watched" });
  }
  const found = myList.find((show) => show.id === Number(req.params.id));
  if (!found) {
    return res.status(404).json({ error: "That show is not in My List" });
  }
  found.status = req.body.status;
  res.json(found);
});
```
--- solution-replace
  { id: 1, name: "Friends" },
  { id: 2, name: "Dark" },
=>
  { id: 1, name: "Friends", status: "want" },
  { id: 2, name: "Dark", status: "want" },
--- solution-replace
  const item = { id: Date.now(), name: req.body.name };
=>
