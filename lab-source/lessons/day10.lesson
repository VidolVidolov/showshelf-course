t.expect(r.status !== 500, "Your route crashed (500). Read the red error in the Console.");
t.expect(Array.isArray(r.data), `\`GET /api/mylist\` answered ${JSON.stringify(r.data)}. It should send the array: \`res.json(myList);\`.`);
t.expect(Array.isArray(t.get("myList")), "Call your list `myList`, and create it with `let`: `let myList = [ ... ];`.");
t.expect(/\blet\s+myList\b/.test(t.clean), "Create `myList` with `let`, not `const`: later today you'll replace the whole list.");
t.expect(r.data.length >= 2, `Your list has ${r.data.length} show${r.data.length === 1 ? "" : "s"}. Put at least two shows in \`myList\`.`);
t.expect(r.data.every((s) => s && typeof s.name === "string" && s.name.trim()), "Every show needs a `name` with some text, like `{ id: 1, name: \"Friends\" }`.");
t.expect(r.data.every((s) => typeof s.id === "number"), "Every show needs a number `id`, with no quotes around the number: `{ id: 1, name: \"Friends\" }`.");
t.expect(new Set(r.data.map((s) => s.id)).size === r.data.length, "Two shows have the same `id`. Give each show its own number.");
t.expect(await t.waitFor(() => t.$$("#list li").length === r.data.length, 2000), "Your route works, but the page's list doesn't show it yet. Press **Run again** above the preview, then check again.");
--- learned
Your server sends data, and the page shows it. It's the same thing TVmaze does, only smaller: the page's list now comes from *your* code.
--- summary
`res.json(array)` sends a list; for now the data lives in the server's memory.
--- mistakes
- Quotes around the ids: `id: "1"` is text, not a number.
- A missing comma between the objects in the array.
- `res.json("myList")` in quotes: that sends the word, not the list.


=== step server-post
title: Add a show with POST
minutes: 15
slot: server
template: server
pagename: mylist.html
--- explain
A request has a **method** that says what the visitor wants to do:

- `GET`: give me something (what `fetch` does unless you say otherwise)
- `POST`: here's something new, please save it
- `DELETE`: remove something

When you press **Add** on the page, it sends `POST /api/mylist` with a **body**: the data, as JSON, like `{ "name": "Fleabag" }`. The line `app.use(express.json())` at the top turns that body into a normal object: `req.body`.

```js
app.post("/api/playlist", (req, res) => {
  const song = { id: Date.now(), title: req.body.title };
  playlist.push(song);
  res.status(201).json(song);
});
```

- `Date.now()` is the number of milliseconds since 1970: a new number every time, good enough as an id for practice.
- `res.status(201)` sets the **status code** of the answer. `201` means *Created*. The server answers with the new item, so the page learns its id.

> The list lives only in memory: every time the preview runs again (when you type), the server starts fresh with your first shows. A real server saves the list in a file or a database, like the one you saw this morning.
--- task
Above `app.listen`, add a route for `POST /api/mylist` that:

1. makes a new show object with `id: Date.now()` and `name: req.body.name`
2. adds it to `myList` with `push`
3. answers with status `201` and the new show

Then add a show with the form in the preview.
--- hint
It's `app.post(...)` with the same address as your GET route. Inside, three lines: make the object, `push` it, and `res.status(201).json(...)`.
--- hint
```js
app.post("/api/mylist", (req, res) => {
  const item = { id: Date.now(), name: req.body.name };
  myList.push(item);
  res.status(201).json(item);
});
```
--- solution-replace
app.listen(3000, () => {
=>
app.post("/api/mylist", (req, res) => {
  const item = { id: Date.now(), name: req.body.name };
  myList.push(item);
  res.status(201).json(item);
});

app.listen(3000, () => {
--- check
const call = async (method, path, body) => {
  const opts = { method, headers: { "Content-Type": "application/json" } };
  if (body !== undefined) opts.body = JSON.stringify(body);
  let r;
  try { r = await t.win.fetch(path, opts); } catch (e) { t.fail("The page can't reach your server. Look for a red error in the Console: server.js must run without errors, and it needs the line `const app = express();`."); }
  const text = await r.text();
  let data = text;
  try { data = text ? JSON.parse(text) : null; } catch (e) { /* plain text */ }
  return { status: r.status, data, error: data && typeof data === "object" && typeof data.error === "string" ? data.error : "" };
};
const r = await call("POST", "/api/mylist", { name: "Chernobyl" });
t.expect(r.status !== 404, "There's no route for `POST /api/mylist` yet (404 Not Found). Add `app.post(\"/api/mylist\", (req, res) => { ... });`.");
t.expect(r.status !== 504, "Your POST route never answered. End it with `res.status(201).json(item);`.");
t.expect(r.status !== 500, "Your POST route crashed (500). Read the red error in the Console.");
t.expect(r.status !== 200, "It works, but a new thing should get the status 201 Created: `res.status(201).json(item);`. Set the status first, then `.json`.");
t.expect(r.status === 201, `Adding a show answered ${r.status}. It should be 201: \`res.status(201).json(item);\`.`);
t.expect(r.data && typeof r.data === "object", "Answer with the new show, as an object: `res.status(201).json(item);`.");
t.expect(r.data.name === "Chernobyl", `I sent the name "Chernobyl", but your new show has the name ${JSON.stringify(r.data.name)}. Take the name from the request: \`name: req.body.name\`.`);
t.expect(typeof r.data.id === "number", "The new show needs a number `id`: `id: Date.now()`.");
const list = await call("GET", "/api/mylist");
t.expect(Array.isArray(list.data) && list.data.some((s) => s && s.id === r.data.id && s.name === "Chernobyl"), "The server answered 201, but the new show isn't in `GET /api/mylist`. Add it to the list: `myList.push(item);`.");
await t.type("#name", "Fleabag");
await t.submit("#addForm");
t.expect(await t.waitFor(() => t.$$("#list li").some((li) => /Fleabag/.test(t.text(li))), 2000), "The API works, but when I added Fleabag with the page's form, it didn't appear. Press **Run again** and try the form yourself.");
--- learned
`POST` sends new data to the server, `req.body` holds it, and `201 Created` says it worked. The "Add to My List" button on real websites does the same.
--- summary
`app.post` and `req.body` receive data; `res.status(201).json(item)` answers "Created".
--- mistakes
- `res.json(item).status(201)`: the answer has already gone with 200 before the status is set.
- `name: req.body` (the whole body) instead of `req.body.name`.
- Forgetting `myList.push(item)`: the page says "Added", but the show never appears.


=== step server-validate
title: Say no to bad data
minutes: 10
slot: server
template: server
pagename: mylist.html
--- explain
A server can't trust what it receives: anyone can send anything, not only your page. Try it: press **Add** with an empty box. Your server adds a show with no name.

So a server checks the data first (**validation**) and refuses bad requests with the status `400` (*Bad Request*) and a message:

```js
app.post("/api/playlist", (req, res) => {
  if (!req.body.title) {
    return res.status(400).json({ error: "A song needs a title" });
  }
  // ... the rest only runs when there is a title
});
```

`!req.body.title` is true when the title is missing or empty. The `return` stops the function there, so the song isn't added.
--- task
At the top of your POST route, refuse a request without a name: answer `400` with `{ error: "..." }` and a message of your own. Don't forget the `return`.

Then press **Add** with an empty box: the page shows your message.
--- hint
The `if` goes on the first line inside `app.post("/api/mylist", (req, res) => {`, before the line that makes the new show.
--- hint
```js
app.post("/api/mylist", (req, res) => {
  if (!req.body.name) {
    return res.status(400).json({ error: "Please send the name of a show" });
  }
  const item = { id: Date.now(), name: req.body.name };
  ...
```
--- solution-replace
app.post("/api/mylist", (req, res) => {
=>
app.post("/api/mylist", (req, res) => {
  if (!req.body.name) {
    return res.status(400).json({ error: "Please send the name of a show" });
  }
--- check
const call = async (method, path, body) => {
  const opts = { method, headers: { "Content-Type": "application/json" } };
  if (body !== undefined) opts.body = JSON.stringify(body);
  let r;
  try { r = await t.win.fetch(path, opts); } catch (e) { t.fail("The page can't reach your server. Look for a red error in the Console: server.js must run without errors, and it needs the line `const app = express();`."); }
  const text = await r.text();
  let data = text;
  try { data = text ? JSON.parse(text) : null; } catch (e) { /* plain text */ }
  return { status: r.status, data, error: data && typeof data === "object" && typeof data.error === "string" ? data.error : "" };
};
const before = await call("GET", "/api/mylist");
t.expect(before.status === 200 && Array.isArray(before.data), "`GET /api/mylist` should still answer with your list. Keep the routes from the earlier steps.");
const r1 = await call("POST", "/api/mylist", {});
t.expect(r1.status !== 500, "Your POST route crashed (500) when the name was missing. Read the red error in the Console.");
t.expect(r1.status !== 201 && r1.status !== 200, `I sent a show without a name and the server accepted it (${r1.status}). At the top of the POST route, add \`if (!req.body.name) { return res.status(400).json({ error: "..." }); }\`.`);
t.expect(r1.status === 400, `A show without a name got the status ${r1.status}. It should be 400: \`res.status(400).json(...)\`.`);
t.expect(r1.error.trim(), "Send a message with the 400, in a property called `error`: `res.status(400).json({ error: \"Please send a name\" })`.");
const after = await call("GET", "/api/mylist");
t.expect(after.data.length === before.data.length, "The server answered 400, but it still added the show. Put `return` before `res.status(400)...`, so the route stops there.");
const r2 = await call("POST", "/api/mylist", { name: "" });
t.expect(r2.status === 400, `An empty name got the status ${r2.status}. It should get 400 too: \`!req.body.name\` catches both.`);
const r3 = await call("POST", "/api/mylist", { name: "The Crown" });
t.expect(r3.status === 201 && r3.data && r3.data.name === "The Crown", `A show with a name must still be added (201), but it got ${r3.status}. Keep the code from the last step under your \`if\`.`);
--- learned
Check first, then act. `400` means "your request is wrong", and the `error` message tells the page why. The `return` makes sure nothing else happens.
--- summary
Validation: refuse bad data with `return res.status(400).json({ error: "..." })`.
--- mistakes
- No `return`: the show is still added, and the Console warns that the server tried to answer twice.
- `if (req.body.name)` without the `!`: now the good shows are refused.
- The `if` placed after `myList.push(item)`: too late.


=== step server-delete
title: Remove a show with DELETE
minutes: 20
slot: server
template: server
pagename: mylist.html
--- explain
To remove one show, the page must say *which* one. It puts the id in the address: `DELETE /api/mylist/2`. In the route, a colon marks that part of the address as a **route parameter**:

```js
app.delete("/api/playlist/:id", (req, res) => {
  const id = Number(req.params.id);
  // ...
});
```

For `/api/playlist/2`, `req.params.id` is `"2"`. Everything in an address is **text**, so `Number(...)` turns it into the number `2`, to compare it with the ids in the list.

There are two possible answers:

- the id isn't in the list: `404` (*Not Found*) with an error message
- it was removed: `204` (*No Content*), meaning "done, and I have nothing to send back". Send it with `res.status(204).end()`.

To remove an item from an array, keep all the others with `filter`, and put the result back in the variable:

```js
playlist = playlist.filter((song) => song.id !== id);
```

That's why `myList` is a `let`.
--- task
Above `app.listen`, add a route for `DELETE /api/mylist/:id` that:

1. turns `req.params.id` into a number
2. answers `404` with an `error` if no show in `myList` has that id (use `find`)
3. otherwise removes the show with `filter` and answers `204`

Then press **Remove** on a show in the preview.
--- hint
`myList.find((show) => show.id === id)` gives the show with that id, or `undefined` if there's none. So `if (!found) { return res.status(404).json(...); }`.
--- hint
```js
app.delete("/api/mylist/:id", (req, res) => {
  const id = Number(req.params.id);
  const found = myList.find((show) => show.id === id);
  if (!found) {
    return res.status(404).json({ error: "That show is not in My List" });
  }
  myList = myList.filter((show) => show.id !== id);
  res.status(204).end();
});
```
--- solution-replace
app.listen(3000, () => {
=>
app.delete("/api/mylist/:id", (req, res) => {
  const id = Number(req.params.id);
  const found = myList.find((show) => show.id === id);
  if (!found) {
    return res.status(404).json({ error: "That show is not in My List" });
  }
  myList = myList.filter((show) => show.id !== id);
  res.status(204).end();
});

app.listen(3000, () => {
--- check
const call = async (method, path, body) => {
  const opts = { method, headers: { "Content-Type": "application/json" } };
  if (body !== undefined) opts.body = JSON.stringify(body);
  let r;
  try { r = await t.win.fetch(path, opts); } catch (e) { t.fail("The page can't reach your server. Look for a red error in the Console: server.js must run without errors, and it needs the line `const app = express();`."); }
  const text = await r.text();
  let data = text;
  try { data = text ? JSON.parse(text) : null; } catch (e) { /* plain text */ }
  return { status: r.status, data, error: data && typeof data === "object" && typeof data.error === "string" ? data.error : "" };
};
// first the page: press Remove on the first show
await t.waitFor(() => t.$$("#list li").length > 0, 2000);
const shown = t.$$("#list li").length;
let pageOk = false;
if (shown > 0) {
  await t.click("#list li .remove");
  pageOk = await t.waitFor(() => t.$$("#list li").length === shown - 1, 2000);
}
// then the route itself
let list = await call("GET", "/api/mylist");
t.expect(list.status === 200 && Array.isArray(list.data), "`GET /api/mylist` should still answer with your list. Keep the routes from the earlier steps.");
if (!list.data.length) {
  await call("POST", "/api/mylist", { name: "Dark" });
  list = await call("GET", "/api/mylist");
}
t.expect(list.data.length > 0, "Your list is empty, so there's nothing to remove. Put some shows in `myList`.");
const first = list.data[0];
