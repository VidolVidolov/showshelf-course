--- solution-append
// ---------- My List ----------

// Is this show in My List? Gives true or false.
function isInMyList(id) {
  return state.myList.includes(id);
}

// Add the show to My List, or take it out if it's already there
function toggleMyList(show) {
  if (isInMyList(show.id)) {
    state.myList = state.myList.filter((id) => id !== show.id);
  } else {
    state.myList.push(show.id);
  }
  render();
}

// The round button on a card: "+" adds the show, "✓" means it's in My List
function createListButton(show) {
  const button = document.createElement("button");
  button.className = "list-btn";
  if (isInMyList(show.id)) {
    button.textContent = "✓";
  } else {
    button.textContent = "+";
  }
  button.setAttribute("aria-pressed", isInMyList(show.id));   // "pressed" look, and for screen readers
  button.setAttribute("aria-label", "My List: " + show.name);
  button.addEventListener("click", () => {
    toggleMyList(show);
  });
  return button;
}
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const st = t.get("state");
t.expect(st && Array.isArray(st.myList), "Add `myList: []` to the `state` object.");
t.expect(t.$$("#grid .card").length === 12, "The page should show all 12 shows. Look in the Console for an error.");
const buttons = () => t.$$("#grid .card .list-btn");
t.expect(buttons().length === 12, "I can't find the round buttons on the cards. In `createCard`, right before `return card;`, add `card.append(createListButton(show));`.");
await t.click(buttons()[0]);
t.expect(t.get("state").myList.includes(1), "Clicking + on Friends didn't put its id (1) in `state.myList`. TODO 2 in `toggleMyList`: `state.myList.push(show.id);`.");
t.expect(t.get("state").myList.length === 1, "One click should add the show once. Check TODO 1 and TODO 2 in `toggleMyList`.");
t.expect(t.text("#list-count") === "1", `After adding one show, the counter at the top says "${t.text("#list-count")}". At the end of \`render()\`, add \`listCount.textContent = state.myList.length;\`.`);
t.expect(buttons()[0].getAttribute("aria-pressed") === "true", "The Friends button should now show a tick. Keep `render();` at the end of `toggleMyList`.");
await t.click(buttons()[0]);
t.expect(!t.get("state").myList.includes(1), "Clicking the tick again should take Friends out of My List. TODO 1: `state.myList = state.myList.filter((id) => id !== show.id);`.");
t.expect(t.text("#list-count") === "0", "After taking the show out again, the counter should say 0.");
await t.click(buttons()[1]);
await t.click(buttons()[2]);
t.expect(t.text("#list-count") === "2", "Two shows added: the counter should say 2.");
--- learned
My List is state too: an array of ids. The buttons change it with `push` and `filter`, then call `render()`, so the ticks and the counter always match the state.
--- summary
My List is an array of ids in the state: `push` adds, `filter` removes, `includes` checks.
--- mistakes
- `state.myList.filter(...)` without `state.myList =` in front: `filter` makes a new array and doesn't change the old one.
- Adding the button after `return card;`, where the code never runs.
- `listCount.textContent` set outside `render()`, so it doesn't update on clicks.


=== step save
title: Remember My List
minutes: 15
slot: js
--- explain
Add a show to My List, then press **Run again** above the preview: the list is empty again. Everything in JavaScript variables disappears when the page reloads.

The browser has a small store for each website that survives reloads: **localStorage**. It keeps text under a name, called a **key**:

```js
localStorage.setItem("theme", "dark");   // save
localStorage.getItem("theme");           // "dark", or null if nothing is saved
```

It can only store text. To save an array or an object, turn it into text with `JSON.stringify`, and back again with `JSON.parse`:

```js
localStorage.setItem("scores", JSON.stringify([7, 9]));        // saved as "[7,9]"
const scores = JSON.parse(localStorage.getItem("scores"));     // [7, 9] again
```

The very first time, nothing is saved yet: `getItem` gives `null`, and `JSON.parse(null)` is `null` too. Writing `?? []` after it means "or an empty array, if that's `null`".
--- task
1. Fill in the TODO in `saveMyList`, using the key `"myList"`.
2. In `toggleMyList`, call `saveMyList();` right before `render();`.
3. In `state`, start `myList` from the saved list: `JSON.parse(localStorage.getItem("myList")) ?? []`.

Add two shows, then press **Run again**: they're still in My List.
--- starter-append
// Save My List in the browser (localStorage keeps text only, so we turn it into JSON text)
function saveMyList() {
  // TODO: localStorage.setItem with the key "myList" and the text JSON.stringify(state.myList)
}
--- hint
`setItem` takes two things: the key and the text. The text is `JSON.stringify(state.myList)`.
--- hint
```js
function saveMyList() {
  localStorage.setItem("myList", JSON.stringify(state.myList));
}
```
In `state`:
```js
  myList: JSON.parse(localStorage.getItem("myList")) ?? [],
```
--- solution-replace
  myList: [],   // the ids of the shows in My List, like [2, 5]
=>
  myList: JSON.parse(localStorage.getItem("myList")) ?? [],   // saved ids, or an empty list
--- solution-replace
    state.myList.push(show.id);
  }
  render();
=>
    state.myList.push(show.id);
  }
  saveMyList();
  render();
--- solution-append
// Save My List in the browser (localStorage keeps text only, so we turn it into JSON text)
function saveMyList() {
  localStorage.setItem("myList", JSON.stringify(state.myList));
}
--- check
await t.sleep(450);
t.win.localStorage.removeItem("myList");
await t.rerun();
const buttons = () => t.$$("#grid .card .list-btn");
t.expect(buttons().length === 12, "The cards have lost their + buttons. Look in the Console for an error.");
t.expect(t.text("#list-count") === "0", "With nothing saved, the counter should start at 0. In `state`, use `JSON.parse(localStorage.getItem(\"myList\")) ?? []`.");
await t.click(buttons()[1]);
const saved = t.win.localStorage.getItem("myList");
t.expect(saved !== null, "Nothing was saved. Fill in the TODO in `saveMyList`, and call `saveMyList();` in `toggleMyList`, right before `render();`.");
t.expect(saved === "[2]", `After adding Breaking Bad, localStorage has "${saved}" under "myList". It should be the list as JSON text, "[2]": use \`JSON.stringify(state.myList)\`.`);
await t.rerun();
const count = t.text("#list-count");
t.expect(count !== "0", "After a reload My List is empty again. In `state`, start from the saved list: `myList: JSON.parse(localStorage.getItem(\"myList\")) ?? []`.");
t.expect(count === "1", `After a reload the counter says "${count}" instead of 1. Turn the saved text back into an array with \`JSON.parse(...)\`.`);
t.expect(buttons()[1].getAttribute("aria-pressed") === "true", "After a reload, Breaking Bad should still show its tick.");
t.win.localStorage.removeItem("myList");
--- learned
`localStorage` plus `JSON.stringify` and `JSON.parse` make data survive a reload. Your ShowShelf now remembers what you picked, like a real app.
--- summary
`localStorage.setItem/getItem` with `JSON.stringify/parse` saves data across reloads.
--- mistakes
- Saving the array without `JSON.stringify`: it's stored as `"2,5"`, which `JSON.parse` can't read back as an array.
- Forgetting `JSON.parse` when loading, so `myList` is a piece of text.
- Calling `saveMyList()` after `render()` in a different function, or not at all.
--- teacher
If a student's page shows ticks from earlier experiments, they can click them away. The Lab keeps localStorage between reloads on purpose, like a real browser does.


=== step only-list
title: Only My List
minutes: 15
slot: js
bonus: yes
template: extras
--- explain
The toolbar now has a checkbox, **Only My List**. When it's ticked, the grid should show only the shows in My List.

A checkbox has a `checked` property (`true` or `false`), and a `"change"` event that happens every time it's ticked or unticked.

It's the same pattern as the genres: add a value to the state, change it in the event, and let `render()` use it.

```js
onlyDramaBox.addEventListener("change", () => {
  state.onlyDrama = onlyDramaBox.checked;
  render();
});
```
--- task
1. At the top: `const onlyListBox = document.querySelector("#only-list");`
2. Add `onlyMyList: false` to `state`.
3. Add a `"change"` listener to the checkbox that sets `state.onlyMyList` and calls `render()`.
4. In `render()`, before `renderGrid(list)`: if `state.onlyMyList` is true, keep only the shows that are in My List (`filter` with `isInMyList(show.id)`).
--- hint
The filter in `render()`: `list = list.filter((show) => isInMyList(show.id));`, inside an `if`.
--- hint
```js
onlyListBox.addEventListener("change", () => {
  state.onlyMyList = onlyListBox.checked;
  render();
});
```
In `render()`:
```js
  if (state.onlyMyList) {
    list = list.filter((show) => isInMyList(show.id));
  }
```
--- solution-replace
const listCount = document.querySelector("#list-count");
=>
const listCount = document.querySelector("#list-count");
const onlyListBox = document.querySelector("#only-list");
--- solution-replace
  myList: JSON.parse(localStorage.getItem("myList")) ?? [],   // saved ids, or an empty list
=>
  myList: JSON.parse(localStorage.getItem("myList")) ?? [],   // saved ids, or an empty list
  onlyMyList: false,  // is "Only My List" ticked?
--- solution-replace
    list = getByGenre(list, state.genre);
  }
=>
    list = getByGenre(list, state.genre);
  }
  if (state.onlyMyList) {
    list = list.filter((show) => isInMyList(show.id));
  }
--- solution-append
// Only My List: tick the box to see only your shows
onlyListBox.addEventListener("change", () => {
  state.onlyMyList = onlyListBox.checked;
  render();
});
--- check
await t.sleep(450);
t.win.localStorage.removeItem("myList");
await t.rerun();
const buttons = () => t.$$("#grid .card .list-btn");
t.expect(buttons().length === 12, "The page should show all 12 shows with their buttons. Look in the Console for an error.");
await t.click(buttons()[0]);
await t.click(buttons()[3]);
await t.check("#only-list", true);
const n = t.$$("#grid .card").length;
t.expect(n !== 12, "Ticking **Only My List** didn't change the grid. Add a `\"change\"` listener to the checkbox that sets `state.onlyMyList` and calls `render()`.");
t.expect(n === 2, `With two shows in My List and the box ticked, the grid shows ${n} cards. It should show 2. In \`render()\`, keep only the shows where \`isInMyList(show.id)\` is true.`);
await t.check("#only-list", false);
t.expect(t.$$("#grid .card").length === 12, "Unticking the box should bring back all 12 shows. Use `onlyListBox.checked` to set `state.onlyMyList`.");
t.win.localStorage.removeItem("myList");
--- learned
One more value in the state, one more `if` in `render()`. Adding features is easy once everything goes through the state.
--- summary
A checkbox's `checked` and `"change"` event can drive a filter in `render()`.


=== step sort
title: Best rated first
minutes: 15
slot: js
bonus: yes
template: extras
--- explain
The toolbar also has a drop-down list, a `<select>`. Its `value` is the `value` of the chosen `<option>`: `""` for normal order, `"rating"` for best rated first. It fires a `"change"` event when someone picks an option.

To sort an array, use `sort` with a small **compare function**. It gets two items, `a` and `b`, and gives back a number: negative puts `a` first, positive puts `b` first.

```js
episodes.sort((a, b) => a.number - b.number);   // lowest number first
```

For the highest rating first, subtract the other way round: `b.rating - a.rating`.

> `sort` changes the array it's called on. That's fine here, because `list` in `render()` is a new array made by `searchByName`, not the original `shows`.
--- task
1. At the top: `const sortSelect = document.querySelector("#sort");`
2. Add `sort: ""` to `state`.
3. Add a `"change"` listener to the select that sets `state.sort` to `sortSelect.value` and calls `render()`.
4. In `render()`, before `renderGrid(list)`: if `state.sort` is `"rating"`, sort `list` with the best rating first.
--- hint
The sort in `render()` is one line inside an `if`: `list.sort((a, b) => b.rating - a.rating);`.
--- hint
```js
sortSelect.addEventListener("change", () => {
  state.sort = sortSelect.value;
  render();
});
```
In `render()`:
```js
  if (state.sort === "rating") {
    list.sort((a, b) => b.rating - a.rating);
  }
```
--- solution-replace
const listCount = document.querySelector("#list-count");
=>
const listCount = document.querySelector("#list-count");
const sortSelect = document.querySelector("#sort");
--- solution-replace
  myList: JSON.parse(localStorage.getItem("myList")) ?? [],   // saved ids, or an empty list
=>
  myList: JSON.parse(localStorage.getItem("myList")) ?? [],   // saved ids, or an empty list
  sort: "",     // "" for normal order, "rating" for best rated first
--- solution-replace
    list = getByGenre(list, state.genre);
  }
=>
    list = getByGenre(list, state.genre);
  }
  if (state.sort === "rating") {
    list.sort((a, b) => b.rating - a.rating);   // highest rating first
  }
--- solution-append
// The order drop-down
sortSelect.addEventListener("change", () => {
  state.sort = sortSelect.value;
  render();
});
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const first = () => t.text(t.$$("#grid .card h3")[0]);
t.expect(t.$$("#grid .card").length === 12, "The page should show all 12 shows. Look in the Console for an error.");
t.expect(first() === "Friends", "Before choosing an order, the grid should start with Friends, like the data.");
await t.type("#sort", "rating");
t.expect(first() !== "Friends", "Choosing **Best rated first** didn't change the order. Add a `\"change\"` listener to `sortSelect` that sets `state.sort` and calls `render()`.");
t.expect(first() === "Breaking Bad", `With the best rated first, the first card is "${first()}". It should be Breaking Bad (9.2). Sort with \`(a, b) => b.rating - a.rating\`.`);
await t.type("#sort", "");
t.expect(first() === "Friends", "Going back to **Normal order** should put Friends first again. Only sort when `state.sort === \"rating\"`.");
--- learned
`sort` with a compare function orders anything: by rating, by name, by year. And the state pattern made it one small `if`.
--- summary
`list.sort((a, b) => b.rating - a.rating)` sorts from highest to lowest.


=== step details
title: A details box
minutes: 20
slot: js
bonus: yes
template: extras
--- explain
The page now has a `<dialog>` element at the bottom: a box that can open on top of the page. Look at it in the whole-page tab.

- `dialog.showModal()` opens it and darkens the page behind it.
- `dialog.close()` closes it. (The Esc key closes it too.)

When a card is clicked, fill the dialog with that show and open it.

One trap: the round + button is **inside** the card. A click on it also counts as a click on the card, because events **bubble** up from an element to everything around it. To stop that, call `event.stopPropagation()` in the button's listener.

```js
likeButton.addEventListener("click", (event) => {
  event.stopPropagation();   // don't also count as a click on the post around it
  like(post);
});
```
--- task
1. At the top, find the dialog: `const detailsDialog = document.querySelector("#details");`
2. Write `openDetails(show)`: set the text of `#details-title` (name), `#details-meta` (years) and `#details-summary` (`show.summary`), then call `detailsDialog.showModal()`.
3. In `createCard`, before `return card;`, add a click listener to the card that calls `openDetails(show)`.
4. The close button `#close-details` closes the dialog.
5. In `createListButton`, add `event.stopPropagation();` so the + button doesn't open the dialog.
--- hint
Inside `openDetails`, use `document.querySelector("#details-title").textContent = show.name;` and the same for the other two.
--- hint
```js
function openDetails(show) {
  document.querySelector("#details-title").textContent = show.name;
  document.querySelector("#details-meta").textContent = yearsLabel(show.premiered, show.ended);
  document.querySelector("#details-summary").textContent = show.summary;
  detailsDialog.showModal();
}

document.querySelector("#close-details").addEventListener("click", () => {
  detailsDialog.close();
});
```
In `createCard`: `card.addEventListener("click", () => openDetails(show));`
--- solution-replace
const listCount = document.querySelector("#list-count");
=>
const listCount = document.querySelector("#list-count");
const detailsDialog = document.querySelector("#details");
--- solution-replace
  card.append(createListButton(show));
  return card;
=>
  card.append(createListButton(show));
  card.addEventListener("click", () => {
    openDetails(show);
  });
  return card;
--- solution-replace
  button.addEventListener("click", () => {
    toggleMyList(show);
  });
=>
  button.addEventListener("click", (event) => {
    event.stopPropagation();   // don't also open the details box
    toggleMyList(show);
  });
--- solution-append
// ---------- Details box ----------
function openDetails(show) {
  document.querySelector("#details-title").textContent = show.name;
  document.querySelector("#details-meta").textContent = yearsLabel(show.premiered, show.ended);
  document.querySelector("#details-summary").textContent = show.summary;
  detailsDialog.showModal();
}

document.querySelector("#close-details").addEventListener("click", () => {
  detailsDialog.close();
});
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const dlg = t.$("#details");
t.expect(t.$$("#grid .card").length === 12, "The page should show all 12 shows. Look in the Console for an error.");
await t.click(t.$$("#grid .card h3")[2]);
t.expect(dlg.open, "Clicking a card didn't open the dialog. In `createCard`, add a click listener to `card` that calls `openDetails(show)`, and end `openDetails` with `detailsDialog.showModal();`.");
t.expect(t.text("#details-title") === "The Office", `After clicking The Office, the dialog title says "${t.text("#details-title")}". Set \`#details-title\` to \`show.name\`.`);
t.expect(/camera crew|office/i.test(t.text("#details-summary")), "Fill `#details-summary` with `show.summary`.");
await t.click("#close-details");
t.expect(!dlg.open, "The ✕ button should close the dialog: `detailsDialog.close();` in its click listener.");
const before = t.win.localStorage.getItem("myList");
await t.click(t.$$("#grid .card .list-btn")[0]);
const opened = dlg.open;
if (opened) dlg.close();
await t.click(t.$$("#grid .card .list-btn")[0]);
if (before === null) t.win.localStorage.removeItem("myList"); else t.win.localStorage.setItem("myList", before);
t.expect(!opened, "Clicking the + button also opened the dialog. In `createListButton`, give the listener an `event` parameter and call `event.stopPropagation();`.");
--- learned
`<dialog>` with `showModal()` gives you a pop-up box without extra code. And you met **bubbling**: clicks travel up to the elements around them, unless you stop them.
--- summary
`dialog.showModal()` opens a dialog; `event.stopPropagation()` stops a click bubbling up.
