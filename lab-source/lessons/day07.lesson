        state.genre = "";
      } else {
        state.genre = genre;
      }
      render();
```
And the search listener:
```js
searchInput.addEventListener("input", () => {
  state.search = searchInput.value;
  render();
});
```
--- solution-replace
}

renderGrid(shows);
=>
}
--- solution-replace
// Every time the text in the search box changes, show only the shows that match
searchInput.addEventListener("input", () => {
  renderGrid(searchByName(shows, searchInput.value));
});
=>
// Every time the text in the search box changes: change the state, then draw again
searchInput.addEventListener("input", () => {
  state.search = searchInput.value;
  render();
});
--- solution-append
// ---------- State: everything on the page that can change ----------
const state = {
  search: "",   // the text in the search box
  genre: "",    // the chosen genre ("" means all genres)
};

// ---------- Draw the page from the state ----------
function render() {
  let list = searchByName(shows, state.search);
  if (state.genre !== "") {
    list = getByGenre(list, state.genre);
  }

  renderGrid(list);
  renderGenres();
}

// One button (a "chip") per genre, in the box with the id "genres". The chosen one gets the class "active".
const genresBox = document.querySelector("#genres");
function renderGenres() {
  genresBox.replaceChildren();
  for (const genre of allGenres(shows)) {
    const chip = document.createElement("button");
    chip.className = "chip";
    chip.textContent = genre;
    if (genre === state.genre) {
      chip.classList.add("active");
    }
    chip.addEventListener("click", () => {
      if (state.genre === genre) {
        state.genre = "";      // clicked the chosen genre again: all genres
      } else {
        state.genre = genre;
      }
      render();
    });
    genresBox.append(chip);
  }
}

// ---------- Start: draw the page for the first time ----------
render();
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const chipsNow = () => t.$$("#genres button");
t.expect(chipsNow().length > 0, "There are no genre buttons yet. Keep `render();` at the bottom, and look in the Console for an error.");
t.expect(t.$$("#grid .card").length === 12, "The page should start with all 12 shows. Look in the Console for an error.");
t.expect(!/^\s*renderGrid\(\s*shows\s*\)\s*;?\s*$/m.test(t.clean), "Delete the old line `renderGrid(shows);`. Now `render();` at the bottom draws the page.");
const chip = (name) => chipsNow().find((b) => t.text(b) === name);
const names = () => t.$$("#grid .card h3").map((h) => t.text(h));
const input = t.$("#search");
const typeIn = async (v) => { input.value = v; input.dispatchEvent(new t.win.Event("input", { bubbles: true })); await t.sleep(80); };
await t.click(chip("Drama"));
const st = t.get("state");
t.expect(st && st.genre === "Drama", "When I click **Drama**, `state.genre` doesn't change. TODO 2: in the chip's click listener, set `state.genre = genre;` and call `render();`.");
t.expect(names().length === 8, `After clicking Drama the grid shows ${names().length} shows. It should show the 8 dramas. TODO 1: in \`render()\`, use \`getByGenre(list, state.genre)\` when \`state.genre\` is not "".`);
t.expect(chip("Drama") && chip("Drama").classList.contains("active"), "The Drama chip should look chosen. Call `render()` at the end of the click listener, so the chips are drawn again.");
await typeIn("the");
t.expect(names().length === 3, `With Drama chosen, typing "the" shows ${names().length} shows: ${names().join(", ")}. It should show 3 (The Crown, The Wire, Band of Brothers). In the search listener, write \`state.search = searchInput.value;\` and \`render();\` instead of \`renderGrid(...)\`.`);
await typeIn("");
t.expect(names().length === 8, "After emptying the search box, the 8 dramas should come back.");
await t.click(chip("Drama"));
t.expect(t.get("state").genre === "" && names().length === 12, "Clicking the chosen chip again should show all 12 shows. TODO 2: if `state.genre === genre`, set `state.genre = \"\";`.");
--- learned
This is the most important idea of the day: **state, then render**. Events never touch the grid themselves. They change `state` and call `render()`, and `render()` draws everything from the state. However many buttons you add, the page can't get out of step.
--- summary
Keep what can change in a `state` object; events change the state, then call `render()`.
--- mistakes
- Forgetting `render()` after changing `state.genre`: the state changes but the page doesn't.
- Leaving `renderGrid(searchByName(...))` in the search listener, so typing ignores the chosen genre.
- `if (state.genre = genre)` with one `=`: that sets the value instead of comparing.
--- teacher
This step is longer than the others. The key idea is item 4: the search listener stops drawing and only changes `state`. If a student is lost, draw three boxes on paper: event, state, render, with arrows in that order.


=== step mylist
title: My List
minutes: 25
slot: js
--- explain
Time for **My List**. Each card gets a round button in the corner: **+** adds the show, **✓** means it's already in the list.

My List is part of the state: an array of show **ids**, like `[2, 5]`. Ids are better than names because they are unique and never change.

You already know the array tools that do the work:

```js
favourites.push(7);                                  // add 7 at the end
favourites = favourites.filter((id) => id !== 7);    // a new array without 7
[2, 5].includes(5);                                  // true: 5 is in the array
```

We've added three functions below your code: `isInMyList(id)` answers true or false, `toggleMyList(show)` adds or removes a show, and `createListButton(show)` builds the round button. Look at the end of `toggleMyList`: it calls `render()`. Change the state, then draw. The button shows `+` or `✓` because it's drawn from the state every time.
--- task
1. In the `state` object, add `myList: []`.
2. At the top, find the counter in the header: `const listCount = document.querySelector("#list-count");`
3. Fill in **TODO 1** and **TODO 2** in `toggleMyList`.
4. In `createCard`, right before `return card;`, add the button: `card.append(createListButton(show));`
5. At the end of `render()`, show how many shows are in My List: `listCount.textContent = state.myList.length;`

Click + on a few cards and watch the counter at the top.
--- starter-append
// ---------- My List ----------

// Is this show in My List? Gives true or false.
function isInMyList(id) {
  return state.myList.includes(id);
}

// Add the show to My List, or take it out if it's already there
function toggleMyList(show) {
  if (isInMyList(show.id)) {
    // TODO 1: take the id out: keep every id that is not show.id (filter)
  } else {
    // TODO 2: add the id at the end (push)
  }
  render();
}

// The round button on a card: "+" adds the show, "✓" means it's in My List
function createListButton(show) {
  const button = document.createElement("button");
  button.className = "list-btn";
  if (isInMyList(show.id)) {
    button.textContent = "✓";
  } else {
    button.textContent = "+";
  }
  button.setAttribute("aria-pressed", isInMyList(show.id));   // "pressed" look, and for screen readers
  button.setAttribute("aria-label", "My List: " + show.name);
  button.addEventListener("click", () => {
    toggleMyList(show);
  });
  return button;
}
--- hint
TODO 1 gives `state.myList` a new value: `state.myList = state.myList.filter(...)`. TODO 2 is one `push`. Don't forget items 1, 2, 4 and 5 of the task: they're outside the new code.
--- hint
```js
  if (isInMyList(show.id)) {
    state.myList = state.myList.filter((id) => id !== show.id);
  } else {
    state.myList.push(show.id);
  }
```
In `state`:
```js
const state = {
  search: "",
  genre: "",
  myList: [],
};
```
