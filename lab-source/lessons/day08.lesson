t.expect(/zzzz/.test(t.text(empty)), "After searching for zzzz the message says \"" + t.text(empty) + "\". Put the searched word in it: set `emptyMessage.textContent` with a template literal that contains `${term}`.");
await t.type("#search", "dark");
await t.submit("#search-form");
