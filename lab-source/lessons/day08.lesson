--- file data.js
// data.js: the 12 sample shows (read only)
const shows = {{data:shows}};

--- file helpers.js
// helpers.js: small helper functions (read only)

// ratingLabel(9.2) -> "Must watch", ratingLabel(7.5) -> "Worth a try", ratingLabel(5) -> "Skip it"
function ratingLabel(rating) {
  if (rating >= 8.5) {
    return "Must watch";
  } else if (rating >= 7) {
    return "Worth a try";
  } else {
    return "Skip it";
  }
}

// yearsLabel(1994, 2004) -> "1994–2004", yearsLabel(2019, 2019) -> "2019",
// yearsLabel(2019, null) -> "2019–now" (still running), yearsLabel(null, null) -> ""
function yearsLabel(premiered, ended) {
  if (!premiered) {
    return "";
  }
  if (!ended) {
    return premiered + "–now";
  }
  if (premiered === ended) {
    return String(premiered);
  }
  return premiered + "–" + ended;
}

// getByGenre(shows, "Comedy") -> only the shows that have this genre
function getByGenre(list, genre) {
  return list.filter((show) => show.genres.includes(genre));
}

// allGenres(shows) -> ["Action", "Adventure", "Comedy", ...]: every genre once, from A to Z
function allGenres(list) {
  const result = [];
  for (const show of list) {
    for (const genre of show.genres) {
      if (!result.includes(genre)) {
        result.push(genre);
      }
    }
  }
  return result.sort();
}

// ---------- New today: helpers for TVmaze's data ----------

// stripTags("<p><b>Dark</b> is a mystery.</p>") -> "Dark is a mystery."
// TVmaze writes its summaries in HTML. We keep only the text.
function stripTags(html) {
  if (!html) {
    return "";
  }
  return html.replace(/<[^>]*>/g, "").replace(/&amp;/g, "&").trim();
}

// yearOf("2019-06-21") -> 2019, yearOf(null) -> null
function yearOf(date) {
  if (!date) {
    return null;
  }
  return Number(date.slice(0, 4));
}

// toShow(apiShow): one show in TVmaze's shape -> one show in OUR shape,
// the same shape as the shows in data.js. That's why createCard keeps working.
// Some of TVmaze's fields can be null, so each one gets a safe value.
function toShow(apiShow) {
  let network = "";
  if (apiShow.network) {
    network = apiShow.network.name;
  } else if (apiShow.webChannel) {
    network = apiShow.webChannel.name;   // streaming shows have a web channel instead
  }

  let image = null;
  if (apiShow.image) {
    image = apiShow.image.medium;        // the medium-sized poster
  }

  let rating = null;
  if (apiShow.rating) {
    rating = apiShow.rating.average ?? null;
  }

  return {
    id: apiShow.id,
    name: apiShow.name,
    genres: apiShow.genres ?? [],
    rating: rating,
    premiered: yearOf(apiShow.premiered),
    ended: yearOf(apiShow.ended),
    runtime: apiShow.averageRuntime ?? apiShow.runtime ?? null,
    network: network,
    image: image,
    summary: stripTags(apiShow.summary),
  };
}

--- default js
// app.js: ShowShelf (Day 8)
// This is the finished app from Day 7, tidied into sections.
// A few lines are new or changed for today: look for "Day 8" in the comments.
// Loaded before this file (open the read-only tabs to see them):
//   data.js    -> shows: the 12 sample shows (only until TVmaze takes over)
//   helpers.js -> ratingLabel, yearsLabel, getByGenre, allGenres, toShow, stripTags

// ---------- Elements: the parts of the page we change ----------
const grid = document.querySelector("#grid");
const searchInput = document.querySelector("#search");
const searchForm = document.querySelector("#search-form");
const emptyMessage = document.querySelector("#empty-message");
const genresBox = document.querySelector("#genres");
const listCount = document.querySelector("#list-count");

// ---------- State: everything on the page that can change ----------
const state = {
  shows: shows,   // Day 8: the shows on the page. Soon they come from TVmaze.
  genre: "",      // the chosen genre ("" means all genres)
  myList: JSON.parse(localStorage.getItem("myList")) ?? [],   // saved ids, or an empty list
};

// ---------- One card for one show ----------
// createCard(show) builds a card and gives it back. It doesn't put it on the page.
function createCard(show) {
  const card = document.createElement("article");
  card.className = "card";

  const poster = document.createElement("img");
  poster.className = "poster";
  poster.src = show.image ?? "poster.svg";   // no picture (null)? use poster.svg
  poster.alt = "";                           // the name is under the poster, so no alt text
  poster.loading = "lazy";                   // Day 8: load the picture only when it scrolls into view

  const body = document.createElement("div");
  body.className = "card-body";

  // Day 8: real shows can have no genres at all, so only add a badge when there is one
  if (show.genres.length > 0) {
    const badge = document.createElement("span");
    badge.className = "badge";
    badge.textContent = show.genres[0];
    body.append(badge);
  }

  const title = document.createElement("h3");
  title.textContent = show.name;

  // Day 8: real shows can have no rating yet (null)
  const rating = document.createElement("p");
  rating.className = "rating";
  if (show.rating === null) {
    rating.textContent = "No rating yet";
  } else {
    rating.textContent = "★ " + show.rating + " · " + ratingLabel(show.rating);
  }

  const meta = document.createElement("p");
  meta.className = "meta";
  meta.textContent = yearsLabel(show.premiered, show.ended);

  body.append(title, rating, meta);
  card.append(poster, body);
  card.append(createListButton(show));
  return card;
}

// The round button on a card: "+" adds the show, "✓" means it's in My List
function createListButton(show) {
  const button = document.createElement("button");
  button.className = "list-btn";
  if (isInMyList(show.id)) {
    button.textContent = "✓";
  } else {
    button.textContent = "+";
  }
  button.setAttribute("aria-pressed", isInMyList(show.id));   // "pressed" look, and for screen readers
  button.setAttribute("aria-label", "My List: " + show.name);
  button.addEventListener("click", () => {
    toggleMyList(show);
  });
  return button;
}

// ---------- Draw the page from the state ----------

// Draw a list of shows in the grid
function renderGrid(list) {
  grid.replaceChildren();   // remove the old cards first
  for (const show of list) {
    grid.append(createCard(show));
  }
  emptyMessage.hidden = list.length > 0;   // show the message only when there are no shows
}

function render() {
  // Day 8: no filtering by name here any more. TVmaze does the searching.
  let list = state.shows;
  if (state.genre !== "") {
    list = getByGenre(list, state.genre);
  }

  renderGrid(list);
  renderGenres();
  listCount.textContent = state.myList.length;
}

// One button (a "chip") per genre. The chosen one gets the class "active".
function renderGenres() {
  genresBox.replaceChildren();
  for (const genre of allGenres(state.shows)) {   // Day 8: the genres of the shows on the page
    const chip = document.createElement("button");
    chip.className = "chip";
    chip.textContent = genre;
    if (genre === state.genre) {
      chip.classList.add("active");
    }
    chip.addEventListener("click", () => {
      if (state.genre === genre) {
        state.genre = "";      // clicked the chosen genre again: all genres
      } else {
        state.genre = genre;
      }
      render();
    });
    genresBox.append(chip);
  }
}

// ---------- My List ----------

// Is this show in My List? Gives true or false.
function isInMyList(id) {
  return state.myList.includes(id);
}

// Add the show to My List, or take it out if it's already there
function toggleMyList(show) {
  if (isInMyList(show.id)) {
    state.myList = state.myList.filter((id) => id !== show.id);
  } else {
    state.myList.push(show.id);
  }
  saveMyList();
  render();
}

// Save My List in the browser (localStorage keeps text only, so we turn it into JSON text)
function saveMyList() {
  localStorage.setItem("myList", JSON.stringify(state.myList));
}

// ---------- Events: what happens when someone uses the page ----------
// Day 8: search-as-you-type is gone. From today the search asks TVmaze, when the form is sent.
searchForm.addEventListener("submit", (event) => {
  event.preventDefault();   // don't reload the page
});

// ---------- Start: draw the page for the first time ----------
render();

// ---------- Day 8: talking to TVmaze ----------
// Your code for today goes below this line.


=== step api-url
title: What is an API?
minutes: 15
slot: js
--- explain
An **API** (Application Programming Interface) is a website made for programs instead of people. You ask it with a web address, and it answers with data instead of a page.

TVmaze's API lives at `https://api.tvmaze.com`. To search, you add a path and a **query string**, the part after the `?`:

`https://api.tvmaze.com/search/shows?q=office`

Open [that address in a new tab](https://api.tvmaze.com/search/shows?q=office) to see the raw answer. (Offline? You'll see it in the Console in the next step.)

To build an address from pieces, use a **template literal**: text between backticks `` ` `` where `${...}` puts a value in:

```js
const name = "Dark";
const title = `Now watching: ${name}`;   // "Now watching: Dark"
```

A web address can't contain spaces or characters like `&` as they are. `encodeURIComponent` makes any text safe to use inside one: `encodeURIComponent("rick & morty")` gives `"rick%20%26%20morty"`.

> The backtick key is usually at the top left of the keyboard, under Esc.
--- task
Under the Day 8 comment at the bottom:

1. Keep the start of every address in a constant: `const API = "https://api.tvmaze.com";`
2. Write a function `searchUrl(term)` that returns the search address for `term`, built with a template literal, `API` and `encodeURIComponent(term)`.
3. Log `searchUrl("the office")` and look at the Console.
--- hint
The function has one line: `return` and a template literal that starts with `${API}`, then `/search/shows?q=`, then `${encodeURIComponent(term)}`.
--- hint
```js
const API = "https://api.tvmaze.com";

function searchUrl(term) {
  return `${API}/search/shows?q=${encodeURIComponent(term)}`;
}

console.log(searchUrl("the office"));
```
--- solution-append
// The address of the TVmaze API. Every request starts with it.
const API = "https://api.tvmaze.com";

// The search address: searchUrl("the office") -> ".../search/shows?q=the%20office"
function searchUrl(term) {
  return `${API}/search/shows?q=${encodeURIComponent(term)}`;
}

console.log(searchUrl("the office"));
--- check
const searchUrl = t.get("searchUrl");
t.expect(typeof searchUrl === "function", "I can't find a function called `searchUrl`. Write `function searchUrl(term) { ... }` under the Day 8 comment.");
let url;
try { url = searchUrl("the office"); } catch (e) { t.fail("Your `searchUrl` crashed: " + e.message + ". Is `const API = ...` above the function?"); }
t.expect(typeof url === "string", "`searchUrl` should give the address back with `return`.");
t.expect(!url.includes("${"), `\`searchUrl("the office")\` gave "${url}". The \`\${...}\` parts only work inside backticks, not inside quotes.`);
t.expect(url.startsWith("https://api.tvmaze.com/search/shows?q="), `\`searchUrl("the office")\` gave "${url}". It should start with https://api.tvmaze.com/search/shows?q=`);
t.expect(!url.includes(" "), `\`searchUrl("the office")\` gave "${url}", with a space in it. Put the term through \`encodeURIComponent(term)\`.`);
t.expect(url === "https://api.tvmaze.com/search/shows?q=the%20office", `\`searchUrl("the office")\` gave "${url}". It should give https://api.tvmaze.com/search/shows?q=the%20office`);
t.expect(searchUrl("rick & morty").endsWith("rick%20%26%20morty"), "Use `encodeURIComponent(term)` for the whole search term, so characters like & are safe too.");
t.expect(t.logged("search/shows?q="), "Log the address to see it: `console.log(searchUrl(\"the office\"));`.");
--- learned
An API is a web address that answers with data. Template literals build addresses from pieces, and `encodeURIComponent` keeps the pieces safe.
--- summary
An API answers a web address with data. Template literals `` `...${x}...` `` build text; `encodeURIComponent` makes it safe for a URL.
--- mistakes
- Quotes instead of backticks: `"${API}/search..."` keeps the `${...}` as plain text.
- A space or a missing slash: `${API}search/shows`.
- Forgetting `return` in `searchUrl`.


=== step first-fetch
title: Your first fetch
minutes: 15
slot: js
--- explain
`fetch(address)` asks a server for something. The answer has to travel over the internet, which takes from a few milliseconds to a few seconds, so `fetch` can't give you the data straight away. It gives you a **promise**: a ticket that says "you'll get it later".

`await` means "wait here until the promise is ready, then give me its value". You can only use `await` inside a function marked `async`:

```js
async function showOne() {
  const response = await fetch("https://api.tvmaze.com/shows/169");
  const show = await response.json();
  console.log(show.name);   // "Breaking Bad"
}

showOne();
```

It takes two waits:

1. `await fetch(...)` gives a **response**: the status of the answer, with the data still on its way.
2. `await response.json()` reads the data and turns the JSON text into JavaScript arrays and objects.

> No internet? The Lab answers with saved sample data and says so in the Console.
--- task
Under your `searchUrl` code:

1. Write an `async function tryFetch()` that fetches `searchUrl("office")`, reads the JSON into a constant `results`, and logs `results`.
2. Call it: `tryFetch();`

Look at the Console: a long answer from TVmaze.
--- hint
Two lines with `await` inside the function: first `const response = await fetch(...)`, then `const results = await response.json();`. Then `console.log(results);`.
--- hint
```js
async function tryFetch() {
  const response = await fetch(searchUrl("office"));
  const results = await response.json();
  console.log(results);
}

tryFetch();
```
--- solution-append
// A first request to TVmaze
async function tryFetch() {
  const response = await fetch(searchUrl("office"));
  const results = await response.json();
  console.log(results);
}

tryFetch();
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
t.expect(typeof t.get("tryFetch") === "function", "I can't find a function called `tryFetch`. Write `async function tryFetch() { ... }` and call it below it: `tryFetch();`.");
t.expect(/async\s+function\s+tryFetch/.test(t.clean), "Put `async` in front of `function tryFetch`. Without it, `await` isn't allowed inside.");
const ok = await t.waitFor(() => t.logs.some((l) => /"score"/.test(l.text)), 4000);
if (!ok) {
  t.expect(!t.logs.some((l) => l.text.trim() === "{}"), "The Console shows `{}`: that's the response or a promise, not the data. Write `await` before `fetch(...)` and before `response.json()`.");
  t.fail("I can't see TVmaze's answer in the Console. In `tryFetch`, fetch `searchUrl(\"office\")`, read `await response.json()` and log it. Don't forget to call `tryFetch();` under the function.");
}
--- learned
`fetch` asks, `await` waits, `response.json()` reads. Your page has talked to a server on the internet (or to the Lab's saved copy of it).
--- summary
`await fetch(url)` then `await response.json()`, inside an `async function`.
--- mistakes
- Forgetting `await`: you log a promise (`{}`) instead of the data.
- `await` in a function without `async`: "await is only valid in async functions".
- Writing the function but never calling it.
--- teacher
If a student's Console says the Lab used sample data, that's fine: every check works offline. Online, the preview asks TVmaze again each time the code runs, so ask students not to hammer "Run again".


=== step shape
title: The shape of the answer
minutes: 10
slot: js
--- explain
Before you use data, look at its **shape**: which arrays and objects are inside which. Here is the start of TVmaze's answer to a search for `friends`:

```json
[
  {
    "score": 0.9,
    "show": {
      "id": 431,
      "name": "Friends",
      "genres": ["Comedy", "Romance"],
      "rating": { "average": 8.8 },
      "image": { "medium": "https://static.tvmaze.com/..." },
      "summary": "<p><b>Friends</b>: Six friends share ...</p>"
    }
  }
]
```

- The answer is an **array**, with one item per show found.
- Each item is an object with two properties: `score` (how well it matches) and `show` (the show itself).

So the first show's name is `results[0].show.name`, not `results[0].name`. Notice too that `rating` is an object, and `summary` is HTML. We'll deal with that in the next step.
--- task
In `tryFetch`, replace `console.log(results);` with two logs:

1. how many results there are: `results.length`
2. the name of the first show found
--- hint
The name is inside `show`, inside the first item: `results[0]`, then `.show`, then `.name`.
--- hint
```js
  console.log(results.length);
  console.log(results[0].show.name);
```
--- solution-replace
  console.log(results);
=>
  console.log(results.length);
  console.log(results[0].show.name);
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const ok = await t.waitFor(() => t.logs.some((l) => l.text.trim() === "The Office"), 4000);
if (!ok) {
  t.expect(!t.logs.some((l) => l.text.trim() === "undefined"), "The Console shows `undefined`. Each result is `{ score, show }`, so the name is one level deeper: `results[0].show.name`.");
  t.fail("I can't see \"The Office\" on its own line in the Console. Log the first show's name: `console.log(results[0].show.name);`.");
}
t.expect(t.logs.some((l) => /^\d+$/.test(l.text.trim())), "Also log how many results there are: `console.log(results.length);`.");
--- learned
Reading the shape first saves a lot of `undefined`. A search result is `{ score, show }`, and the show is inside.
--- summary
Read the shape of JSON before using it: a search gives `[{ score, show }]`.
--- mistakes
- `results.show.name`: `results` is an array, so it needs `[0]` first.
- `results[0].name`: the name is inside `show`.


=== step search-shows
title: From their shape to ours
minutes: 20
slot: js
--- explain
TVmaze's shows don't look like the shows in data.js. `createCard` expects `show.rating` to be a number, but TVmaze has `show.rating.average`. It expects `show.image` to be an address or `null`, but TVmaze has `show.image.medium`.

Instead of changing `createCard` and everything else, we translate each TVmaze show into **our** shape as soon as it arrives. That's what `toShow(apiShow)` in helpers.js does (open the tab and read it):

```
TVmaze                            our shape
show.rating.average    8.8   ->   rating: 8.8
show.image.medium      "…"   ->   image: "…" (or null)
show.premiered  "1994-…"     ->   premiered: 1994
show.network.name    "NBC"   ->   network: "NBC"
show.summary   "<p>…</p>"    ->   summary: "…" (tags removed)
```

A function like this is called an **adapter**, like a travel plug. The rest of your app never needs to know where the data came from.

`map` makes a new array with one new item for each old one:

```js
const names = results.map((result) => result.show.name);   // ["Friends", ...]
```
--- task
Turn `tryFetch` into a real search function:

1. Rename it to `searchShows` and give it a parameter: `async function searchShows(term)`.
2. Fetch `searchUrl(term)` instead of `searchUrl("office")`.
3. Replace the two logs with `return results.map((result) => toShow(result.show));`
4. Tidy up: delete the test lines `tryFetch();` and `console.log(searchUrl("the office"));`.
--- hint
The function keeps its first two lines (with `term` instead of `"office"`). Only the end changes: it returns the mapped array instead of logging.
--- hint
```js
async function searchShows(term) {
  const response = await fetch(searchUrl(term));
  const results = await response.json();
  return results.map((result) => toShow(result.show));
}
```
--- solution-replace
console.log(searchUrl("the office"));

// A first request to TVmaze
async function tryFetch() {
  const response = await fetch(searchUrl("office"));
  const results = await response.json();
  console.log(results.length);
  console.log(results[0].show.name);
}

tryFetch();
=>
// Search TVmaze. Gives back a list of shows in OUR shape, ready for createCard.
async function searchShows(term) {
  const response = await fetch(searchUrl(term));
  const results = await response.json();
  return results.map((result) => toShow(result.show));
}
--- check
await t.sleep(450);
await t.rerun();   // start from a fresh run of the page
const searchShows = t.get("searchShows");
t.expect(typeof searchShows === "function", "I can't find a function called `searchShows`. Rename `tryFetch` and give it a parameter: `async function searchShows(term)`.");
let result;
try { result = await searchShows("friends"); } catch (e) { t.fail("Your `searchShows` crashed: " + e.message); }
t.expect(Array.isArray(result), "`searchShows` should give back an array. End it with `return results.map(...)`.");
t.expect(result.length > 0, "`searchShows(\"friends\")` gave back an empty array. Use the parameter: `searchUrl(term)`.");
t.expect(!result[0].show, "The items still have TVmaze's `{ score, show }` shape. Map each result to `toShow(result.show)`.");
t.expect(result[0].name !== undefined, "The shows have no name. Each result is `{ score, show }`, so give `toShow` the show inside it: `results.map((result) => toShow(result.show))`.");
t.expect(result[0].name === "Friends", `The first result of \`searchShows("friends")\` is "${result[0].name}". Use \`searchUrl(term)\`, not a fixed word.`);
t.expect(typeof result[0].rating === "number" && result[0].id === 431, "The shows should be in our shape, with `rating` as a plain number. Use `toShow(result.show)` inside `map`.");
--- learned
`searchShows` hides all of TVmaze's details: give it a word, get back shows in your own shape. `toShow` is the **adapter** between their data and your app.
--- summary
An adapter (`toShow`) turns someone else's data shape into yours; `map` applies it to every item.
--- mistakes
- `results.map(toShow)`: here each item is `{ score, show }`, so it needs `toShow(result.show)`.
- Keeping `"office"` inside the function instead of `term`.
- Forgetting `return`: the function gives back `undefined`.


=== step search-submit
title: Search TVmaze
minutes: 15
slot: js
--- explain
Now connect it to the page: when the form is sent, ask TVmaze and show what it finds.

Why when the form is sent, and not on every letter like yesterday? Every letter would be a request. TVmaze allows about **20 requests every 10 seconds** from one computer. Fast typing would soon hit that limit, and most of those answers would be thrown away anyway.

Because `searchShows` gives back shows in our shape, the rest of the app stays as it is. Put the shows in the state, call `render()`, and `createCard` draws them. That's the state pattern paying off: a new source of data, the same drawing code.

```js
async function loadEpisodes() {
  state.episodes = await getEpisodes();   // wait, then change the state
  render();                               // and draw
}
```

We've added the start of `loadShows(term)` below your code.
