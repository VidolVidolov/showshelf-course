--- solution
async function go() {
  const r = await fetch("https://api.tvmaze.com/search/shows?q=friends");
  const data = await r.json();
  console.log(data[0].show.name, data[0].show.id);
  const one = await (await fetch("https://api.tvmaze.com/shows/431?embed[]=cast&embed[]=seasons")).json();
  console.log(one._embedded.cast.length, one._embedded.seasons.length);
  const bad = await fetch("https://api.tvmaze.com/shows/1");
  console.log("status", bad.status);
}
go();
--- check
t.expect(await t.waitFor(() => t.logged("Friends 431")), "search: " + JSON.stringify(t.logs));
t.expect(await t.waitFor(() => t.logged("6 10")), "embed: " + JSON.stringify(t.logs));
t.expect(await t.waitFor(() => t.logged("status 404")), "404");

=== step react
title: React
