template: react
--- explain
x
--- task
x
--- solution
function Counter({ label }) {
  const [n, setN] = React.useState(0);
  return (
    <button onClick={() => setN(n + 1)}>
      {label} {n}
    </button>
  );
}
function App() {
  const shows = ["Friends", "Dark"];
  return (
    <>
      <ul>{shows.map((s) => <li key={s}>{s}</li>)}</ul>
      <Counter label="Clicked" />
    </>
  );
}
ReactDOM.createRoot(document.getElementById("root")).render(<App />);
--- check
t.expect(await t.waitFor(() => t.$("button")), "no button " + JSON.stringify(t.logs));
t.expect(t.$$("li").length === 2, "lis");
await t.click("button"); await t.click("button");
t.expect(await t.waitFor(() => t.text("button") === "Clicked 2"), "count " + t.text("button"));

