=== step server
title: Server
slot: server
template: srv
--- explain
x
--- task
x
--- solution
const app = express();
app.use(express.json());
let myList = [{ id: 1, name: "Friends" }];
app.get("/api/mylist", (req, res) => {
  res.json(myList);
});
app.post("/api/mylist", (req, res) => {
  const item = { id: Date.now(), name: req.body.name };
  myList.push(item);
  res.status(201).json(item);
});
app.delete("/api/mylist/:id", (req, res) => {
  myList = myList.filter((i) => i.id !== Number(req.params.id));
  res.status(204).end();
});
app.listen(3000);
--- check
t.expect(await t.waitFor(() => t.$$("#list li").length === 1), "list " + JSON.stringify(t.logs));
const r = await t.win.fetch("/api/mylist", { method: "POST", headers: {"Content-Type":"application/json"}, body: JSON.stringify({ name: "Dark" }) });
t.expect(r.status === 201, "post status " + r.status);
const item = await r.json();
const d = await t.win.fetch("/api/mylist/" + item.id, { method: "DELETE" });
t.expect(d.status === 204, "delete " + d.status);
const nf = await t.win.fetch("/api/nothing");
t.expect(nf.status === 404, "404");
t.expect(t.logged(/GET \/api\/mylist/), "request log");
